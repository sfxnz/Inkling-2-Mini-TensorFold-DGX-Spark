+extern "C" __global__ void __launch_bounds__(128)
+    tf_ink2_copy_spans(const ink2l::CopySpan* __restrict__ spans, int n) {
+    const int idx = blockIdx.x;
+    if (idx >= n) return;
+    const ink2l::CopySpan sp = spans[idx];
+    uint8_t* dst = reinterpret_cast<uint8_t*>(sp.dst);
+    const uint8_t* src = reinterpret_cast<const uint8_t*>(sp.src);
+    const size_t bytes = static_cast<size_t>(sp.bytes);
+    if (((sp.dst | sp.src) & 15u) == 0u) {
+        const size_t vecs = bytes >> 4;
+        uint4* d4 = reinterpret_cast<uint4*>(dst);
+        const uint4* s4 = reinterpret_cast<const uint4*>(src);
+        for (size_t i = threadIdx.x; i < vecs; i += 128) d4[i] = s4[i];
+        for (size_t i = (vecs << 4) + threadIdx.x; i < bytes; i += 128) dst[i] = src[i];
+    } else if (((sp.dst | sp.src) & 3u) == 0u) {
+        const size_t words = bytes >> 2;
+        uint32_t* d4 = reinterpret_cast<uint32_t*>(dst);
+        const uint32_t* s4 = reinterpret_cast<const uint32_t*>(src);
+        for (size_t i = threadIdx.x; i < words; i += 128) d4[i] = s4[i];
+        for (size_t i = (words << 2) + threadIdx.x; i < bytes; i += 128) dst[i] = src[i];
+    } else {
+        for (size_t i = threadIdx.x; i < bytes; i += 128) dst[i] = src[i];
+    }
+}
