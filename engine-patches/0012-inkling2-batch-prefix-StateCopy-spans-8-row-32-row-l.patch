+    pub fn ensureCopySpans(b: *Backend, count: usize) !u64 {
+        const span_bytes = @sizeOf(@import("loop_math_cuda.zig").CopySpan);
+        const need = @max(count, 4096) * span_bytes;
+        if (b.copy_spans_buf) |*buf| {
