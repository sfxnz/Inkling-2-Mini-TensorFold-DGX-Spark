-// Reuse the prepared BF16 row across 8 rows in registers, retaining the original gateDown dot and reduction order.
+// Reuse the prepared BF16 row across 4 rows in SMEM, retaining the original gateDown dot and reduction order.
 __device__ void gateDownPrepared(const uint16_t* __restrict__ prepared, const uint16_t* __restrict__ down,
                                  uint16_t* __restrict__ zeta, int rows, int c) {
     if (c <= 2304) {
-        __shared__ float sh[32 * 32];
-        const int row0 = static_cast<int>(blockIdx.x) * 8;
-        const int count = rows - row0 < 8 ? rows - row0 : 8;
+        __shared__ float sh[16 * 32];
+        __shared__ uint16_t s_src[4 * 4608];
+        const int row0 = static_cast<int>(blockIdx.x) * 4;
         const int width = 2 * c;
-        uint32_t xr[8][9];
-#pragma unroll
-        for (int row = 0; row < 8; ++row) {
-            const uint16_t* src = row < count ? (prepared + static_cast<size_t>(row0 + row) * width) : nullptr;
-#pragma unroll
-            for (int p = 0; p < 9; ++p) {
-                const int i0 = threadIdx.x + 256 * (2 * p);
-                const int i1 = i0 + 256;
-                const uint32_t v0 = (src && i0 < width) ? static_cast<uint32_t>(src[i0]) : 0u;
-                const uint32_t v1 = (src && i1 < width) ? static_cast<uint32_t>(src[i1]) : 0u;
-                xr[row][p] = v0 | (v1 << 16);
-            }
+        const int count = rows - row0 < 4 ? rows - row0 : 4;
+        for (int r = 0; r < count; ++r) {
+            const uint16_t* src = prepared + static_cast<size_t>(row0 + r) * width;
+            for (int i = threadIdx.x; i < width; i += blockDim.x) s_src[r * width + i] = src[i];
         }
+        __syncthreads();
         for (int r = 0; r < kRank; r += 4) {
             const uint16_t* d0 = down + static_cast<size_t>(r) * width;
             const uint16_t* d1 = d0 + width;
             const uint16_t* d2 = d1 + width;
             const uint16_t* d3 = d2 + width;
-            float acc[32];
-#pragma unroll
-            for (int k = 0; k < 32; ++k) acc[k] = 0.0f;
+            float acc[16];
 #pragma unroll
-            for (int p = 0; p < 9; ++p) {
-                const int i0 = threadIdx.x + 256 * (2 * p);
-                if (i0 >= width) break;
-                const float w00 = bf(d0[i0]), w10 = bf(d1[i0]), w20 = bf(d2[i0]), w30 = bf(d3[i0]);
-#pragma unroll
-                for (int row = 0; row < 8; ++row) {
-                    const float n = bf(static_cast<uint16_t>(xr[row][p] & 0xFFFFu));
-                    acc[4 * row + 0] = __fmaf_rn(w00, n, acc[4 * row + 0]);
-                    acc[4 * row + 1] = __fmaf_rn(w10, n, acc[4 * row + 1]);
-                    acc[4 * row + 2] = __fmaf_rn(w20, n, acc[4 * row + 2]);
-                    acc[4 * row + 3] = __fmaf_rn(w30, n, acc[4 * row + 3]);
-                }
-                const int i1 = i0 + 256;
-                if (i1 < width) {
-                    const float w01 = bf(d0[i1]), w11 = bf(d1[i1]), w21 = bf(d2[i1]), w31 = bf(d3[i1]);
+            for (int k = 0; k < 16; ++k) acc[k] = 0.0f;
+            for (int i = threadIdx.x; i < width; i += blockDim.x) {
+                const float w0 = bf(d0[i]), w1 = bf(d1[i]), w2 = bf(d2[i]), w3 = bf(d3[i]);
 #pragma unroll
-                    for (int row = 0; row < 8; ++row) {
-                        const float n = bf(static_cast<uint16_t>(xr[row][p] >> 16));
-                        acc[4 * row + 0] = __fmaf_rn(w01, n, acc[4 * row + 0]);
-                        acc[4 * row + 1] = __fmaf_rn(w11, n, acc[4 * row + 1]);
-                        acc[4 * row + 2] = __fmaf_rn(w21, n, acc[4 * row + 2]);
-                        acc[4 * row + 3] = __fmaf_rn(w31, n, acc[4 * row + 3]);
-                    }
+                for (int row = 0; row < 4; ++row) {
+                    const float n = row < count ? bf(s_src[row * width + i]) : 0.0f;
