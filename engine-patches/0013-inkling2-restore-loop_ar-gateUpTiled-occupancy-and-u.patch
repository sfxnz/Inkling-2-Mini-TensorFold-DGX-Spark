+                    acc[4 * row + 2] = __fmaf_rn(w2, n, acc[4 * row + 2]);
+                    acc[4 * row + 3] = __fmaf_rn(w3, n, acc[4 * row + 3]);
                 }
             }
-            blockSums<32>(acc, sh);
+            blockSums<16>(acc, sh);
             if (threadIdx.x == 0) {
                 for (int row = 0; row < count; ++row)
                     for (int k = 0; k < 4; ++k)
@@ -687,13 +607,6 @@ extern "C" __global__ void __launch_bounds__(64)
     ink2l::gateUpTiled<8>(h, m, zeta, forget, gain, out, rows, c);
 }
 
