-// Cooperative 4-warp BN=128 block-scaled tensor-core GEMM for 64-row prompt tiles: all 4 warps share sx_c/sx_s/s_tok.
+// Cooperative 8-warp (2 row-halves x 4 col-blocks) BN=128 block-scaled TC GEMM for 64-row prompt tiles.
 template <int FMT>
 __device__ __forceinline__ void prompt_tc_coop(const uint8_t* __restrict__ xc, const uint8_t* __restrict__ xsc,
                                                int x_stride, int slots, Weight w, int KG, int NB,
@@ -499,7 +499,8 @@ __device__ __forceinline__ void prompt_tc_coop(const uint8_t* __restrict__ xc, c
                                                const int* __restrict__ members, void* __restrict__ out, int N,
                                                int skip) {
   const int tid = threadIdx.x;
-  const int warp = tid >> 5, lane = tid & 31, gq = lane >> 2, t = lane & 3;
+  const int warp = tid >> 5, wm = warp >> 2, wn = warp & 3;
+  const int lane = tid & 31, gq = lane >> 2, t = lane & 3;
   const int nb_groups = (NB + 3) >> 2;
   const int units = __ldg(item_count) * nb_groups;
   __shared__ __align__(16) uint4 sx_c[2][64][2];
@@ -512,18 +513,18 @@ __device__ __forceinline__ void prompt_tc_coop(const uint8_t* __restrict__ xc, c
   const int steps = FMT == 0 ? (KG >> 1) : KG;
   for (int unit = blockIdx.x; unit < units; unit += gridDim.x) {
     const int it = unit / nb_groups, cb_grp = unit - it * nb_groups;
-    const int cb = (cb_grp << 2) + warp;
+    const int cb = (cb_grp << 2) + wn;
     const bool valid_cb = cb < NB;
     const int e = __ldg(items + 3 * it), first = __ldg(items + 3 * it + 1), cnt = __ldg(items + 3 * it + 2);
     if (e == skip) continue;
     const float outer = FMT == 0 ? outer_of(w, e) : 1.0f;
-    bool v[4][2];
-    int pr[4][2];
+    bool v[2][2];
+    int pr[2][2];
 #pragma unroll
-    for (int r = 0; r < 4; ++r)
+    for (int r = 0; r < 2; ++r)
 #pragma unroll
       for (int h = 0; h < 2; ++h) {
-        const int i = 16 * r + gq + 8 * h;
+        const int i = 32 * wm + 16 * r + gq + 8 * h;
         v[r][h] = i < cnt;
         pr[r][h] = v[r][h] ? __ldg(members + first + i) : 0;
       }
@@ -537,48 +538,49 @@ __device__ __forceinline__ void prompt_tc_coop(const uint8_t* __restrict__ xc, c
     }
     __syncthreads();
     auto load_stage = [&](int s, int g) {
-      {
+      if (tid < 128) {
         const int rr = tid >> 1, cc = tid & 1;
         const int tok = s_tok[rr];
         const int safe_tok = tok >= 0 ? tok : 0;
         tf_common::cp16z(&sx_c[s][rr][cc],
                          xc + static_cast<size_t>(safe_tok) * c_stride + static_cast<size_t>(g) * 32 + 16 * cc,
                          tok >= 0);
-      }
-      if (tid < 64) {
-        const int tok = s_tok[tid];
+        const int w_wn = tid >> 5, w_lane = tid & 31, wcb = (cb_grp << 2) + w_wn;
+        if (wcb < NB) {
+          const long long row = w.row0 + w.row_step * (wcb * 32 + w_lane);
+          const long long z = (e * w.N + row) * w.K + (FMT == 0 ? 64LL : 32LL) * g;
+          if constexpr (FMT == 0) {
+            sw_s[s][w_wn][w_lane] = __ldg(reinterpret_cast<const uint32_t*>(w.scales + z / 16));
+          } else {
+            sw_s[s][w_wn][w_lane] = static_cast<uint32_t>(__ldg(w.scales + z / 32));
+          }
+        }
+      } else if (tid < 192) {
+        const int rr = tid - 128;
+        const int tok = s_tok[rr];
         if (tok >= 0) {
           if constexpr (FMT == 0) {
-            sx_s[s][tid] = __ldg(reinterpret_cast<const uint32_t*>(xsc + static_cast<size_t>(tok) * s_stride + g * 4));
+            sx_s[s][rr] = __ldg(reinterpret_cast<const uint32_t*>(xsc + static_cast<size_t>(tok) * s_stride + g * 4));
           } else {
-            sx_s[s][tid] = static_cast<uint32_t>(__ldg(xsc + static_cast<size_t>(tok) * s_stride + g));
+            sx_s[s][rr] = static_cast<uint32_t>(__ldg(xsc + static_cast<size_t>(tok) * s_stride + g));
           }
         } else {
-          sx_s[s][tid] = 0u;
+          sx_s[s][rr] = 0u;
         }
       }
-      if (valid_cb) {
-#pragma unroll
-        for (int i = 0; i < 2; ++i) {
-          const int q = lane + 32 * i, lr = q >> 1, cc = q & 1;
-          const long long row = w.row0 + w.row_step * (cb * 32 + lr);
-          const long long z = (e * w.N + row) * w.K + (FMT == 0 ? 64LL : 32LL) * g;
-          tf_common::cp16(&sw_c[s][warp][lr][cc], w.codes + (FMT == 0 ? z / 2 : z) + 16 * cc);
-        }
-        {
-          const long long row = w.row0 + w.row_step * (cb * 32 + lane);
+      {
+        const int w_wn = tid >> 6, q = tid & 63, lr = q >> 1, cc = q & 1;
+        const int wcb = (cb_grp << 2) + w_wn;
+        if (wcb < NB) {
+          const long long row = w.row0 + w.row_step * (wcb * 32 + lr);
           const long long z = (e * w.N + row) * w.K + (FMT == 0 ? 64LL : 32LL) * g;
-          if constexpr (FMT == 0) {
-            sw_s[s][warp][lane] = __ldg(reinterpret_cast<const uint32_t*>(w.scales + z / 16));
-          } else {
-            sw_s[s][warp][lane] = static_cast<uint32_t>(__ldg(w.scales + z / 32));
-          }
+          tf_common::cp16(&sw_c[s][w_wn][lr][cc], w.codes + (FMT == 0 ? z / 2 : z) + 16 * cc);
         }
       }
     };
-    float acc[1][4][4][4];
+    float acc[1][2][4][4];
 #pragma unroll
-    for (int r = 0; r < 4; ++r)
+    for (int r = 0; r < 2; ++r)
 #pragma unroll
       for (int j = 0; j < 4; ++j) acc[0][r][j][0] = acc[0][r][j][1] = acc[0][r][j][2] = acc[0][r][j][3] = 0.f;
     if (steps > 0) {
@@ -596,10 +598,10 @@ __device__ __forceinline__ void prompt_tc_coop(const uint8_t* __restrict__ xc, c
       }
       __syncthreads();
       if (valid_cb) {
-        uint32_t a[4][4], sa[4];
+        uint32_t a[2][4], sa[2];
 #pragma unroll
-        for (int r = 0; r < 4; ++r) {
-          const int r0 = 16 * r;
+        for (int r = 0; r < 2; ++r) {
+          const int r0 = 32 * wm + 16 * r;
           const uint32_t* p0 = reinterpret_cast<const uint32_t*>(&sx_c[cur][r0 + gq][0]);
           const uint32_t* p1 = reinterpret_cast<const uint32_t*>(&sx_c[cur][r0 + gq + 8][0]);
           a[r][0] = p0[t];
@@ -610,15 +612,15 @@ __device__ __forceinline__ void prompt_tc_coop(const uint8_t* __restrict__ xc, c
         }
 #pragma unroll
         for (int j = 0; j < 4; ++j) {
-          const uint32_t* wp = reinterpret_cast<const uint32_t*>(&sw_c[cur][warp][8 * j + gq][0]);
+          const uint32_t* wp = reinterpret_cast<const uint32_t*>(&sw_c[cur][wn][8 * j + gq][0]);
           const uint32_t b0 = wp[t], b1 = wp[4 + t];
-          const uint32_t sb = sw_s[cur][warp][8 * j + gq];
+          const uint32_t sb = sw_s[cur][wn][8 * j + gq];
           if constexpr (FMT == 0) {
 #pragma unroll
-            for (int r = 0; r < 4; ++r) mma4::mma_fp4(acc[0][r][j], a[r], b0, b1, sa[r], sb);
+            for (int r = 0; r < 2; ++r) mma4::mma_fp4(acc[0][r][j], a[r], b0, b1, sa[r], sb);
           } else {
 #pragma unroll
-            for (int r = 0; r < 4; ++r) mma_mxfp8(acc[0][r][j], a[r], b0, b1, sa[r], sb);
+            for (int r = 0; r < 2; ++r) mma_mxfp8(acc[0][r][j], a[r], b0, b1, sa[r], sb);
           }
         }
       }
@@ -627,15 +629,15 @@ __device__ __forceinline__ void prompt_tc_coop(const uint8_t* __restrict__ xc, c
     if (valid_cb) {
       if constexpr (FMT == 0) {
 #pragma unroll
-        for (int r = 0; r < 4; ++r)
+        for (int r = 0; r < 2; ++r)
 #pragma unroll
           for (int j = 0; j < 4; ++j)
 #pragma unroll
             for (int q = 0; q < 4; ++q) acc[0][r][j][q] *= outer;
       }
 #pragma unroll
-      for (int r = 0; r < 4; ++r)
-        store<4, 4>(acc, r, out, nullptr, N, cb * 32 + 2 * t, pr[r][0], pr[r][1], v[r][0], v[r][1]);
+      for (int r = 0; r < 2; ++r)
+        store<2, 4>(acc, r, out, nullptr, N, cb * 32 + 2 * t, pr[r][0], pr[r][1], v[r][0], v[r][1]);
     }
     __syncthreads();
   }
@@ -832,7 +834,7 @@ extern "C" __global__ void __launch_bounds__(256)
   }
 }
 
