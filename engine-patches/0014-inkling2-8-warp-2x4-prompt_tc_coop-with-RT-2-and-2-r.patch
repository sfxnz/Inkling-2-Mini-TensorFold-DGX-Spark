-// Reuse the prepared BF16 row across 4 rows in SMEM, retaining the original gateDown dot and reduction order.
+// Reuse the prepared BF16 row across 2 rows in SMEM (83% occupancy), pairing 8 rank rows per pass.
 __device__ void gateDownPrepared(const uint16_t* __restrict__ prepared, const uint16_t* __restrict__ down,
                                  uint16_t* __restrict__ zeta, int rows, int c) {
     if (c <= 2304) {
         __shared__ float sh[16 * 32];
-        __shared__ uint16_t s_src[4 * 4608];
-        const int row0 = static_cast<int>(blockIdx.x) * 4;
+        __shared__ uint16_t s_src[2 * 4608];
+        const int row0 = static_cast<int>(blockIdx.x) * 2;
         const int width = 2 * c;
-        const int count = rows - row0 < 4 ? rows - row0 : 4;
-        for (int r = 0; r < count; ++r) {
-            const uint16_t* src = prepared + static_cast<size_t>(row0 + r) * width;
-            for (int i = threadIdx.x; i < width; i += blockDim.x) s_src[r * width + i] = src[i];
+        const bool has1 = row0 + 1 < rows;
+        const uint16_t* src0 = prepared + static_cast<size_t>(row0) * width;
+        const uint16_t* src1 = prepared + static_cast<size_t>(row0 + 1) * width;
+        for (int i = threadIdx.x; i < width; i += blockDim.x) {
+            s_src[i] = src0[i];
+            if (has1) s_src[width + i] = src1[i];
         }
         __syncthreads();
-        for (int r = 0; r < kRank; r += 4) {
+        for (int r = 0; r < kRank; r += 8) {
             const uint16_t* d0 = down + static_cast<size_t>(r) * width;
             const uint16_t* d1 = d0 + width;
             const uint16_t* d2 = d1 + width;
             const uint16_t* d3 = d2 + width;
-            float acc[16];
-#pragma unroll
-            for (int k = 0; k < 16; ++k) acc[k] = 0.0f;
+            const uint16_t* d4 = d3 + width;
+            const uint16_t* d5 = d4 + width;
+            const uint16_t* d6 = d5 + width;
+            const uint16_t* d7 = d6 + width;
+            float acc[16] = {0.0f};
             for (int i = threadIdx.x; i < width; i += blockDim.x) {
+                const float n0 = bf(s_src[i]);
+                const float n1 = has1 ? bf(s_src[width + i]) : 0.0f;
                 const float w0 = bf(d0[i]), w1 = bf(d1[i]), w2 = bf(d2[i]), w3 = bf(d3[i]);
-#pragma unroll
-                for (int row = 0; row < 4; ++row) {
-                    const float n = row < count ? bf(s_src[row * width + i]) : 0.0f;
-                    acc[4 * row + 0] = __fmaf_rn(w0, n, acc[4 * row + 0]);
-                    acc[4 * row + 1] = __fmaf_rn(w1, n, acc[4 * row + 1]);
-                    acc[4 * row + 2] = __fmaf_rn(w2, n, acc[4 * row + 2]);
-                    acc[4 * row + 3] = __fmaf_rn(w3, n, acc[4 * row + 3]);
-                }
+                const float w4 = bf(d4[i]), w5 = bf(d5[i]), w6 = bf(d6[i]), w7 = bf(d7[i]);
+                acc[0] = __fmaf_rn(w0, n0, acc[0]);
+                acc[1] = __fmaf_rn(w1, n0, acc[1]);
+                acc[2] = __fmaf_rn(w2, n0, acc[2]);
+                acc[3] = __fmaf_rn(w3, n0, acc[3]);
+                acc[4] = __fmaf_rn(w4, n0, acc[4]);
+                acc[5] = __fmaf_rn(w5, n0, acc[5]);
+                acc[6] = __fmaf_rn(w6, n0, acc[6]);
+                acc[7] = __fmaf_rn(w7, n0, acc[7]);
+                acc[8] = __fmaf_rn(w0, n1, acc[8]);
+                acc[9] = __fmaf_rn(w1, n1, acc[9]);
+                acc[10] = __fmaf_rn(w2, n1, acc[10]);
+                acc[11] = __fmaf_rn(w3, n1, acc[11]);
+                acc[12] = __fmaf_rn(w4, n1, acc[12]);
+                acc[13] = __fmaf_rn(w5, n1, acc[13]);
+                acc[14] = __fmaf_rn(w6, n1, acc[14]);
+                acc[15] = __fmaf_rn(w7, n1, acc[15]);
             }
             blockSums<16>(acc, sh);
             if (threadIdx.x == 0) {
-                for (int row = 0; row < count; ++row)
-                    for (int k = 0; k < 4; ++k)
-                        zeta[static_cast<size_t>(row0 + row) * kRank + r + k] = tobf(acc[4 * row + k]);
+                for (int k = 0; k < 8; ++k) zeta[static_cast<size_t>(row0) * kRank + r + k] = tobf(acc[k]);
+                if (has1) {
+                    for (int k = 0; k < 8; ++k) zeta[static_cast<size_t>(row0 + 1) * kRank + r + k] = tobf(acc[8 + k]);
+                }
             }
         }
         return;
