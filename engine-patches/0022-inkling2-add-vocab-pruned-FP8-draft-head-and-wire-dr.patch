diff --git a/zig/kernels/cuda/inkling2/draft_fp8.cuh b/zig/kernels/cuda/inkling2/draft_fp8.cuh
index 2063811..1e99e54 100644
--- a/zig/kernels/cuda/inkling2/draft_fp8.cuh
+++ b/zig/kernels/cuda/inkling2/draft_fp8.cuh
@@ -2,6 +2,7 @@
 
 #include <cuda_fp16.h>
 #include <cuda_fp8.h>
+#include "../nvfp4q.cuh"
 
 namespace ink2d {
 __device__ __forceinline__ float fp8Value(uint8_t code) {
@@ -17,6 +18,16 @@ __device__ __forceinline__ float fp8Scale(float max_abs) {
 __device__ __forceinline__ uint8_t fp8Code(float value, float scale) {
     return __nv_cvt_float_to_fp8(value / scale, __NV_SATFINITE, __NV_E4M3);
 }
+
+__device__ __forceinline__ int fp8Col(int lane, int b) {
+    const int p = 16 * (b / 4) + 4 * (lane % 4) + b % 4;
+    return 16 * (p / 16) + 2 * ((p % 16) / 4) + p % 2 + 8 * ((p % 4) / 2);
+}
+
+__device__ __forceinline__ unsigned warpMaxU(unsigned v) {
+    for (int o = 16; o > 0; o >>= 1) v = max(v, __shfl_xor_sync(0xffffffffu, v, o));
+    return v;
+}
 }  // namespace ink2d
 
 // A warp packs one row of a 64x64 qmmf FP8G tile, including its FP32 scale.
@@ -74,3 +85,84 @@ extern "C" __global__ void __launch_bounds__(256) tf_ink2_dsp_vocab8(
     const float x = bfr(bf(base[v]) + b);
     out[v] = v < valid ? bfr(tanhf(x / cap) * cap) : -INFINITY;
 }
+
+// Largest absolute BF16 code across a BF16 weight matrix (for NVFP4 / pruned FP8 global scaling).
+extern "C" __global__ void __launch_bounds__(256) tf_ink2_draft_amax(
+    const uint16_t* __restrict__ weights, long long total, unsigned* __restrict__ result) {
+    unsigned hi = 0;
+    for (long long i = static_cast<long long>(blockIdx.x) * 256 + threadIdx.x; i < total; i += gridDim.x * 256)
+        hi = max(hi, static_cast<unsigned>(weights[i]) & 0x7fffu);
+    hi = ink2d::warpMaxU(hi);
+    if ((threadIdx.x & 31) == 0) atomicMax(result, hi);
+}
+
+// Pack a (optionally vocab-pruned) BF16 matrix into qmmf::Mode::fp8 per-tensor tiled E4M3 codes.
+// Rows [0, split) copy directly from source [0, split); rows [split, draft_n) copy the tail [full_n - (draft_n - split), full_n).
+extern "C" __global__ void __launch_bounds__(256) tf_ink2_draft_pack_fp8_pruned(
+    const uint16_t* __restrict__ weights, uint8_t* __restrict__ codes,
+    int full_n, int draft_n, int split, int k, float inv, long long total) {
+    using namespace ink2d;
+    const long long i = static_cast<long long>(blockIdx.x) * 256 + threadIdx.x;
+    if (i >= total) return;
+    const int lane = (i / 16) % 32, kg = k / 64;
+    const long long tile = i / 4096;
+    const long long row = (tile / kg) * 64 + (i / 512 % 8) * 8 + lane / 4;
+    const int col = (tile % kg) * 64 + (i / 8 % 2) * 32 + fp8Col(lane, i % 8);
+    uint8_t code = 0;
+    if (row < draft_n) {
+        const long long src_row = (row < split) ? row : (row + (full_n - draft_n));
+        code = __nv_cvt_float_to_fp8(bf(weights[src_row * k + col]) * inv, __NV_SATFINITE, __NV_E4M3);
+    }
+    codes[i] = code;
+}
+
+// Pack any BF16 [full_n, k] (optionally pruned to draft_n) into qmmf::Mode::fp4 tiled words + 16-input E4M3 scales.
+extern "C" __global__ void __launch_bounds__(256) tf_ink2_draft_pack_fp4_matrix(
+    const uint16_t* __restrict__ weights, uint32_t* __restrict__ words, uint8_t* __restrict__ scales,
+    int full_n, int draft_n, int split, int k, float inv_global) {
+    using namespace ink2d;
+    __shared__ uint8_t s_nib[8][8][64];
+    const int kg = k >> 6;
+    const int tg = static_cast<int>(blockIdx.x);
+    const int t = tg / kg, g = tg - t * kg;
+    const int warp = threadIdx.x >> 5, lane = threadIdx.x & 31;
+    const int r = lane >> 2, q = lane & 3;
+    const int row = t * 64 + warp * 8 + r;
+    float vals[16];
+    float amax = 0.0f;
+    if (row < draft_n) {
+        const int src_row = (row < split) ? row : (row + (full_n - draft_n));
+        const uint4* wp = reinterpret_cast<const uint4*>(weights + static_cast<size_t>(src_row) * k + g * 64 + q * 16);
+        const uint4 v0 = wp[0], v1 = wp[1];
+        const uint32_t u[8] = {v0.x, v0.y, v0.z, v0.w, v1.x, v1.y, v1.z, v1.w};
+#pragma unroll
+        for (int p = 0; p < 8; ++p) {
+            const float a = bf(static_cast<uint16_t>(u[p] & 0xffffu));
+            const float b = bf(static_cast<uint16_t>(u[p] >> 16));
+            vals[2 * p] = a;
+            vals[2 * p + 1] = b;
+            amax = fmaxf(amax, fmaxf(fabsf(a), fabsf(b)));
+        }
+    }
+    const nvfp4q::Scale sc = nvfp4q::block_scale(amax, inv_global);
+    scales[(static_cast<size_t>(tg) * 64 + warp * 8 + r) * 4 + q] =
+        (row < draft_n) ? static_cast<uint8_t>(sc.sf8) : 0u;
+#pragma unroll
+    for (int p = 0; p < 16; ++p) {
+        s_nib[warp][r][q * 16 + p] = (row < draft_n) ? static_cast<uint8_t>(nvfp4q::e2m1(vals[p] * sc.mul)) : 0u;
+    }
+    __syncwarp();
+    constexpr int offs[8] = {0, 8, 16, 24, 1, 9, 17, 25};
+#pragma unroll
+    for (int v = 0; v < 2; ++v) {
+        uint32_t word = 0u;
+        if (row < draft_n) {
+#pragma unroll
+            for (int p = 0; p < 8; ++p) {
+                const int col = 32 * v + 2 * q + offs[p];
+                word |= static_cast<uint32_t>(s_nib[warp][r][col]) << (4 * p);
+            }
+        }
+        words[((static_cast<size_t>(tg) * 8 + warp) * 32 + lane) * 2 + v] = word;
+    }
+}
