diff --git a/zig/src/families/inkling2/dflash2_cuda.zig b/zig/src/families/inkling2/dflash2_cuda.zig
new file mode 100644
index 0000000..3992290
--- /dev/null
+++ b/zig/src/families/inkling2/dflash2_cuda.zig
@@ -0,0 +1,342 @@
+//! A BF16 Mini DFlash2 block on CUDA, using committed target features as its context.
+const std = @import("std");
+const cuda = @import("cuda");
+const w_ = @import("dflash2_weights.zig");
+const dspark = @import("dspark_cuda.zig");
+const dsp = @import("dspark_ops.zig");
+const engine = @import("loop_engine.zig");
+const ops = @import("ops.zig");
+const fp8 = @import("draft_fp8.zig");
+
+const h = w_.hidden;
+const block = w_.block;
+const depth = block - 1;
+const max_context_rows = 32;
+const chunks = (w_.window + block - 2) / dsp.chunk + 2;
+const top_words = 43;
+const Session = dspark.Session;
+
+fn ring(context: usize) usize {
+    const kept: usize = @min(context, w_.window - 1);
+    return kept + block;
+}
+
+pub fn kvBytes(context: usize) usize {
+    return w_.layers * ring(context) * 2 * w_.kv * 2;
+}
+
+pub fn partialBytes() usize {
+    return chunks * block * (w_.q * 4 + w_.heads * 8);
+}
+
+const Scratch = struct {
+    taps: u64,
+    mixed: u64,
+    matrix: u64,
+    accum: u64,
+    residual: u64,
+    normed: u64,
+    conv: u64,
+    delta: u64,
+    q: u64,
+    attn: u64,
+    act: u64,
+    partials: u64,
+    maxima: u64,
+    logits: u64,
+    logits_f32: u64,
+    top_parts: u64,
+    top: u64,
+    projected: u64,
+    ids: u64,
+    scores: u64,
+    position: u64,
+    walk: u64,
+
+    fn layout(base: u64, rows_per_pass: usize, total: *usize) Scratch {
+        const b = 2;
+        const sizes = .{
+            .taps = dspark.sharedTapBytes(rows_per_pass),
+            .mixed = max_context_rows * h * b,
+            .matrix = @max(max_context_rows * 2 * w_.kv, block * 2 * w_.inter) * b,
+            .accum = @max(max_context_rows * h, block * 2 * w_.inter) * 4,
+            .residual = block * h * b,
+            .normed = block * h * b,
+            .conv = block * h * b,
+            .delta = block * 4 * w_.groups * b,
+            .q = block * w_.q * b,
+            .attn = block * w_.q * b,
+            .act = block * w_.inter * b,
+            .partials = chunks * block * w_.q * 4,
+            .maxima = chunks * block * w_.heads * 8,
+            .logits = depth * w_.vocab * b,
+            .logits_f32 = depth * w_.vocab * 4,
+            .top_parts = cuda.sample.Draws.topkPartsBytes(w_.vocab, w_.top_k, depth),
+            .top = depth * top_words * 4,
+            .projected = depth * w_.rank * b,
+            .ids = w_.top_k * @sizeOf(i64),
+            .scores = w_.top_k * b,
+            .position = 4,
+            .walk = block * 4,
+        };
+        var s: Scratch = undefined;
+        inline for (@typeInfo(@TypeOf(sizes)).@"struct".field_names) |field| {
+            @field(s, field) = base + total.*;
+            total.* += std.mem.alignForward(usize, @field(sizes, field), 256);
+        }
+        return s;
+    }
+};
+
+pub fn scratchBytes(rows_per_pass: usize) usize {
+    var size: usize = 0;
+    _ = Scratch.layout(0, rows_per_pass, &size);
+    return size;
+}
+
+const Key = struct { slot: usize, n: usize, rule: u64 };
+const GraphCache = cuda.graph_cache.Cache(Key);
+
+pub const Drafter = struct {
+    w: w_.Weights,
+    k: dsp.Kernels,
+    dense: cuda.dense_rows.DenseRows,
+    lane: ?cuda.qmmf.Lane,
+    qk: cuda.Function,
+    attention: cuda.Function,
+    convolve: cuda.Function,
+    select: cuda.Function,
+    memory: cuda.DeviceBuffer,
+    scratch: Scratch,
+    ring_size: usize,
+    sessions: [engine.max_slots]Session = undefined,
+    count: usize = 0,
+    graph_engine: cuda.graph_cache.CudaEngine,
+    graphs: ?GraphCache = null,
+
+    /// Takes ownership of weights on success.
+    pub fn init(d: *const cuda.Driver, w: w_.Weights, context: usize, rows_per_pass: usize) !Drafter {
+        var k = try dsp.Kernels.load(d);
+        errdefer k.unload();
+        var dense = try cuda.dense_rows.DenseRows.load(d);
+        errdefer dense.unload();
+        var lane = try fp8.loadLane(d, w.fp8_layers or w.base != null);
+        errdefer if (lane) |*l| l.unload();
+        var memory = try cuda.DeviceBuffer.alloc(d, scratchBytes(rows_per_pass));
+        errdefer memory.free();
+        var used: usize = 0;
+        var out: Drafter = .{
+            .w = w,
+            .k = k,
+            .dense = dense,
+            .lane = lane,
+            .qk = try k.mod.function("tf_ink2_df_qk"),
+            .attention = try k.mod.function("tf_ink2_df_attn"),
+            .convolve = try k.mod.function("tf_ink2_df_conv"),
+            .select = try k.mod.function(if (w.predecessor.scales != 0) "tf_ink2_df_select8" else "tf_ink2_df_select"),
+            .memory = memory,
+            .scratch = Scratch.layout(memory.ptr, rows_per_pass, &used),
+            .ring_size = ring(context),
+            .graph_engine = .{ .d = d },
+        };
+        try out.reserve(1);
+        return out;
+    }
+
+    pub fn enableGraphs(d: *Drafter, a: std.mem.Allocator) void {
+        d.graphs = .init(a, d.graph_engine.engine(), .{});
+        d.graphs.?.name = "inkling2 mini dflash2 proposal";
+    }
+
+    pub fn reserve(d: *Drafter, count: usize) !void {
+        const sizes: [w_.layers]usize = @splat(d.ring_size);
+        while (d.count < count) {
+            d.sessions[d.count] = try Session.initRings(d.memory.d, &sizes, 0);
+            d.count += 1;
+        }
+    }
+
+    pub fn deinit(d: *Drafter) void {
+        if (d.graphs) |*g| g.deinit();
+        for (d.sessions[0..d.count]) |*session| session.memory.free();
+        d.memory.free();
+        if (d.lane) |*l| l.unload();
+        d.dense.unload();
+        d.k.unload();
+        d.w.deinit();
+    }
+
+    fn project(d: *const Drafter, k: *const ops.Kernels, s: cuda.Stream, x: u64, w: fp8.Matrix, out: u64, rows: usize, n: usize, c: usize) !void {
+        if (w.scales != 0) return d.lane.?.matmul(s, x, c, rows, w.lane(n, c), out, 0);
+        const a = d.scratch.accum;
+        try d.dense.rows(s, x, c, w.data, a, n, rows, n, c);
+        try ops.tobf(k, s, a, rows, n, n, out, n, 0, n);
+    }
+
+    fn qkArgs(d: *const Drafter, session: *const Session, i: usize, heads: usize, pos: usize) dsp.QkArgs {
+        const l = d.w.layer[i];
+        return .{
+            .x = d.scratch.matrix,
+            .qw = l.q_norm,
+            .kw = l.k_norm,
+            .q = d.scratch.q,
+            .kc = session.k[i],
+            .vc = session.v[i],
+            .ld = @intCast(heads * w_.dim + 2 * w_.kv),
+            .hq = @intCast(heads),
+            .hk = w_.kv_heads,
+            .ring = @intCast(d.ring_size),
+            .pos0 = @intCast(pos),
+            .eps = w_.eps,
+            .theta = w_.theta,
+        };
+    }
+
+    pub fn absorb(d: *Drafter, session: *Session, k: *const ops.Kernels, s: cuda.Stream, from: u64, pos: usize, rows: usize) !void {
+        if (pos != session.end) return error.DraftContextGap;
+        const a = d.scratch;
+        var offset = rows -| (w_.window - 1);
+        while (offset < rows) {
+            const n: usize = @min(rows - offset, max_context_rows);
+            try d.project(k, s, from + offset * dspark.tap_stride, d.w.fuse, a.mixed, n, h, 4 * h);
+            try dsp.addNorm(&d.k, s, a.mixed, 0, 0, 0, d.w.fuse_norm, a.matrix, n, h, w_.eps);
+            // Keep the normalized fusion outside the projection output, which is reused by every layer.
+            try d.memory.d.check(d.memory.d.api.cuMemcpyDtoDAsync_v2(a.mixed, a.matrix, n * h * 2, s.handle), "cuMemcpyDtoDAsync");
+            for (d.w.layer, 0..) |l, i| {
+                const kv_weights = l.qkv.afterRows(w_.q, h);
+                try d.project(k, s, a.mixed, kv_weights, a.matrix, n, 2 * w_.kv, h);
+                try dsp.qk(&d.k, s, d.qkArgs(session, i, 0, pos + offset), n);
+            }
+            offset += n;
+        }
+        session.end += rows;
+        session.held_len = 0;
+    }
+
+    fn launch(f: cuda.Function, s: cuda.Stream, x: usize, y: usize, threads: u32, args: anytype) !void {
+        var a: cuda.Args = .{};
+        inline for (args) |arg| a.add(arg);
+        try cuda.launch.launch(f, .{ .grid = .{ .x = @intCast(x), .y = @intCast(y) }, .block = .{ .x = threads } }, s, &a);
+    }
+
+    fn attend(d: *const Drafter, s: cuda.Stream, session: *const Session, i: usize) !void {
+        const a = d.scratch;
+        try launch(d.qk, s, block, w_.heads + w_.kv_heads, 64, .{ d.qkArgs(session, i, w_.heads, 0), a.position });
+        const at: dsp.AttnArgs = .{
+            .q = a.q,
+            .kc = session.k[i],
+            .vc = session.v[i],
+            .po = a.partials,
+            .pml = a.maxima,
+            .T = block,
+            .hq = w_.heads,
+            .hk = w_.kv_heads,
+            .ring = @intCast(d.ring_size),
+            .lo = 0,
+            .hi = 0,
+            .c0 = 0,
+            .scale = 1.0 / @sqrt(@as(f32, w_.dim)),
+        };
+        try launch(d.attention, s, chunks, w_.kv_heads, 256, .{ at, a.position, @as(i32, w_.window) });
+        try launch(d.k.merge, s, block * w_.heads, 1, 128, .{
+            a.partials, a.maxima, @as(i32, chunks), @as(i32, block * w_.heads), a.attn,
+        });
+    }
+
+    fn convInput(d: *const Drafter, k: *const ops.Kernels, s: cuda.Stream, norm: u64, cv: w_.Conv) !void {
+        const a = d.scratch;
+        try dsp.addNorm(&d.k, s, a.residual, 0, 0, 0, norm, a.normed, block, h, w_.eps);
+        try d.project(k, s, a.normed, cv.projection, a.delta, block, 4 * w_.groups, h);
+        try launch(d.convolve, s, block, 1, 256, .{ a.normed, a.delta, cv.base, a.conv, @as(i32, h), @as(i32, 0) });
+    }
+
+    fn convOutput(d: *const Drafter, k: *const ops.Kernels, s: cuda.Stream, x: u64, matrix: fp8.Matrix, width: usize, cv: w_.Conv) !void {
+        const a = d.scratch;
+        try d.project(k, s, x, matrix, a.conv, block, h, width);
+        try launch(d.convolve, s, block, 1, 256, .{ a.conv, a.delta, cv.base, a.residual, @as(i32, h), @as(i32, 1) });
+    }
+
+    fn selectStep(d: *const Drafter, s: cuda.Stream, i: usize, vocab: usize) !void {
+        const a = d.scratch;
+        const p = d.w.predecessor;
+        const q = d.w.successor;
+        var args: cuda.Args = .{};
+        for ([_]u64{ a.top, a.projected, p.data, q.data }) |ptr| args.add(ptr);
+        if (p.scales != 0) {
+            args.add(p.scales);
+            args.add(q.scales);
+        }
+        for ([_]u64{ a.walk, a.ids, a.scores }) |ptr| args.add(ptr);
+        args.add(@as(i32, @intCast(i)));
+        args.add(@as(i32, @intCast(vocab)));
+        args.add(@as(f32, w_.cap));
+        try cuda.launch.launch(d.select, .{ .grid = .{ .x = 1 }, .block = .{ .x = 512 } }, s, &args);
+    }
+
+    const Block = struct {
+        d: *Drafter,
+        m: *const engine.Model,
+        k: *const engine.Kernels,
+        key: Key,
+
+        fn run(ptr: *anyopaque, s: cuda.Stream) anyerror!void {
+            const b: *Block = @ptrCast(@alignCast(ptr));
+            const d = b.d;
+            const a = d.scratch;
+            const k = &b.k.glue;
+            const target = b.m.w.c.text;
+            const session = &d.sessions[b.key.slot];
+            try ops.embed(k, s, a.walk, block, b.m.w.embed, b.m.w.embed_norm, a.residual, h, target.eps);
+            for (d.w.layer, 0..) |l, i| {
+                try d.convInput(k, s, l.input_norm, l.attention_conv);
+                try d.project(k, s, a.conv, l.qkv, a.matrix, block, w_.q + 2 * w_.kv, h);
+                try d.attend(s, session, i);
+                try d.convOutput(k, s, a.attn, l.out, w_.q, l.attention_conv);
+
+                try d.convInput(k, s, l.post_norm, l.mlp_conv);
+                try d.project(k, s, a.conv, l.gate_up, a.matrix, block, 2 * w_.inter, h);
+                try dsp.silu(&d.k, s, a.matrix, a.act, block, w_.inter);
+                try d.convOutput(k, s, a.act, l.down, w_.inter, l.mlp_conv);
+            }
+            try dsp.addNorm(&d.k, s, a.residual, 0, 0, 0, d.w.norm, a.normed, block, h, w_.eps);
+            const x = a.normed + h * 2;
+            const n = b.key.n;
+            const v = target.unpadded_vocab;
+            // The target's padding rows cannot be offered by the draft.
+            if (d.w.base) |w| {
+                try d.lane.?.matmul(s, x, h, n, w, a.logits, 0);
+            } else {
+                try d.dense.rows(s, x, h, b.m.w.unembed, a.logits_f32, v, n, v, h);
+                try ops.tobf(k, s, a.logits_f32, n, v, v, a.logits, v, 0, v);
+            }
+            try b.k.draws.topkRows(s, a.logits, v, w_.top_k, a.top_parts, a.top, n);
+            try d.project(k, s, x, d.w.project, a.projected, n, w_.rank, h);
+            for (0..n) |i| {
+                try d.selectStep(s, i, v);
+                if (b.key.rule != 0) {
+                    try b.k.draws.draw(s, a.scores, w_.top_k, b.key.rule, a.position, i, a.walk + (i + 1) * 4, 1, a.ids, null);
+                }
+            }
+        }
+    };
+
+    pub fn propose(d: *Drafter, slot: usize, m: *const engine.Model, k: *const engine.Kernels, s: cuda.Stream, pending: u32, n: usize, rule: ?u64) !void {
+        const session = &d.sessions[slot];
+        if (n == 0 or n > depth or session.end == 0) return error.BadDraftDepth;
+        const a = d.scratch;
+        var ids: [block]u32 = @splat(w_.mask);
+        ids[0] = pending;
+        const position: i32 = @intCast(session.end);
+        try cuda.copy_source.enqueue(d.memory.d, a.walk, std.mem.sliceAsBytes(&ids), s);
+        try cuda.copy_source.enqueue(d.memory.d, a.position, std.mem.asBytes(&position), s);
+        const key: Key = .{ .slot = slot, .n = n, .rule = rule orelse 0 };
+        var b: Block = .{ .d = d, .m = m, .k = k, .key = key };
+        if (d.graphs) |*g| {
+            _ = try g.run(key, s, 0, .{ .ctx = &b, .run = Block.run });
+        } else try Block.run(&b, s);
+        try s.synchronize();
+        try d.memory.download(@intCast(a.walk - d.memory.ptr + 4), std.mem.sliceAsBytes(session.held[0..n]));
+        for (session.held[0..n]) |t| if (t >= m.w.c.text.unpadded_vocab) return error.DraftNonfinite;
+        session.held_len = n;
+    }
+};
diff --git a/zig/src/families/inkling2/dflash2_weights.zig b/zig/src/families/inkling2/dflash2_weights.zig
new file mode 100644
index 0000000..e421b7c
--- /dev/null
+++ b/zig/src/families/inkling2/dflash2_weights.zig
@@ -0,0 +1,301 @@
+//! Mini DFlash2 checkpoints in upstream BF16 or TensorFold's packed FP8G64 layout.
+const std = @import("std");
+const cuda = @import("cuda");
+const tensors = @import("core").safetensors;
+const config = @import("config.zig");
+const dspark = @import("dspark_weights.zig");
+const fp8 = @import("draft_fp8.zig");
+
+pub const hidden = 2304;
+pub const heads = 32;
+pub const kv_heads = 8;
+pub const dim = 128;
+pub const q = heads * dim;
+pub const kv = kv_heads * dim;
+pub const inter = 6912;
+pub const layers = 5;
+pub const vocab = 201024;
+pub const block = 8;
+pub const window = 2048;
+pub const groups = hidden / 16;
+pub const top_k = 16;
+pub const rank = 256;
+pub const eps = 1e-6;
+pub const theta = 10000.0;
+pub const cap = 30.0;
+pub const mask = 200056;
+
+const Config = struct {
+    architectures: [1][]const u8,
+    model_type: []const u8,
+    dtype: []const u8,
+    hidden_size: usize,
+    intermediate_size: usize,
+    num_hidden_layers: usize,
+    num_attention_heads: usize,
+    num_key_value_heads: usize,
+    head_dim: usize,
+    rms_norm_eps: f32,
+    rope_parameters: struct { rope_theta: f32, rope_type: []const u8 },
+    vocab_size: usize,
+    sliding_window: usize,
+    layer_types: [layers][]const u8,
+    attention_bias: bool,
+    hidden_act: []const u8,
+    is_causal: bool,
+    dflash_config: struct {
+        block_size: usize,
+        conv_group_size: usize,
+        conv_kernel_size: usize,
+        final_logit_softcapping: f32,
+        mask_token_id: usize,
+        selector_rank: usize,
+        selector_softcap_mode: []const u8,
+        selector_top_k: usize,
+        target_layer_ids: [dspark.taps.len]u32,
+    },
+
+    fn check(c: Config, target: *const config.Config) !void {
+        const d = c.dflash_config;
+        const eql = std.mem.eql;
+        if (target.text.hidden != hidden or target.text.vocab != vocab or
+            target.text.unpadded_vocab <= mask or target.text.unpadded_vocab > vocab or !eql(u8, c.architectures[0], "DFlash2DraftModel") or
+            !eql(u8, c.model_type, "qwen3") or !eql(u8, c.dtype, "bfloat16") or !eql(u8, c.hidden_act, "silu") or
+            c.hidden_size != hidden or c.intermediate_size != inter or c.num_hidden_layers != layers or
+            c.num_attention_heads != heads or c.num_key_value_heads != kv_heads or c.head_dim != dim or
+            c.rms_norm_eps != eps or c.rope_parameters.rope_theta != theta or
+            !eql(u8, c.rope_parameters.rope_type, "default") or c.vocab_size != vocab or c.sliding_window != window or
+            c.attention_bias or c.is_causal or d.block_size != block or d.conv_group_size != 16 or
+            d.conv_kernel_size != 2 or d.final_logit_softcapping != cap or d.mask_token_id != mask or
+            d.selector_rank != rank or d.selector_top_k != top_k or !eql(u8, d.selector_softcap_mode, "after_correction") or
+            !eql(u32, &d.target_layer_ids, &dspark.taps)) return error.UnsupportedMiniDFlash2Config;
+        for (c.layer_types) |layer| {
+            if (!eql(u8, layer, "sliding_attention")) return error.UnsupportedMiniDFlash2Config;
+        }
+    }
+};
+
+pub fn isDFlash2(a: std.mem.Allocator, io: std.Io, dir: []const u8, target: *const config.Config) !bool {
+    if (std.mem.endsWith(u8, dir, ".safetensors")) return false;
+    const path = try std.fs.path.join(a, &.{ dir, "config.json" });
+    defer a.free(path);
+    const bytes = std.Io.Dir.cwd().readFileAlloc(io, path, a, .limited(1 << 20)) catch |err| switch (err) {
+        error.FileNotFound => return false,
+        else => return err,
+    };
+    defer a.free(bytes);
+    const root = try std.json.parseFromSlice(std.json.Value, a, bytes, .{});
+    defer root.deinit();
+    if (root.value != .object or !root.value.object.contains("dflash_config")) return false;
+    const cfg = std.json.parseFromValue(Config, a, root.value, .{ .ignore_unknown_fields = true }) catch |err| switch (err) {
+        error.OutOfMemory => return err,
+        else => return error.UnsupportedMiniDFlash2Config,
+    };
+    defer cfg.deinit();
+    try cfg.value.check(target);
+    return true;
+}
+
+pub const Conv = struct { base: u64, projection: fp8.Matrix };
+
+pub const Layer = struct {
+    qkv: fp8.Matrix,
+    out: fp8.Matrix,
+    gate_up: fp8.Matrix,
+    down: fp8.Matrix,
+    input_norm: u64,
+    post_norm: u64,
+    q_norm: u64,
+    k_norm: u64,
+    attention_conv: Conv,
+    mlp_conv: Conv,
+};
+
+pub const Weights = struct {
+    memory: cuda.DeviceBuffer,
+    layer: [layers]Layer,
+    fuse: fp8.Matrix,
+    fuse_norm: u64,
+    norm: u64,
+    project: fp8.Matrix,
+    predecessor: fp8.Table,
+    successor: fp8.Table,
+    base: ?cuda.qmmf.Weight,
+    fp8_layers: bool,
+
+    pub fn deinit(w: *Weights) void {
+        w.memory.free();
+    }
+};
+
+const Reader = struct {
+    file: *const tensors.File,
+    arena: fp8.Arena = .{},
+    options: fp8.Options,
+    packed_layers: bool,
+    selector_rows: usize,
+    count: usize = 0,
+
+    fn tensor(r: *Reader, name: []const u8, shape: []const usize) ![]const u8 {
+        return r.typedTensor(name, .bf16, shape);
+    }
+
+    fn typedTensor(r: *Reader, name: []const u8, dtype: tensors.DType, shape: []const usize) ![]const u8 {
+        const t = r.file.get(name) orelse return bad(name);
+        if (t.dtype != dtype or !std.mem.eql(usize, t.shape[0..t.rank], shape)) return bad(name);
+        r.count += 1;
+        return t.bytes;
+    }
+
+    fn put(r: *Reader, name: []const u8, shape: []const usize) !u64 {
+        return r.arena.put(&.{try r.tensor(name, shape)});
+    }
+
+    fn bad(name: []const u8) error{MiniDFlash2Tensor} {
+        std.log.err("Mini DFlash2: missing tensor or incompatible dtype/shape for {s}", .{name});
+        return error.MiniDFlash2Tensor;
+    }
+
+    fn at(r: *Reader, layer: usize, comptime suffix: []const u8, shape: []const usize) !u64 {
+        var name: [96]u8 = undefined;
+        return r.put(try std.fmt.bufPrint(&name, "layers.{d}." ++ suffix, .{layer}), shape);
+    }
+
+    fn conv(r: *Reader, layer: usize, comptime prefix: []const u8) !Conv {
+        return .{
+            .base = try r.at(layer, prefix ++ ".base_kernel", &.{ 2, 2, hidden }),
+            .projection = try r.matrix(layer, &.{prefix ++ ".kernel_projection.weight"}, .{4 * groups}, hidden),
+        };
+    }
+
+    fn layerMatrix(r: *Reader, comptime count: usize, names: [count][]const u8, ns: [count]usize, k: usize) !fp8.Matrix {
+        var parts: [count][]const u8 = undefined;
+        if (r.packed_layers) {
+            var scales: [count][]const u8 = undefined;
+            for (names, ns, &parts, &scales) |name, n, *data, *scale| {
+                const padded = cuda.modelopt.padded(n);
+                if (count > 1 and padded != n) return bad(name);
+                const column_groups = k / cuda.qmmf.group;
+                const tiles = padded / 64;
+                data.* = try r.typedTensor(name, .f8_e4m3, &.{ tiles, column_groups, 8, 32, 16 });
+                var key: [128]u8 = undefined;
+                const scale_name = try std.fmt.bufPrint(&key, "{s}.tf_fp8g64_scale", .{name});
+                scale.* = try r.typedTensor(scale_name, .f32, &.{ tiles, column_groups, 64 });
+            }
+            return r.arena.packedMatrix(&parts, &scales);
+        }
+        for (names, ns, &parts) |name, n, *part| part.* = try r.tensor(name, &.{ n, k });
+        return r.arena.matrix(&parts, @reduce(.Add, @as(@Vector(count, usize), ns)), k, r.options.layers);
+    }
+
+    fn matrix(r: *Reader, layer: usize, comptime suffixes: []const []const u8, ns: [suffixes.len]usize, k: usize) !fp8.Matrix {
+        var storage: [suffixes.len][96]u8 = undefined;
+        var names: [suffixes.len][]const u8 = undefined;
+        inline for (suffixes, &storage, &names) |suffix, *name, *part| {
+            part.* = try std.fmt.bufPrint(name, "layers.{d}." ++ suffix, .{layer});
+        }
+        return r.layerMatrix(suffixes.len, names, ns, k);
+    }
+
+    fn codebook(r: *Reader, name: []const u8) !fp8.Table {
+        const bytes = try r.tensor(name, &.{ vocab, rank });
+        // The selector already bounds both the predecessor and candidate IDs by the real vocabulary.
+        return r.arena.table(bytes[0 .. r.selector_rows * rank * @sizeOf(u16)], r.selector_rows, rank, r.options.head);
+    }
+
+    fn read(r: *Reader, n_vocab: usize, base: ?fp8.BaseHead) !Weights {
+        var ls: [layers]Layer = undefined;
+        for (&ls, 0..) |*l, i| {
+            const qkv = try r.matrix(i, &.{ "self_attn.q_proj.weight", "self_attn.k_proj.weight", "self_attn.v_proj.weight" }, .{ q, kv, kv }, hidden);
+            const gate_up = try r.matrix(i, &.{ "mlp.gate_proj.weight", "mlp.up_proj.weight" }, .{ inter, inter }, hidden);
+            l.* = .{
+                .qkv = qkv,
+                .out = try r.matrix(i, &.{"self_attn.o_proj.weight"}, .{hidden}, q),
+                .gate_up = gate_up,
+                .down = try r.matrix(i, &.{"mlp.down_proj.weight"}, .{hidden}, inter),
+                .input_norm = try r.at(i, "input_layernorm.weight", &.{hidden}),
+                .post_norm = try r.at(i, "post_attention_layernorm.weight", &.{hidden}),
+                .q_norm = try r.at(i, "self_attn.q_norm.weight", &.{dim}),
+                .k_norm = try r.at(i, "self_attn.k_norm.weight", &.{dim}),
+                .attention_conv = try r.conv(i, "attention_conv"),
+                .mlp_conv = try r.conv(i, "mlp_conv"),
+            };
+        }
+        const out: Weights = .{
+            .memory = r.arena.memory orelse undefined,
+            .layer = ls,
+            .fuse = try r.layerMatrix(1, .{"fc.weight"}, .{hidden}, dspark.taps.len * hidden),
+            .fuse_norm = try r.put("hidden_norm.weight", &.{hidden}),
+            .norm = try r.put("norm.weight", &.{hidden}),
+            .project = try r.arena.matrix(&.{try r.tensor("candidate_selector.hidden_projection.weight", &.{ rank, hidden })}, rank, hidden, r.options.head),
+            .predecessor = try r.codebook("candidate_selector.predecessor_codebook"),
+            .successor = try r.codebook("candidate_selector.successor_codebook"),
+            .base = try r.arena.base(r.options, base, n_vocab, hidden),
+            .fp8_layers = r.packed_layers or r.options.layers,
+        };
+        if (r.file.names.count() != r.count) return error.MiniDFlash2Tensor;
+        return out;
+    }
+};
+
+fn open(a: std.mem.Allocator, io: std.Io, dir: []const u8) !tensors.File {
+    const path = try std.fs.path.join(a, &.{ dir, "model.safetensors" });
+    defer a.free(path);
+    return tensors.File.open(a, io, path);
+}
+
+fn selectorRows(n_vocab: usize) usize {
+    return if (@import("sys").environment.read(bool, "TF_INKLING2_DFLASH2_TRIM_SELECTOR", true) catch true) n_vocab else vocab;
+}
+
+fn packedLayers(file: *const tensors.File) bool {
+    const t = file.get("fc.weight") orelse return false;
+    return t.dtype == .f8_e4m3;
+}
+
+fn size(file: *const tensors.File, n_vocab: usize, options: fp8.Options, selector_rows: usize) !usize {
+    var r: Reader = .{ .file = file, .options = options, .packed_layers = packedLayers(file), .selector_rows = selector_rows };
+    _ = try r.read(n_vocab, null);
+    return r.arena.used;
+}
+
+pub fn checkpointBytes(a: std.mem.Allocator, io: std.Io, dir: []const u8, n_vocab: usize, options: fp8.Options) !usize {
+    var file = try open(a, io, dir);
+    defer file.close(io);
+    return size(&file, n_vocab, options, selectorRows(n_vocab));
+}
+
+pub fn load(a: std.mem.Allocator, io: std.Io, dir: []const u8, n_vocab: usize, options: fp8.Options, base: fp8.BaseHead) !Weights {
+    var file = try open(a, io, dir);
+    defer file.close(io);
+    const d = base.stream.d;
+    const selector_rows = selectorRows(n_vocab);
+    const packed_layers = packedLayers(&file);
+    var mem = try cuda.DeviceBuffer.alloc(d, try size(&file, n_vocab, options, selector_rows));
+    errdefer mem.free();
+    const stage = @max(if (options.layers and !packed_layers) @as(usize, 2 * 2 * inter * hidden) else 0, if (options.head) selector_rows * rank * 2 else 0);
+    var p = if (stage != 0) try fp8.Packer.init(d, base.stream, stage) else null;
+    defer if (p) |*packer| packer.deinit();
+    var r: Reader = .{
+        .file = &file,
+        .arena = .{ .memory = mem, .packer = if (p) |*packer| packer else null },
+        .options = options,
+        .packed_layers = packed_layers,
+        .selector_rows = selector_rows,
+    };
+    return r.read(n_vocab, base);
+}
+
+test "explicit draft directory releases its config on fallback and refusal" {
+    const a = std.testing.allocator;
+    const io = std.testing.io;
+    var tmp = std.testing.tmpDir(.{});
+    defer tmp.cleanup();
+    const dir = try tmp.dir.realPathFileAlloc(io, ".", a);
+    defer a.free(dir);
+    const target: config.Config = undefined;
+    try tmp.dir.writeFile(io, .{ .sub_path = "config.json", .data = "{}" });
+    try std.testing.expect(!try isDFlash2(a, io, dir, &target));
+    try tmp.dir.writeFile(io, .{ .sub_path = "config.json", .data = "{\"dflash_config\":{}}" });
+    try std.testing.expectError(error.UnsupportedMiniDFlash2Config, isDFlash2(a, io, dir, &target));
+}
diff --git a/zig/src/families/inkling2/draft_fp8.zig b/zig/src/families/inkling2/draft_fp8.zig
new file mode 100644
index 0000000..a2fd6ea
--- /dev/null
+++ b/zig/src/families/inkling2/draft_fp8.zig
@@ -0,0 +1,168 @@
+//! Optional E4M3 storage for Mini draft projections and selector rows.
+
+// Copyright 2026 MiaAI-Lab, draft-only FP8 head design adapted from patch 0006.
+const std = @import("std");
+const cuda = @import("cuda");
+const lazy_head = @import("loop_lazy_head.zig");
+
+pub const Options = struct {
+    layers: bool = false,
+    head: bool = false,
+    borrow_head: bool = false,
+
+    pub fn fromEnv(borrow_head: bool, default_fp8: bool) Options {
+        return .{
+            .layers = @import("sys").environment.read(bool, "TF_INKLING2_DRAFT_FP8_LAYERS", default_fp8) catch false,
+            .head = @import("sys").environment.read(bool, "TF_INKLING2_DRAFT_FP8_HEAD", default_fp8) catch false,
+            .borrow_head = borrow_head,
+        };
+    }
+
+    pub fn active(o: Options) bool {
+        return o.layers or o.head;
+    }
+
+    pub fn baseBytes(o: Options, n: usize, k: usize) usize {
+        return if (o.head and !o.borrow_head) lazy_head.codeBytes(n, k) else 0;
+    }
+};
+
+/// A BF16 row-major weight, or a CUDA lane with one f32 scale per group of 64 inputs.
+pub const Matrix = struct {
+    data: u64,
+    scales: u64 = 0,
+
+    pub fn afterRows(m: Matrix, rows: usize, k: usize) Matrix {
+        if (m.scales == 0) return .{ .data = m.data + rows * k * 2 };
+        std.debug.assert(rows % 128 == 0);
+        return .{ .data = m.data + rows * k, .scales = m.scales + rows * (k / cuda.qmmf.group) * 4 };
+    }
+
+    pub fn lane(m: Matrix, n: usize, k: usize) cuda.qmmf.Weight {
+        std.debug.assert(m.scales != 0);
+        return cuda.fp8.weight(m.data, m.scales, n, k);
+    }
+};
+
+/// A BF16 or row-scaled FP8 rank-256 lookup table.
+pub const Table = struct { data: u64, scales: u64 = 0 };
+
+pub const BaseHead = struct {
+    stream: cuda.Stream,
+    source: u64,
+    borrowed: ?cuda.qmmf.Weight,
+};
+
+pub const Packer = struct {
+    stream: cuda.Stream,
+    mod: cuda.Module,
+    staging: cuda.DeviceBuffer,
+    matrix: cuda.Function,
+    rows: cuda.Function,
+
+    pub fn init(d: *const cuda.Driver, s: cuda.Stream, staging_bytes: usize) !Packer {
+        var mod = try cuda.Module.load(d, cuda.kernels.inkling2_dspark);
+        errdefer mod.unload();
+        const matrix = try mod.function("tf_ink2_draft_pack_layers");
+        const rows = try mod.function("tf_ink2_draft_pack_rows");
+        return .{ .stream = s, .mod = mod, .matrix = matrix, .rows = rows, .staging = try cuda.DeviceBuffer.alloc(d, staging_bytes) };
+    }
+
+    pub fn deinit(p: *Packer) void {
+        p.staging.free();
+        p.mod.unload();
+    }
+
+    fn apply(p: *const Packer, sources: []const []const u8, f: cuda.Function, data: u64, scales: u64, n: usize, k: usize, work: usize) !void {
+        var offset: usize = 0;
+        for (sources) |source| {
+            try p.staging.upload(offset, source);
+            offset += source.len;
+        }
+        std.debug.assert(offset == n * k * 2);
+        var a: cuda.Args = .{};
+        a.add(p.staging.ptr);
+        a.add(data);
+        a.add(scales);
+        a.add(@as(i32, @intCast(n)));
+        a.add(@as(i32, @intCast(k)));
+        try cuda.launch.launch(f, .{ .grid = .{ .x = @intCast((work + 7) / 8) }, .block = .{ .x = 256 } }, p.stream, &a);
+        try p.stream.synchronize();
+    }
+};
+
+pub fn loadLane(d: *const cuda.Driver, wanted: bool) !?cuda.qmmf.Lane {
+    if (!wanted) return null;
+    const sm = try d.currentCapability();
+    if (sm < 120) return error.MiniDraftFp8RequiresBlackwell;
+    return try cuda.qmmf.Lane.load(d, sm / 10);
+}
+
+/// Host-only accounting and real device upload walk the same tensor order.
+pub const Arena = struct {
+    memory: ?cuda.DeviceBuffer = null,
+    packer: ?*const Packer = null,
+    used: usize = 0,
+
+    fn alloc(a: *Arena, bytes: usize) u64 {
+        a.used = std.mem.alignForward(usize, a.used, 16);
+        const at = a.used;
+        a.used += bytes;
+        return (if (a.memory) |mem| mem.ptr else 0) + at;
+    }
+
+    pub fn put(a: *Arena, sources: []const []const u8) !u64 {
+        var bytes: usize = 0;
+        for (sources) |source| bytes += source.len;
+        const ptr = a.alloc(bytes);
+        if (a.memory) |mem| {
+            var offset = ptr - mem.ptr;
+            for (sources) |source| {
+                try mem.upload(offset, source);
+                offset += source.len;
+            }
+        }
+        return ptr;
+    }
+
+    pub fn matrix(a: *Arena, sources: []const []const u8, n: usize, k: usize, fp8: bool) !Matrix {
+        if (!fp8) return .{ .data = try a.put(sources) };
+        if (k % cuda.qmmf.group != 0) return error.Inkling2DraftShape;
+        const padded = cuda.modelopt.padded(n);
+        const groups = k / cuda.qmmf.group;
+        const data = a.alloc(padded * k);
+        const scales = a.alloc(padded * groups * 4);
+        if (a.packer) |p| try p.apply(sources, p.matrix, data, scales, n, k, padded * groups);
+        return .{ .data = data, .scales = scales };
+    }
+
+    pub fn packedMatrix(a: *Arena, data: []const []const u8, scales: []const []const u8) !Matrix {
+        return .{ .data = try a.put(data), .scales = try a.put(scales) };
+    }
+
+    pub fn table(a: *Arena, source: ?[]const u8, n: usize, k: usize, fp8: bool) !Table {
+        if (!fp8) return if (source) |bytes| .{ .data = try a.put(&.{bytes}) } else .{ .data = a.alloc(n * k * 2) };
+        const data = a.alloc(n * k);
+        const scales = a.alloc(n * 4);
+        if (a.packer) |p| try p.apply(&.{source.?}, p.rows, data, scales, n, k, n);
+        return .{ .data = data, .scales = scales };
+    }
+
+    pub fn base(a: *Arena, o: Options, head: ?BaseHead, n: usize, k: usize) !?cuda.qmmf.Weight {
+        if (!o.head) return null;
+        if (o.borrow_head) return if (head) |h| h.borrowed else null;
+        const dest = a.alloc(o.baseBytes(n, k));
+        if (head) |h| return try lazy_head.pack(h.stream.d, h.stream, h.source, dest, n, k);
+        return null;
+    }
+};
+
+test "Mini FP8 matrices keep the K/V suffix at its own packed tile and scale" {
+    var a: Arena = .{ .used = 256 };
+    const projection = try a.matrix(&.{}, 6144, 2304, true);
+    const kv = projection.afterRows(4096, 2304);
+    try std.testing.expectEqual(projection.data + 4096 * 2304, kv.data);
+    try std.testing.expectEqual(projection.scales + 4096 * (2304 / 64) * 4, kv.scales);
+    try std.testing.expectEqual(256 + 6144 * (2304 + (2304 / 64) * 4), a.used);
+    try std.testing.expectEqual(@as(u32, 2048), kv.lane(2048, 2304).npad);
+}
diff --git a/zig/src/families/inkling2/dspark_cuda.zig b/zig/src/families/inkling2/dspark_cuda.zig
new file mode 100644
index 0000000..d93ef71
--- /dev/null
+++ b/zig/src/families/inkling2/dspark_cuda.zig
@@ -0,0 +1,423 @@
+//! Mini DSpark on one CUDA stream: commit target features, then propose a masked eight-row block.
+const std = @import("std");
+const cuda = @import("cuda");
+const w_ = @import("dspark_weights.zig");
+const dsp = @import("dspark_ops.zig");
+const engine = @import("loop_engine.zig");
+const loop_math = @import("loop_math_cuda.zig");
+const ops = @import("ops.zig");
+const fp8 = @import("draft_fp8.zig");
+
+const h = w_.hidden;
+const q = w_.q;
+const kv = w_.kv;
+const inter = w_.inter;
+const rank = w_.rank;
+const block = w_.block;
+const local_window = 1024;
+const local_ring = local_window + block;
+const absorb_rows = 64;
+pub const depth = block - 1;
+pub const tap_stride = 4 * h * 2;
+pub fn sharedTapBytes(rows: usize) usize {
+    return rows * tap_stride;
+}
+
+fn partialSizes(context: usize) [2]usize {
+    const chunks = (context + block + dsp.chunk - 1) / dsp.chunk;
+    return .{ chunks * block * q * 4, chunks * block * 24 * 8 };
+}
+
+pub fn partialBytes(context: usize) usize {
+    const sizes = partialSizes(context);
+    return std.mem.alignForward(usize, sizes[0], 256) + std.mem.alignForward(usize, sizes[1], 256);
+}
+
+const Scratch = struct {
+    taps: u64,
+    mixed: u64,
+    matrix_rows: u64,
+    residual: u64,
+    x: u64,
+    query: u64,
+    out: u64,
+    act: u64,
+    f32_rows: u64,
+    partial: u64,
+    maxima: u64,
+    base: u64,
+    kappa: u64,
+    state: u64,
+    latent: u64,
+    walk: u64,
+    draw: u64,
+
+    fn layout(base: u64, context: usize, rows_per_pass: usize, total: *usize) Scratch {
+        const partials = partialSizes(context);
+        const b = 2;
+        const sizes = .{
+            .taps = sharedTapBytes(rows_per_pass),
+            .mixed = absorb_rows * h * b,
+            .matrix_rows = @max(absorb_rows * 2 * kv, block * 2 * inter) * b,
+            .residual = block * h * b,
+            .x = block * h * b,
+            .query = block * q * b,
+            .out = block * q * b,
+            .act = block * inter * b,
+            .f32_rows = depth * w_.vocab * 4,
+            .partial = partials[0],
+            .maxima = partials[1],
+            .base = depth * w_.vocab * b,
+            .kappa = depth * 3 * rank * 4,
+            .state = rank * b,
+            .latent = rank * b,
+            .walk = block * 4,
+            .draw = depth * 16,
+        };
+        var out: Scratch = undefined;
+        inline for (@typeInfo(@TypeOf(sizes)).@"struct".field_names) |field| {
+            @field(out, field) = base + total.*;
+            total.* += std.mem.alignForward(usize, @field(sizes, field), 256);
+        }
+        return out;
+    }
+};
+
+/// KV, the last fusion vector, and the target taps waiting to be committed belong to a request.
+pub const Session = struct {
+    memory: cuda.DeviceBuffer,
+    k: [5]u64,
+    v: [5]u64,
+    newest: u64,
+    taps: u64,
+    end: usize = 0,
+    pending: usize = 0,
+    held: [depth]u32 = undefined,
+    held_len: usize = 0,
+
+    pub const newest_bytes = h * 2;
+    pub const tap_bytes = 2 * engine.window_rows * tap_stride;
+
+    fn kvRings(context: usize) [3]usize {
+        return .{ local_ring, context + block, local_ring };
+    }
+
+    pub fn kvBytes(context: usize) usize {
+        const rings = kvRings(context);
+        return (rings[0] + rings[1] + rings[2]) * 2 * kv * 2;
+    }
+
+    pub fn bytes(context: usize) usize {
+        return kvBytes(context) + newest_bytes + tap_bytes;
+    }
+
+    pub fn init(d: *const cuda.Driver, context: usize) !Session {
+        return initRings(d, &kvRings(context), newest_bytes);
+    }
+
+    pub fn initRings(d: *const cuda.Driver, rings: []const usize, newest_size: usize) !Session {
+        var kv_bytes: usize = 0;
+        for (rings) |ring| kv_bytes += ring * 2 * kv * 2;
+        const memory = try cuda.DeviceBuffer.alloc(d, kv_bytes + newest_size + tap_bytes);
+        var session: Session = .{ .memory = memory, .k = undefined, .v = undefined, .newest = undefined, .taps = undefined };
+        var at = memory.ptr;
+        for (rings, session.k[0..rings.len], session.v[0..rings.len]) |ring, *key, *value| {
+            key.* = at;
+            at += ring * kv * 2;
+            value.* = at;
+            at += ring * kv * 2;
+        }
+        session.newest = at;
+        session.taps = at + newest_size;
+        return session;
+    }
+
+    fn committedRows(layer: usize, at: usize) usize {
+        return if (layer == 1) at else @min(at, local_window);
+    }
+
+    pub fn committedBytes(at: usize) usize {
+        return (at + 2 * committedRows(0, at)) * 2 * kv * 2 + newest_bytes;
+    }
+
+    /// Visit the committed BF16 K/V spans in logical order, followed by the last fusion vector.
+    pub fn eachCommitted(session: *const Session, at: usize, writer: anytype) !void {
+        const row_bytes = kv * 2;
+        for (0..3) |layer| {
+            const rows = committedRows(layer, at);
+            const first = if (layer == 1) 0 else (at - rows) % local_ring;
+            const head = if (layer == 1) rows else @min(rows, local_ring - first);
+            for ([2]u64{ session.k[layer], session.v[layer] }) |base| {
+                if (head > 0) try writer.span(base + first * row_bytes, head * row_bytes);
+                if (head < rows) try writer.span(base, (rows - head) * row_bytes);
+            }
+        }
+        try writer.span(session.newest, newest_bytes);
+    }
+
+    pub fn reset(session: *Session) void {
+        session.end = 0;
+        session.pending = 0;
+        session.held_len = 0;
+    }
+};
+
+test "DSpark snapshots visit only committed KV rows and the fusion vector" {
+    const Span = struct { ptr: u64, bytes: usize };
+    const Recorder = struct {
+        writes: std.ArrayList(Span) = .empty,
+        bytes: usize = 0,
+
+        pub fn span(w: *@This(), ptr: u64, bytes: usize) !void {
+            try w.writes.append(std.testing.allocator, .{ .ptr = ptr, .bytes = bytes });
+            w.bytes += bytes;
+        }
+    };
+    var session: Session = undefined;
+    session.k = .{ 10_000_000, 30_000_000, 50_000_000, undefined, undefined };
+    session.v = .{ 20_000_000, 40_000_000, 60_000_000, undefined, undefined };
+    session.newest = 70_000_000;
+    var w: Recorder = .{};
+    defer w.writes.deinit(std.testing.allocator);
+    const row = kv * 2;
+
+    try session.eachCommitted(128, &w);
+    try std.testing.expectEqual(6 * 128 * row + Session.newest_bytes, Session.committedBytes(128));
+    try std.testing.expectEqual(Session.committedBytes(128), w.bytes);
+    try std.testing.expectEqualSlices(Span, &.{
+        .{ .ptr = session.k[0], .bytes = 128 * row },
+        .{ .ptr = session.v[0], .bytes = 128 * row },
+        .{ .ptr = session.k[1], .bytes = 128 * row },
+        .{ .ptr = session.v[1], .bytes = 128 * row },
+        .{ .ptr = session.k[2], .bytes = 128 * row },
+        .{ .ptr = session.v[2], .bytes = 128 * row },
+        .{ .ptr = session.newest, .bytes = Session.newest_bytes },
+    }, w.writes.items);
+
+    w.writes.clearRetainingCapacity();
+    w.bytes = 0;
+    const at = local_ring + 5;
+    const first = (block + 5) * row;
+    const tail = (local_window - 5) * row;
+    try session.eachCommitted(at, &w);
+    try std.testing.expectEqual((2 * local_window + at) * 2 * row + Session.newest_bytes, Session.committedBytes(at));
+    try std.testing.expectEqual(Session.committedBytes(at), w.bytes);
+    try std.testing.expectEqualSlices(Span, &.{
+        .{ .ptr = session.k[0] + first, .bytes = tail },
+        .{ .ptr = session.k[0], .bytes = 5 * row },
+        .{ .ptr = session.v[0] + first, .bytes = tail },
+        .{ .ptr = session.v[0], .bytes = 5 * row },
+        .{ .ptr = session.k[1], .bytes = at * row },
+        .{ .ptr = session.v[1], .bytes = at * row },
+        .{ .ptr = session.k[2] + first, .bytes = tail },
+        .{ .ptr = session.k[2], .bytes = 5 * row },
+        .{ .ptr = session.v[2] + first, .bytes = tail },
+        .{ .ptr = session.v[2], .bytes = 5 * row },
+        .{ .ptr = session.newest, .bytes = Session.newest_bytes },
+    }, w.writes.items);
+}
+
+pub const Drafter = struct {
+    w: w_.Weights,
+    k: dsp.Kernels,
+    dense: cuda.dense_rows.DenseRows,
+    lane: ?cuda.qmmf.Lane,
+    vocab8: ?cuda.Function,
+    memory: cuda.DeviceBuffer,
+    scratch: Scratch,
+    rings: [3]usize,
+    sessions: [engine.max_slots]Session = undefined,
+    count: usize = 0,
+
+    pub fn scratchBytes(context: usize, rows_per_pass: usize) usize {
+        var bytes: usize = 0;
+        _ = Scratch.layout(0, context, rows_per_pass, &bytes);
+        return bytes;
+    }
+
+    pub fn allocScratch(d: *const cuda.Driver, context: usize, rows_per_pass: usize) !cuda.DeviceBuffer {
+        return cuda.DeviceBuffer.alloc(d, scratchBytes(context, rows_per_pass));
+    }
+
+    /// Takes ownership of the weights only on success.
+    pub fn init(d: *const cuda.Driver, w: w_.Weights, context: usize, rows_per_pass: usize) !Drafter {
+        var kernels = try dsp.Kernels.load(d);
+        errdefer kernels.unload();
+        var dense = try cuda.dense_rows.DenseRows.load(d);
+        errdefer dense.unload();
+        var lane = try fp8.loadLane(d, w.fp8_layers or w.base != null);
+        errdefer if (lane) |*l| l.unload();
+        var memory = try allocScratch(d, context, rows_per_pass);
+        errdefer memory.free();
+        var bytes: usize = 0;
+        var out: Drafter = .{
+            .w = w,
+            .k = kernels,
+            .dense = dense,
+            .lane = lane,
+            .vocab8 = if (w.phi.scales != 0) try kernels.mod.function("tf_ink2_dsp_vocab8") else null,
+            .memory = memory,
+            .scratch = Scratch.layout(memory.ptr, context, rows_per_pass, &bytes),
+            .rings = Session.kvRings(context),
+        };
+        try out.reserve(1);
+        return out;
+    }
+
+    pub fn reserve(d: *Drafter, count: usize) !void {
+        while (d.count < count) {
+            d.sessions[d.count] = try Session.init(d.memory.d, d.rings[1] - block);
+            d.count += 1;
+        }
+    }
+
+    pub fn deinit(d: *Drafter) void {
+        for (d.sessions[0..d.count]) |*session| session.memory.free();
+        d.memory.free();
+        if (d.lane) |*l| l.unload();
+        d.dense.unload();
+        d.k.unload();
+        d.w.deinit();
+    }
+
+    fn copy(d: *const Drafter, s: cuda.Stream, to: u64, from: u64, bytes: usize) !void {
+        const drv = d.memory.d;
+        try drv.check(drv.api.cuMemcpyDtoDAsync_v2(to, from, bytes, s.handle), "cuMemcpyDtoDAsync");
+    }
+
+    fn project(d: *const Drafter, k: *const ops.Kernels, s: cuda.Stream, x: u64, w: fp8.Matrix, to: u64, rows: usize, n: usize, c: usize) !void {
+        if (w.scales != 0) return d.lane.?.matmul(s, x, c, rows, w.lane(n, c), to, 0);
+        const f = d.scratch.f32_rows;
+        try d.dense.rows(s, x, c, w.data, f, n, rows, n, c);
+        try ops.tobf(k, s, f, rows, n, n, to, n, 0, n);
+    }
+
+    pub fn absorb(d: *Drafter, session: *Session, glue: *const ops.Kernels, s: cuda.Stream, from: u64, pos: usize, rows: usize, eps: f32) !void {
+        if (pos != session.end) return error.DraftContextGap;
+        const a = d.scratch;
+        var offset: usize = 0;
+        while (offset < rows) {
+            const n = @min(rows - offset, absorb_rows);
+            const taps = from + offset * tap_stride;
+            for (d.w.layers, 0..) |l, i| {
+                try dsp.mix(&d.k, s, taps, d.w.alpha + i * 16, l.dflare, a.mixed, n, w_.taps.len, h, eps);
+                try d.project(glue, s, a.mixed, l.ctx_kv, a.matrix_rows, n, 2 * kv, h);
+                try dsp.qk(&d.k, s, .{
+                    .x = a.matrix_rows,
+                    .qw = 0,
+                    .kw = l.ctx_norm,
+                    .q = 0,
+                    .kc = session.k[i],
+                    .vc = session.v[i],
+                    .ld = 2 * kv,
+                    .hq = 0,
+                    .hk = 8,
+                    .ring = @intCast(d.rings[i]),
+                    .pos0 = @intCast(pos + offset),
+                    .eps = eps,
+                    .theta = 1e6,
+                }, n);
+            }
+            offset += n;
+        }
+        if (rows > 0) try dsp.mix(&d.k, s, from + (rows - 1) * tap_stride, d.w.alpha + 3 * 16, d.w.markov_norm, session.newest, 1, w_.taps.len, h, eps);
+        session.end += rows;
+        session.held_len = 0;
+    }
+
+    fn residual(d: *const Drafter, k: *const engine.Kernels, s: cuda.Stream, x: u64, weight: u64, matrix: fp8.Matrix, width: usize, eps: f32) !void {
+        const a = d.scratch;
+        if (matrix.scales != 0)
+            try d.lane.?.matmulF32(s, x, width, block, matrix.lane(h, width), a.f32_rows, 0)
+        else
+            try d.dense.rows(s, x, width, matrix.data, a.f32_rows, h, block, h, width);
+        try loop_math.roundBf16(&k.loop, s, a.f32_rows, a.f32_rows, block * h);
+        try dsp.addNorm(&d.k, s, a.residual, a.f32_rows, 1, block * h, weight, a.x, block, h, eps);
+    }
+
+    fn encode(d: *const Drafter, session: *const Session, m: *const engine.Model, k: *const engine.Kernels, s: cuda.Stream, n: usize) !void {
+        const a = d.scratch;
+        const c = m.w.c.text;
+        try ops.embed(&k.glue, s, a.walk, 1, m.w.embed, m.w.embed_norm, a.residual, h, c.eps);
+        for (1..block) |i| try d.copy(s, a.residual + i * h * 2, d.w.mask, h * 2);
+        try dsp.addNorm(&d.k, s, a.residual, 0, 0, 0, d.w.layers[0].input_norm, a.x, block, h, c.eps);
+        for (d.w.layers, 0..) |l, i| {
+            try d.project(&k.glue, s, a.x, l.qkv, a.matrix_rows, block, q + 2 * kv, h);
+            try dsp.qk(&d.k, s, .{
+                .x = a.matrix_rows,
+                .qw = l.q_norm,
+                .kw = l.k_norm,
+                .q = a.query,
+                .kc = session.k[i],
+                .vc = session.v[i],
+                .ld = q + 2 * kv,
+                .hq = 24,
+                .hk = 8,
+                .ring = @intCast(d.rings[i]),
+                .pos0 = @intCast(session.end),
+                .eps = c.eps,
+                .theta = 1e6,
+            }, block);
+            try dsp.attend(&d.k, s, .{
+                .q = a.query,
+                .kc = session.k[i],
+                .vc = session.v[i],
+                .po = a.partial,
+                .pml = a.maxima,
+                .T = block,
+                .hq = 24,
+                .hk = 8,
+                .ring = @intCast(d.rings[i]),
+                .lo = @intCast(if (i == 1) 0 else session.end -| local_window),
+                .hi = @intCast(session.end + block - 1),
+                .c0 = 0,
+                .scale = 1.0 / @sqrt(@as(f32, dsp.head_dim)),
+            }, a.out);
+            try d.residual(k, s, a.out, l.post_norm, l.out, q, c.eps);
+            try d.project(&k.glue, s, a.x, l.gate_up, a.matrix_rows, block, 2 * inter, h);
+            try dsp.silu(&d.k, s, a.matrix_rows, a.act, block, inter);
+            const next = if (i + 1 < d.w.layers.len) d.w.layers[i + 1].input_norm else d.w.norm;
+            try d.residual(k, s, a.act, next, l.down, inter, c.eps);
+        }
+        if (d.w.base) |w|
+            try d.lane.?.matmul(s, a.x + h * 2, h, n, w, a.base, 0)
+        else
+            try d.project(&k.glue, s, a.x + h * 2, .{ .data = m.w.unembed }, a.base, n, w_.vocab, h);
+        try dsp.ctx(&d.k, s, a.x + h * 2, session.newest, d.w.rnn, d.w.rnn_bias, a.kappa, n, h, rank);
+    }
+
+    pub fn propose(d: *Drafter, session: *Session, m: *const engine.Model, k: *const engine.Kernels, s: cuda.Stream, pending: u32, n: usize, rule: ?u64) !void {
+        if (n == 0 or n > depth or session.end == 0) return error.BadDraftDepth;
+        const c = m.w.c.text;
+        const a = d.scratch;
+        const drv = d.memory.d;
+        try cuda.copy_source.enqueue(drv, a.walk, std.mem.asBytes(&pending), s);
+        try drv.check(drv.api.cuMemsetD8Async(a.state, 0, rank * 2, s.handle), "cuMemsetD8Async");
+        if (rule != null) {
+            var meta: [depth][4]i32 = @splat(@splat(0));
+            for (&meta, 0..) |*row, i| row[0] = @intCast(session.end + i);
+            try cuda.copy_source.enqueue(drv, a.draw, std.mem.sliceAsBytes(meta[0..n]), s);
+        }
+        try d.encode(session, m, k, s, n);
+        const stride = if (d.w.base) |w| w.n else w_.vocab;
+        for (0..n) |j| {
+            const token = a.walk + (j + 1) * 4;
+            const base = a.base + j * stride * 2;
+            try dsp.rnn(&d.k, s, a.kappa + j * 3 * rank * 4, d.w.rnn, d.w.markov_w1, a.walk, j, a.state, a.latent, rank, h);
+            if (d.vocab8) |f|
+                try dsp.vocab8(f, s, base, a.latent, d.w.phi, d.w.beta, c.logit_cap, c.unpadded_vocab, c.unpadded_vocab, a.f32_rows)
+            else
+                try dsp.vocab(&d.k, s, base, a.latent, d.w.phi.data, d.w.beta, c.logit_cap, c.unpadded_vocab, c.unpadded_vocab, a.f32_rows);
+            if (rule) |r| {
+                try ops.tobf(&k.glue, s, a.f32_rows, 1, c.unpadded_vocab, c.unpadded_vocab, base, c.unpadded_vocab, 0, c.unpadded_vocab);
+                try k.draws.draw(s, base, c.unpadded_vocab, r, a.draw + j * 16, 0, token, 1, null, null);
+            } else {
+                try ops.top1(&k.glue, s, a.f32_rows, 1, c.unpadded_vocab, c.unpadded_vocab, 0, a.out, token);
+            }
+        }
+        try s.synchronize();
+        try d.memory.download(@intCast(a.walk - d.memory.ptr + 4), std.mem.sliceAsBytes(session.held[0..n]));
+        for (session.held[0..n]) |t| if (t >= c.unpadded_vocab) return error.DraftNonfinite;
+        session.held_len = n;
+    }
+};
diff --git a/zig/src/families/inkling2/dspark_ops.zig b/zig/src/families/inkling2/dspark_ops.zig
new file mode 100644
index 0000000..1ab9a55
--- /dev/null
+++ b/zig/src/families/inkling2/dspark_ops.zig
@@ -0,0 +1,269 @@
+//! The DSpark drafter's kernels (inkling2/dspark.cu): tap mix, norms, q/k prep, block attention, the Markov head.
+const std = @import("std");
+const cuda = @import("cuda");
+const fp8 = @import("draft_fp8.zig");
+
+/// Keys a block attention chunk covers (absolute positions, so a row's bits never depend on the call).
+pub const chunk = 1024;
+/// Query rows x query heads of one key head a block attention call holds at most (dspark.cu's kMaxQ).
+pub const max_q = 48;
+/// The Markov rank the head's kernels hold (dspark.cu's 256-wide fold rows and rnn's shared rows).
+pub const rank = 256;
+/// The attention head width dspark.cu's kD fixes.
+pub const head_dim = 128;
+/// Rows a block drafts at most (dspark.cu's kMaxRows).
+pub const max_rows = 8;
+
+/// A draft head these kernels would run wrong is refused: any other Markov rank or head_dim, or a longer block.
+pub fn checkHead(markov_rank: usize, dim: usize, block: usize) !void {
+    if (markov_rank != rank or dim != head_dim or block == 0 or block > max_rows) return error.Inkling2DraftShape;
+}
+
+/// dspark.cu's QkArgs, field for field.
+pub const QkArgs = extern struct {
+    x: u64,
+    qw: u64,
+    kw: u64,
+    q: u64,
+    kc: u64,
+    vc: u64,
+    ld: i64,
+    hq: i32,
+    hk: i32,
+    ring: i32,
+    pos0: i32,
+    eps: f32,
+    theta: f32,
+};
+
+/// dspark.cu's AttnArgs, field for field.
+pub const AttnArgs = extern struct {
+    q: u64,
+    kc: u64,
+    vc: u64,
+    po: u64,
+    pml: u64,
+    T: i32,
+    hq: i32,
+    hk: i32,
+    ring: i32,
+    lo: i32,
+    hi: i32,
+    c0: i32,
+    scale: f32,
+};
+
+pub const Kernels = struct {
+    mod: cuda.Module,
+    /// act_rows: the SiLU is core's tf_swiglu_rows in torch's form
+    rows: cuda.Module,
+    tap: cuda.Function,
+    mix: cuda.Function,
+    addnorm: cuda.Function,
+    qk: cuda.Function,
+    attn: cuda.Function,
+    merge: cuda.Function,
+    silu: cuda.Function,
+    ctx: cuda.Function,
+    rnn: cuda.Function,
+    vocab: cuda.Function,
+    pick: cuda.Function,
+
+    pub fn load(d: *const cuda.Driver) !Kernels {
+        if (!cuda.kernels.available) return error.BuiltWithoutKernels;
+        var mod = try cuda.Module.load(d, cuda.kernels.inkling2_dspark);
+        errdefer mod.unload();
+        var rows = try cuda.Module.load(d, cuda.kernels.act_rows);
+        errdefer rows.unload();
+        return .{
+            .mod = mod,
+            .rows = rows,
+            .tap = try mod.function("tf_ink2_dsp_tap"),
+            .mix = try mod.function("tf_ink2_dsp_mix"),
+            .addnorm = try mod.function("tf_ink2_dsp_addnorm"),
+            .qk = try mod.function("tf_ink2_dsp_qk"),
+            .attn = try mod.function("tf_ink2_dsp_attn"),
+            .merge = try mod.function("tf_ink2_dsp_merge"),
+            .silu = try rows.function("tf_swiglu_rows_expf"),
+            .ctx = try mod.function("tf_ink2_dsp_ctx"),
+            .rnn = try mod.function("tf_ink2_dsp_rnn"),
+            .vocab = try mod.function("tf_ink2_dsp_vocab"),
+            .pick = try mod.function("tf_ink2_dsp_pick_merge"),
+        };
+    }
+
+    pub fn unload(k: *Kernels) void {
+        k.rows.unload();
+        k.mod.unload();
+        k.* = undefined;
+    }
+};
+
+fn int(x: anytype) i32 {
+    return @intCast(x);
+}
+
+fn go(f: cuda.Function, s: cuda.Stream, grid: cuda.Dim3, threads: u32, a: *cuda.Args) !void {
+    try cuda.launch.launch(f, .{ .grid = grid, .block = .{ .x = threads } }, s, a);
+}
+
+/// Copy one target feature plane into its interleaved channel.
+pub fn tap(f: cuda.Function, s: cuda.Stream, x: u64, taps: u64, rows: usize, c: usize, channel: usize) !void {
+    var a: cuda.Args = .{};
+    a.add(x);
+    a.add(taps);
+    a.add(int(rows * c));
+    a.add(int(c));
+    a.add(int(channel));
+    try go(f, s, .{ .x = @intCast((rows * c + 255) / 256) }, 256, &a);
+}
+
+/// out bf16 [rows][c] = RMSNorm(alpha . taps[row]) * w; taps bf16 [rows][n][c], alpha fp32 [n].
+pub fn mix(k: *const Kernels, s: cuda.Stream, taps: u64, alpha: u64, w: u64, out: u64, rows: usize, n: usize, c: usize, eps: f32) !void {
+    var a: cuda.Args = .{};
+    for ([_]u64{ taps, alpha, w, out }) |v| a.add(v);
+    a.add(int(n));
+    a.add(int(c));
+    a.add(eps);
+    try go(k.mix, s, .{ .x = @intCast(rows) }, 512, &a);
+}
+
+/// resid += `nparts` fp32 partials (`stride` elements apart, rank order); out = RMSNorm(resid) * w, both bf16.
+pub fn addNorm(k: *const Kernels, s: cuda.Stream, resid: u64, parts: u64, nparts: usize, stride: usize, w: u64, out: u64, rows: usize, c: usize, eps: f32) !void {
+    var a: cuda.Args = .{};
+    a.add(resid);
+    a.add(parts);
+    a.add(int(nparts));
+    a.add(@as(i64, @intCast(stride)));
+    a.add(w);
+    a.add(out);
+    a.add(int(c));
+    a.add(eps);
+    try go(k.addnorm, s, .{ .x = @intCast(rows) }, 512, &a);
+}
+
+pub fn qk(k: *const Kernels, s: cuda.Stream, q: QkArgs, rows: usize) !void {
+    if (q.hq < 0 or q.hk <= 0 or q.ring <= 0 or q.ld < (q.hq + 2 * q.hk) * head_dim) return error.Inkling2DraftShape;
+    var a: cuda.Args = .{};
+    a.add(q);
+    try go(k.qk, s, .{ .x = @intCast(rows), .y = @intCast(q.hq + q.hk) }, 64, &a);
+}
+
+/// Chunks a block's keys [lo, hi] span.
+pub fn chunks(lo: usize, hi: usize) usize {
+    return hi / chunk - lo / chunk + 1;
+}
+
+/// Block attention over keys [a.lo, a.hi], then the chunks merged into `out` bf16 [T][hq][128].
+pub fn attend(k: *const Kernels, s: cuda.Stream, at: AttnArgs, out: u64) !void {
+    const lo: usize = @intCast(at.lo);
+    const hi: usize = @intCast(at.hi);
+    if (lo > hi or at.T * @divExact(at.hq, at.hk) > max_q) return error.Inkling2DraftShape;
+    if (at.ring <= 0 or hi - lo >= @as(usize, @intCast(at.ring))) return error.Inkling2DraftShape; // keys would alias
+    var x = at;
+    x.c0 = int(lo / chunk);
+    const n = chunks(lo, hi);
+    var a: cuda.Args = .{};
+    a.add(x);
+    try go(k.attn, s, .{ .x = @intCast(n), .y = @intCast(at.hk) }, 256, &a);
+    var m: cuda.Args = .{};
+    m.add(at.po);
+    m.add(at.pml);
+    m.add(int(n));
+    m.add(at.T * at.hq);
+    m.add(out);
+    try go(k.merge, s, .{ .x = @intCast(at.T * at.hq) }, 128, &m);
+}
+
+/// gu bf16 [rows][2 * inter] (gates, then ups) to bf16(silu(gate) * up) by core's tf_swiglu_rows_expf.
+pub fn silu(k: *const Kernels, s: cuda.Stream, gu: u64, out: u64, rows: usize, inter: usize) !void {
+    if (inter % 64 != 0) return error.Inkling2DraftShape;
+    var a: cuda.Args = .{};
+    a.add(gu);
+    a.add(@as(i64, @intCast(2 * inter)));
+    a.add(gu + 2 * inter);
+    a.add(@as(i64, @intCast(2 * inter)));
+    a.add(out);
+    a.add(@as(u64, 0));
+    a.add(int(inter));
+    try go(k.silu, s, .{ .x = @intCast(rows), .y = @intCast((inter / 8 + 255) / 256) }, 256, &a);
+}
+
+/// The Markov head's context rows: fp32 [rows][3r] from the hidden rows and f_rnn.
+pub fn ctx(k: *const Kernels, s: cuda.Stream, hidden: u64, frnn: u64, w: u64, bias: u64, out: u64, rows: usize, c: usize, r: usize) !void {
+    if (rows > max_rows or r != rank) return error.Inkling2DraftShape;
+    var a: cuda.Args = .{};
+    for ([_]u64{ hidden, frnn, w, bias, out }) |v| a.add(v);
+    for ([_]i32{ int(rows), int(c), int(r) }) |v| a.add(v);
+    try go(k.ctx, s, .{ .x = @intCast((3 * r + 7) / 8) }, 256, &a);
+}
+
+/// One recurrence step from walk[j]: the state in place and the step's latent.
+pub fn rnn(k: *const Kernels, s: cuda.Stream, cx: u64, w: u64, w1: u64, walk: u64, j: usize, state: u64, latent: u64, r: usize, c: usize) !void {
+    if (r != rank) return error.Inkling2DraftShape;
+    var a: cuda.Args = .{};
+    for ([_]u64{ cx, w, w1, walk }) |v| a.add(v);
+    a.add(int(j));
+    a.add(state);
+    a.add(latent);
+    a.add(int(r));
+    a.add(int(c));
+    try go(k.rnn, s, .{ .x = 1 }, @intCast(r), &a);
+}
+
+pub fn vocab(k: *const Kernels, s: cuda.Stream, base: u64, latent: u64, fold: u64, fbias: u64, cap: f32, valid: usize, nv: usize, out: u64) !void {
+    var a: cuda.Args = .{};
+    for ([_]u64{ base, latent, fold, fbias }) |v| a.add(v);
+    a.add(cap);
+    a.add(int(valid));
+    a.add(int(nv));
+    a.add(out);
+    try go(k.vocab, s, .{ .x = @intCast((nv + 7) / 8) }, 256, &a);
+}
+
+pub fn vocab8(f: cuda.Function, s: cuda.Stream, base: u64, latent: u64, fold: fp8.Table, fbias: u64, cap: f32, valid: usize, nv: usize, out: u64) !void {
+    var a: cuda.Args = .{};
+    for ([_]u64{ base, latent, fold.data, fold.scales, fbias }) |v| a.add(v);
+    a.add(cap);
+    a.add(int(valid));
+    a.add(int(nv));
+    a.add(out);
+    try go(f, s, .{ .x = @intCast((nv + 7) / 8) }, 256, &a);
+}
+
+/// Every rank's (value, id), 16 bytes a rank, into walk[j + 1]: one warp, as MiniMax M3 launches the shared merge.
+pub fn pick(k: *const Kernels, s: cuda.Stream, picks: u64, world: usize, walk: u64, j: usize) !void {
+    var a: cuda.Args = .{};
+    a.add(picks);
+    a.add(int(world));
+    a.add(int(16));
+    a.add(walk);
+    a.add(int(j));
+    try go(k.pick, s, .{ .x = 1 }, 32, &a);
+}
+
+test "dspark ops: argument structs keep dspark.cu's layouts; chunks by absolute position" {
+    try std.testing.expectEqual(@as(usize, 6 * 8 + 8 + 4 * 4 + 2 * 4), @sizeOf(QkArgs));
+    try std.testing.expectEqual(@as(usize, 5 * 8 + 8 * 4), @sizeOf(AttnArgs));
+    try std.testing.expectEqual(@as(usize, 1), chunks(0, 1023));
+    try std.testing.expectEqual(@as(usize, 2), chunks(1000, 1030));
+}
+
+test "dspark ops: a head, a block or a ring the kernels would run wrong is refused before a launch" {
+    const no = error.Inkling2DraftShape;
+    try checkHead(256, 128, 8);
+    try std.testing.expectError(no, checkHead(8, 128, 8)); // tiny-random's rank
+    try std.testing.expectError(no, checkHead(512, 128, 8));
+    try std.testing.expectError(no, checkHead(256, 64, 8));
+    try std.testing.expectError(no, checkHead(256, 128, 9));
+    const k: Kernels = undefined;
+    const s: cuda.Stream = undefined;
+    try std.testing.expectError(no, silu(&k, s, 0, 0, 8, 4600)); // not a multiple of 64 columns
+    try std.testing.expectError(no, rnn(&k, s, 0, 0, 0, 0, 0, 0, 0, 512, 4608));
+    try std.testing.expectError(no, ctx(&k, s, 0, 0, 0, 0, 0, 8, 4608, 128));
+    try std.testing.expectError(no, ctx(&k, s, 0, 0, 0, 0, 0, 9, 4608, 256));
+    const q: QkArgs = .{ .x = 0, .qw = 0, .kw = 0, .q = 0, .kc = 0, .vc = 0, .ld = 32 * 64, .hq = 24, .hk = 4, .ring = 4096, .pos0 = 0, .eps = 1e-6, .theta = 1e6 };
+    try std.testing.expectError(no, qk(&k, s, q, 8)); // 64-wide heads
+    const at: AttnArgs = .{ .q = 0, .kc = 0, .vc = 0, .po = 0, .pml = 0, .T = 8, .hq = 24, .hk = 4, .ring = 4096, .lo = 0, .hi = 4096, .c0 = 0, .scale = 1 };
+    try std.testing.expectError(no, attend(&k, s, at, 0)); // 4,097 keys in a 4,096-row ring
+}
