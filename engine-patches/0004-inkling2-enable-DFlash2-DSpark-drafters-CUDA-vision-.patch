+                const layout = try loop.CacheLayout.init(&ck.text, &ck.schedule, context, format, loop.promptRows(false));
+                var m: engine.Model = .{ .gpa = a, .d = d, .w = &w, .context = context, .layout = layout };
+                defer m.deinit();
