diff --git a/zig/kernels/cuda/common/dspark_pick.cuh b/zig/kernels/cuda/common/dspark_pick.cuh
new file mode 100644
index 0000000..fa9cf66
--- /dev/null
+++ b/zig/kernels/cuda/common/dspark_pick.cuh
@@ -0,0 +1,26 @@
+// DSpark's pick merge, one body for every family: the ranks' gathered (value, id) picks to the walk's next token.
+#pragma once
+
+#include <math_constants.h>
+
+namespace tf_common {
+
+// Thread 0, picks stride bytes apart: the largest value, the lower id on a tie, kNone when none beats -Inf.
+template <int kNone>
+__device__ __forceinline__ void dspark_pick(const unsigned char* __restrict__ picks, int world, int stride,
+                                            int* __restrict__ walk, int j) {
+  if (threadIdx.x != 0) return;
+  float best = -CUDART_INF_F;
+  int id = kNone;
+  for (int q = 0; q < world; ++q) {
+    const float v = *reinterpret_cast<const float*>(picks + (size_t)q * stride);
+    const int k = *reinterpret_cast<const int*>(picks + (size_t)q * stride + 4);
+    if (v > best || (v == best && k < id)) {
+      best = v;
+      id = k;
+    }
+  }
+  walk[j + 1] = id;
+}
+
+}  // namespace tf_common
diff --git a/zig/kernels/cuda/inkling2/dflash2.cuh b/zig/kernels/cuda/inkling2/dflash2.cuh
new file mode 100644
index 0000000..2385277
--- /dev/null
+++ b/zig/kernels/cuda/inkling2/dflash2.cuh
@@ -0,0 +1,97 @@
+// Mini DFlash2 additions to the shared draft attention and BF16 operators.
+namespace ink2df {
+constexpr int kTop = 16;
+constexpr int kRank = 256;
+constexpr int kLogprobTop = 20;
+constexpr int kLogprobWords = 3 + 2 * kLogprobTop;
+}
+
+extern "C" __global__ void __launch_bounds__(64) tf_ink2_df_qk(QkArgs a, const int* position) {
+    __shared__ float sh[32];
+    ink2DraftQk(a, *position, sh);
+}
+
+extern "C" __global__ void __launch_bounds__(256) tf_ink2_df_attn(AttnArgs a, const int* position, int window) {
+    ink2DraftAttn<true>(a, *position, window);
+}
+
+// Each row's coefficients are shared by groups of 16 channels. The prior row stays inside this block.
+extern "C" __global__ void __launch_bounds__(256) tf_ink2_df_conv(
+    const uint16_t* __restrict__ x, const uint16_t* __restrict__ dyn, const uint16_t* __restrict__ base,
+    uint16_t* __restrict__ out, int width, int side) {
+    using namespace ink2d;
+    const int row = blockIdx.x, groups = width / 16;
+    const uint16_t* delta = dyn + (4 * row + 2 * side) * groups;
+    const uint16_t* kernel = base + 2 * side * width;
+    for (int c = threadIdx.x; c < width; c += blockDim.x) {
+        float sum = (bf(kernel[c]) + bf(delta[c / 16])) * bf(x[row * width + c]);
+        if (row > 0)
+            sum += (bf(kernel[width + c]) + bf(delta[groups + c / 16])) * bf(x[(row - 1) * width + c]);
+        const int at = row * width + c;
+        out[at] = side == 0 ? tobf(sum) : tobf(bf(out[at]) + bfr(sum));
+    }
+}
+
+// Score just the current predecessor's edges. A warp evaluates one of the top-16 candidates.
+template <typename Book>
+__device__ __forceinline__ void ink2DfSelect(
+    const unsigned* __restrict__ top, const uint16_t* __restrict__ projected,
+    const Book* __restrict__ predecessor, const Book* __restrict__ successor,
+    const float* __restrict__ prev_scales, const float* __restrict__ next_scales,
+    unsigned* __restrict__ walk, long long* __restrict__ ids, uint16_t* __restrict__ logits,
+    int step, int vocab, float cap) {
+    using namespace ink2d;
+    using namespace ink2df;
+    __shared__ float scores[kTop];
+    const int candidate = threadIdx.x >> 5, lane = threadIdx.x & 31;
+    const unsigned* entries = top + step * kLogprobWords;
+    const unsigned id = entries[2 + candidate];
+    const unsigned parent = walk[step];
+    float score = -INFINITY;
+    if (id < vocab && parent < vocab) {
+        float correction = 0;
+        const float ps = sizeof(Book) == 1 ? prev_scales[parent] : 1.0f;
+        const float ss = sizeof(Book) == 1 ? next_scales[id] : 1.0f;
+        for (int j = lane; j < kRank; j += 32) {
+            const Book a = predecessor[static_cast<size_t>(parent) * kRank + j];
+            const Book b = successor[static_cast<size_t>(id) * kRank + j];
+            const float p = sizeof(Book) == 1 ? bfr(fp8Value(a) * ps) : bf(a);
+            const float q = sizeof(Book) == 1 ? bfr(fp8Value(b) * ss) : bf(b);
+            const float h = bf(projected[step * kRank + j]);
+            correction += bfr(p * h) * q;
+        }
+        correction = tf_common::warp_sum(correction);
+        const float unary = __uint_as_float(entries[2 + kLogprobTop + candidate]);
+        const float corrected = bfr(unary + bfr(correction));
+        score = bfr(cap * tanhf(corrected / cap));
+    }
+    if (lane == 0) {
+        scores[candidate] = score;
+        ids[candidate] = id;
+        logits[candidate] = tobf(score);
+    }
+    __syncthreads();
+    if (threadIdx.x == 0) {
+        int best = 0;
+        for (int i = 1; i < kTop; ++i)
+            if (scores[i] > scores[best]) best = i;
+        walk[step + 1] = isfinite(scores[best]) ? static_cast<unsigned>(ids[best]) : static_cast<unsigned>(vocab);
+    }
+}
+
+extern "C" __global__ void __launch_bounds__(512) tf_ink2_df_select(
+    const unsigned* __restrict__ top, const uint16_t* __restrict__ projected,
+    const uint16_t* __restrict__ predecessor, const uint16_t* __restrict__ successor,
+    unsigned* __restrict__ walk, long long* __restrict__ ids, uint16_t* __restrict__ logits,
+    int step, int vocab, float cap) {
+    ink2DfSelect(top, projected, predecessor, successor, nullptr, nullptr, walk, ids, logits, step, vocab, cap);
+}
+
+extern "C" __global__ void __launch_bounds__(512) tf_ink2_df_select8(
+    const unsigned* __restrict__ top, const uint16_t* __restrict__ projected,
+    const uint8_t* __restrict__ predecessor, const uint8_t* __restrict__ successor,
+    const float* __restrict__ prev_scales, const float* __restrict__ next_scales,
+    unsigned* __restrict__ walk, long long* __restrict__ ids, uint16_t* __restrict__ logits,
+    int step, int vocab, float cap) {
+    ink2DfSelect(top, projected, predecessor, successor, prev_scales, next_scales, walk, ids, logits, step, vocab, cap);
+}
diff --git a/zig/kernels/cuda/inkling2/draft_fp8.cuh b/zig/kernels/cuda/inkling2/draft_fp8.cuh
new file mode 100644
index 0000000..2063811
--- /dev/null
+++ b/zig/kernels/cuda/inkling2/draft_fp8.cuh
@@ -0,0 +1,76 @@
+// Copyright 2026 MiaAI-Lab, draft-only FP8 head design adapted from patch 0006.
+
+#include <cuda_fp16.h>
+#include <cuda_fp8.h>
+
+namespace ink2d {
+__device__ __forceinline__ float fp8Value(uint8_t code) {
+    return __half2float(__half(__nv_cvt_fp8_to_halfraw(code, __NV_E4M3)));
+}
+
+__device__ __forceinline__ float fp8Scale(float max_abs) {
+    for (int delta = 16; delta > 0; delta >>= 1)
+        max_abs = fmaxf(max_abs, __shfl_xor_sync(0xffffffffu, max_abs, delta));
+    return max_abs == 0.0f || !isfinite(max_abs) ? 1.0f : fmaxf(max_abs / 448.0f, 0x1p-126f);
+}
+
+__device__ __forceinline__ uint8_t fp8Code(float value, float scale) {
+    return __nv_cvt_float_to_fp8(value / scale, __NV_SATFINITE, __NV_E4M3);
+}
+}  // namespace ink2d
+
+// A warp packs one row of a 64x64 qmmf FP8G tile, including its FP32 scale.
+extern "C" __global__ void __launch_bounds__(256) tf_ink2_draft_pack_layers(
+    const uint16_t* __restrict__ src, uint8_t* __restrict__ out, float* __restrict__ scales, int n, int k) {
+    using namespace ink2d;
+    const int lane = threadIdx.x & 31;
+    const size_t item = static_cast<size_t>(blockIdx.x) * 8 + (threadIdx.x >> 5);
+    const int groups = k / 64;
+    const size_t tile = item / 64;
+    const int rr = item % 64;
+    const int r = (tile / groups) * 64 + rr;
+    if (r >= (n + 127) / 128 * 128) return;
+    const size_t at = static_cast<size_t>(r) * k + tile % groups * 64 + lane;
+    const float lo = r < n ? bf(src[at]) : 0.0f;
+    const float hi = r < n ? bf(src[at + 32]) : 0.0f;
+    const float scale = fp8Scale(fmaxf(fabsf(lo), fabsf(hi)));
+    // Inverse of modelopt_pack.cu's FP8 fragment mapping.
+    const int p_lane = (rr % 8) * 4 + (lane % 8) / 2;
+    const int b = (lane / 16) * 4 + (lane & 1) + ((lane / 8) & 1) * 2;
+    const size_t dst = ((tile * 8 + rr / 8) * 32 + p_lane) * 16 + b;
+    out[dst] = fp8Code(lo, scale);
+    out[dst + 8] = fp8Code(hi, scale);
+    if (lane == 0) scales[item] = scale;
+}
+
+// Rank-256 selector or Markov rows stay row-major, with one FP32 scale per row.
+extern "C" __global__ void __launch_bounds__(256) tf_ink2_draft_pack_rows(
+    const uint16_t* __restrict__ src, uint8_t* __restrict__ out, float* __restrict__ scales, int n, int k) {
+    using namespace ink2d;
+    const int lane = threadIdx.x & 31;
+    const int row = blockIdx.x * 8 + (threadIdx.x >> 5);
+    if (row >= n) return;
+    const size_t offset = static_cast<size_t>(row) * k;
+    float max_abs = 0.0f;
+    for (int j = lane; j < k; j += 32) max_abs = fmaxf(max_abs, fabsf(bf(src[offset + j])));
+    const float scale = fp8Scale(max_abs);
+    for (int j = lane; j < k; j += 32) out[offset + j] = fp8Code(bf(src[offset + j]), scale);
+    if (lane == 0) scales[row] = scale;
+}
+
+extern "C" __global__ void __launch_bounds__(256) tf_ink2_dsp_vocab8(
+    const uint16_t* __restrict__ base, const uint16_t* __restrict__ latent, const uint8_t* __restrict__ fold,
+    const float* __restrict__ scales, const uint16_t* __restrict__ fbias, float cap, int valid, int nv,
+    float* __restrict__ out) {
+    using namespace ink2d;
+    const int v = blockIdx.x * 8 + (threadIdx.x >> 5), lane = threadIdx.x & 31;
+    if (v >= nv) return;
+    const uint8_t* f = fold + static_cast<size_t>(v) * 256;
+    float sum = 0.0f;
+    for (int k = lane; k < 256; k += 32) sum += bf(latent[k]) * fp8Value(f[k]);
+    const float dot = tf_common::warp_sum(sum) * scales[v];
+    if (lane != 0) return;
+    const float b = bfr(dot + bf(fbias[v]));
+    const float x = bfr(bf(base[v]) + b);
+    out[v] = v < valid ? bfr(tanhf(x / cap) * cap) : -INFINITY;
+}
diff --git a/zig/kernels/cuda/inkling2/dspark.cu b/zig/kernels/cuda/inkling2/dspark.cu
new file mode 100644
index 0000000..0a22b3a
--- /dev/null
+++ b/zig/kernels/cuda/inkling2/dspark.cu
@@ -0,0 +1,331 @@
+// Inkling 2's DSpark drafter: tap mix, q/k norm + RoPE into the draft caches, block attention, the Markov head.
+#include <cstdint>
+#include <cuda_bf16.h>
+
+#include "common/dspark_pick.cuh"
+#include "common/reduce.cuh"
+
+namespace ink2d {
+
+constexpr int kD = 128;
+constexpr int kMaxQ = 48;
+constexpr int kKT = 32;
+constexpr int kChunk = 1024;
+constexpr int kMaxRows = 8;
+
+__device__ __forceinline__ float bf(uint16_t u) { return __uint_as_float(static_cast<uint32_t>(u) << 16); }
+
+__device__ __forceinline__ uint16_t tobf(float f) { return __bfloat16_as_ushort(__float2bfloat16_rn(f)); }
+
+__device__ __forceinline__ float bfr(float f) { return bf(tobf(f)); }
+
+// One sum over the block in a fixed order: warp shuffles, then warp 0 over the warps' partials.
+__device__ __forceinline__ float blockSum(float v, float* sh) {
+    const int lane = threadIdx.x & 31, w = threadIdx.x >> 5, nw = blockDim.x >> 5;
+    v = tf_common::warp_sum(v);
+    __syncthreads();
+    if (lane == 0) sh[w] = v;
+    __syncthreads();
+    const float t = lane < nw ? sh[lane] : 0.0f;
+    return __shfl_sync(0xffffffffu, tf_common::warp_sum(t), 0);
+}
+
+}  // namespace ink2d
+
+// out[row] = RMSNorm(sum_t alpha[t] * taps[row][t]) * w, the mix in fp32 in tap order (vLLM's mix_rmsnorm).
+extern "C" __global__ void __launch_bounds__(512) tf_ink2_dsp_mix(const uint16_t* __restrict__ taps, const float* __restrict__ alpha,
+                                                                  const uint16_t* __restrict__ w, uint16_t* __restrict__ out,
+                                                                  int taps_n, int C, float eps) {
+    using namespace ink2d;
+    __shared__ float sh[32];
+    const size_t row = blockIdx.x;
+    const uint16_t* x = taps + row * taps_n * C;
+    float ss = 0.0f;
+    for (int c = threadIdx.x; c < C; c += blockDim.x) {
+        float m = 0.0f;
+        for (int t = 0; t < taps_n; ++t) m += bf(x[t * C + c]) * alpha[t];
+        ss += m * m;
+    }
+    const float r = rsqrtf(blockSum(ss, sh) / C + eps);
+    for (int c = threadIdx.x; c < C; c += blockDim.x) {
+        float m = 0.0f;
+        for (int t = 0; t < taps_n; ++t) m += bf(x[t * C + c]) * alpha[t];
+        out[row * C + c] = tobf(m * r * bf(w[c]));
+    }
+}
+
+// Unlike core's add-norms: resid stays bf16 (+= fp32 partials in rank order); out = RMSNorm of the unrounded sum * w.
+extern "C" __global__ void __launch_bounds__(512) tf_ink2_dsp_addnorm(uint16_t* __restrict__ resid, const float* __restrict__ parts,
+                                                                      int nparts, long long part_stride, const uint16_t* __restrict__ w,
+                                                                      uint16_t* __restrict__ out, int C, float eps) {
+    using namespace ink2d;
+    __shared__ float sh[32];
+    const size_t row = blockIdx.x;
+    float ss = 0.0f;
+    for (int c = threadIdx.x; c < C; c += blockDim.x) {
+        float s = 0.0f;
+        for (int p = 0; p < nparts; ++p) s += parts[p * part_stride + row * C + c];
+        const float v = bf(resid[row * C + c]) + s;
+        ss += v * v;
+    }
+    const float r = rsqrtf(blockSum(ss, sh) / C + eps);
+    for (int c = threadIdx.x; c < C; c += blockDim.x) {
+        float s = 0.0f;
+        for (int p = 0; p < nparts; ++p) s += parts[p * part_stride + row * C + c];
+        const float v = bf(resid[row * C + c]) + s;
+        if (nparts > 0) resid[row * C + c] = tobf(v);
+        out[row * C + c] = tobf(v * r * bf(w[c]));
+    }
+}
+
+struct QkArgs {
+    const uint16_t* x;  // bf16 [rows][ld]: q heads, then key heads, then value heads (128 wide each)
+    const uint16_t* qw;
+    const uint16_t* kw;
+    uint16_t* q;   // bf16 [rows][hq][128]
+    uint16_t* kc;  // bf16 [ring][hk][128]
+    uint16_t* vc;
+    long long ld;
+    int hq, hk, ring, pos0;
+    float eps, theta;
+};
+
+// Per (row, head): RMSNorm * weight rounded to bf16, then neox RoPE at pos0 + row; key and value heads to the caches.
+__device__ __forceinline__ void ink2DraftQk(QkArgs a, int pos0, float* sh) {
+    using namespace ink2d;
+    const int row = blockIdx.x, h = blockIdx.y, i = threadIdx.x;
+    const bool isq = h < a.hq;
+    const uint16_t* x = a.x + row * a.ld + static_cast<long long>(h) * kD;
+    const float x0 = bf(x[i]), x1 = bf(x[i + 64]);
+    const float inv = 1.0f / sqrtf(blockSum(x0 * x0 + x1 * x1, sh) / kD + a.eps);
+    const uint16_t* w = isq ? a.qw : a.kw;
+    const float y0 = bfr(x0 * inv * bf(w[i])), y1 = bfr(x1 * inv * bf(w[i + 64]));
+    const int pos = pos0 + row;
+    const float f = static_cast<float>(pos) * (1.0f / powf(a.theta, static_cast<float>(2 * i) / kD));
+    const float co = cosf(f), si = sinf(f);
+    const uint16_t o0 = tobf(y0 * co - y1 * si), o1 = tobf(y1 * co + y0 * si);
+    if (isq) {
+        uint16_t* q = a.q + (static_cast<size_t>(row) * a.hq + h) * kD;
+        q[i] = o0;
+        q[i + 64] = o1;
+        return;
+    }
+    const int j = h - a.hq;
+    const size_t at = (static_cast<size_t>(pos % a.ring) * a.hk + j) * kD;
+    a.kc[at + i] = o0;
+    a.kc[at + i + 64] = o1;
+    const uint16_t* v = a.x + row * a.ld + static_cast<long long>(a.hq + a.hk + j) * kD;
+    a.vc[at + i] = v[i];
+    a.vc[at + i + 64] = v[i + 64];
+}
+
+extern "C" __global__ void __launch_bounds__(64) tf_ink2_dsp_qk(QkArgs a) {
+    __shared__ float sh[32];
+    ink2DraftQk(a, a.pos0, sh);
+}
+
+struct AttnArgs {
+    const uint16_t* q;  // bf16 [T][hq][128]
+    const uint16_t* kc;  // bf16 [ring][hk][128]
+    const uint16_t* vc;
+    float* po;   // fp32 [chunks][T * hq][128]: unnormalised sums
+    float* pml;  // fp32 [chunks][T * hq][2]: max, total
+    int T, hq, hk, ring, lo, hi, c0;
+    float scale;
+};
+
+// A block's rows against keys [lo, hi], unmasked (the block sees itself whole); a 1,024-key chunk and key head a block.
+template<bool sliding>
+__device__ __forceinline__ void ink2DraftAttn(AttnArgs a, int pos0, int window) {
+    using namespace ink2d;
+    __shared__ float sq[kMaxQ][kD];
+    __shared__ uint16_t sk[kKT][kD + 8];
+    __shared__ uint16_t sv[kKT][kD];
+    __shared__ float sp[kMaxQ][kKT];
+    __shared__ float sm[kMaxQ], sl[kMaxQ], sa[kMaxQ];
+    if constexpr (sliding) {
+        a.lo = max(0, pos0 - window + 1);
+        a.hi = pos0 + a.T - 1;
+        a.c0 = a.lo / kChunk;
+    }
+    const int j = blockIdx.y, c = a.c0 + blockIdx.x, tid = threadIdx.x;
+    const int g = a.hq / a.hk, nq = a.T * g, nqt = a.T * a.hq;
+    const int k0 = max(a.lo, c * kChunk), k1 = min(a.hi + 1, (c + 1) * kChunk);
+    for (int idx = tid; idx < nq * kD; idx += blockDim.x) {
+        const int qi = idx / kD, d = idx % kD;
+        sq[qi][d] = bf(a.q[(static_cast<size_t>(qi / g) * a.hq + j * g + qi % g) * kD + d]);
+    }
+    for (int qi = tid; qi < nq; qi += blockDim.x) {
+        sm[qi] = -INFINITY;
+        sl[qi] = 0.0f;
+    }
+    const int d = tid & (kD - 1), half = tid >> 7;
+    float o[kMaxQ / 2];
+    for (int r = 0; r < kMaxQ / 2; ++r) o[r] = 0.0f;
+    __syncthreads();
+    for (int kt = k0; kt < k1; kt += kKT) {
+        const int nk = min(kKT, k1 - kt);
+        for (int idx = tid; idx < nk * kD; idx += blockDim.x) {
+            const int kk = idx / kD, dd = idx % kD;
+            const size_t at = (static_cast<size_t>((kt + kk) % a.ring) * a.hk + j) * kD + dd;
+            sk[kk][dd] = a.kc[at];
+            sv[kk][dd] = a.vc[at];
+        }
+        __syncthreads();
+        for (int idx = tid; idx < nq * kKT; idx += blockDim.x) {
+            const int qi = idx / kKT, kk = idx % kKT;
+            float s = -INFINITY;
+            const int key = kt + kk;
+            if (kk < nk && (!sliding || key >= pos0 || key > pos0 + qi / g - window)) {
+                s = 0.0f;
+                for (int dd = 0; dd < kD; ++dd) s += sq[qi][dd] * bf(sk[kk][dd]);
+                s *= a.scale;
+            }
+            sp[qi][kk] = s;
+        }
+        __syncthreads();
+        for (int qi = tid; qi < nq; qi += blockDim.x) {
+            float mx = sm[qi];
+            for (int kk = 0; kk < nk; ++kk) mx = fmaxf(mx, sp[qi][kk]);
+            const float al = sliding && mx == -INFINITY ? 1.0f : expf(sm[qi] - mx);
+            float sum = 0.0f;
+            for (int kk = 0; kk < nk; ++kk) {
+                const float p = sliding && mx == -INFINITY ? 0.0f : expf(sp[qi][kk] - mx);
+                sp[qi][kk] = p;
+                sum += p;
+            }
+            sl[qi] = sl[qi] * al + sum;
+            sm[qi] = mx;
+            sa[qi] = al;
+        }
+        __syncthreads();
+        for (int r = 0; r < kMaxQ / 2; ++r) {
+            const int qi = half * (kMaxQ / 2) + r;
+            if (qi >= nq) break;
+            float acc = o[r] * sa[qi];
+            for (int kk = 0; kk < nk; ++kk) acc += sp[qi][kk] * bf(sv[kk][d]);
+            o[r] = acc;
+        }
+        __syncthreads();
+    }
+    for (int r = 0; r < kMaxQ / 2; ++r) {
+        const int qi = half * (kMaxQ / 2) + r;
+        if (qi >= nq) break;
+        const size_t rh = static_cast<size_t>(blockIdx.x) * nqt + (qi / g) * a.hq + j * g + qi % g;
+        a.po[rh * kD + d] = o[r];
+        if (d == 0) {
+            a.pml[rh * 2] = sm[qi];
+            a.pml[rh * 2 + 1] = sl[qi];
+        }
+    }
+}
+
+extern "C" __global__ void __launch_bounds__(256) tf_ink2_dsp_attn(AttnArgs a) {
+    ink2DraftAttn<false>(a, 0, 0);
+}
+
+#include "draft_fp8.cuh"
+#include "dflash2.cuh"
+
+// Each (row, head)'s chunks folded in order: out bf16 [T][hq][128].
+extern "C" __global__ void __launch_bounds__(128) tf_ink2_dsp_merge(const float* __restrict__ po, const float* __restrict__ pml,
+                                                                    int chunks, int nqt, uint16_t* __restrict__ out) {
+    using namespace ink2d;
+    const size_t rh = blockIdx.x;
+    const int d = threadIdx.x;
+    float mx = -INFINITY;
+    for (int c = 0; c < chunks; ++c) mx = fmaxf(mx, pml[(c * nqt + rh) * 2]);
+    float l = 0.0f, acc = 0.0f;
+    for (int c = 0; c < chunks; ++c) {
+        const float m = pml[(c * nqt + rh) * 2];
+        const float wt = m == -INFINITY ? 0.0f : expf(m - mx);
+        l += pml[(c * nqt + rh) * 2 + 1] * wt;
+        acc += po[(c * nqt + rh) * kD + d] * wt;
+    }
+    out[rh * kD + d] = tobf(acc / l);
+}
+
+// The Markov head's context: out fp32 [rows][3R] = bias + rnn_proj[:, 2R:] . [hidden_row, f_rnn], a warp an output.
+extern "C" __global__ void __launch_bounds__(256) tf_ink2_dsp_ctx(const uint16_t* __restrict__ hidden, const uint16_t* __restrict__ frnn,
+                                                                  const uint16_t* __restrict__ W, const uint16_t* __restrict__ bias,
+                                                                  float* __restrict__ out, int rows, int C, int R) {
+    using namespace ink2d;
+    const int o = blockIdx.x * (blockDim.x >> 5) + (threadIdx.x >> 5), lane = threadIdx.x & 31;
+    if (o >= 3 * R) return;
+    const uint16_t* w = W + static_cast<size_t>(o) * (2 * R + 2 * C) + 2 * R;
+    float acc[kMaxRows];
+    for (int r = 0; r < kMaxRows; ++r) acc[r] = 0.0f;
+    for (int k = lane; k < 2 * C; k += 32) {
+        const float wk = bf(w[k]);
+        if (k < C) {
+            for (int r = 0; r < kMaxRows; ++r)
+                if (r < rows) acc[r] += wk * bf(hidden[static_cast<size_t>(r) * C + k]);
+        } else {
+            const float f = wk * bf(frnn[k - C]);
+            for (int r = 0; r < kMaxRows; ++r) acc[r] += f;
+        }
+    }
+    for (int r = 0; r < kMaxRows; ++r) {
+        const float s = tf_common::warp_sum(acc[r]);
+        if (lane == 0 && r < rows) out[static_cast<size_t>(r) * 3 * R + o] = s + bf(bias[o]);
+    }
+}
+
+// One recurrence step (one block, R threads): raw = ctx + rnn_proj[:, :2R] . [state, w1[prev]]; gated as the bf16 ops.
+extern "C" __global__ void __launch_bounds__(256) tf_ink2_dsp_rnn(const float* __restrict__ ctx, const uint16_t* __restrict__ W,
+                                                                  const uint16_t* __restrict__ w1, const int* __restrict__ walk, int j,
+                                                                  uint16_t* __restrict__ state, uint16_t* __restrict__ latent, int R, int C) {
+    using namespace ink2d;
+    __shared__ float in[512];
+    __shared__ float raw[768];
+    const int c = threadIdx.x, lane = c & 31, wp = c >> 5, nw = blockDim.x >> 5;
+    const size_t prev = static_cast<size_t>(walk[j]);
+    in[c] = bf(state[c]);
+    in[R + c] = bf(w1[prev * R + c]);
+    __syncthreads();
+    const int ld = 2 * R + 2 * C;
+    for (int o = wp; o < 3 * R; o += nw) {
+        float s = 0.0f;
+        for (int k = lane; k < 2 * R; k += 32) s += bf(W[static_cast<size_t>(o) * ld + k]) * in[k];
+        s = tf_common::warp_sum(s);
+        if (lane == 0) raw[o] = s + ctx[o];
+    }
+    __syncthreads();
+    const float gate = bfr(1.0f / (1.0f + expf(-bfr(raw[c]))));
+    const float cand = bfr(tanhf(bfr(raw[R + c])));
+    const float keep = bfr(gate * in[c]);
+    const float upd = bfr(bfr(1.0f - gate) * cand);
+    state[c] = tobf(keep + upd);
+    latent[c] = tobf(tanhf(bfr(raw[2 * R + c])));
+}
+
+// A step's logits over this rank's vocabulary: softcap(bf16(base + bf16(fold_bias + fold . latent))), -inf past valid.
+extern "C" __global__ void __launch_bounds__(256) tf_ink2_dsp_vocab(const uint16_t* __restrict__ base, const uint16_t* __restrict__ latent,
+                                                                    const uint16_t* __restrict__ fold, const uint16_t* __restrict__ fbias,
+                                                                    float cap, int valid, int nv, float* __restrict__ out) {
+    using namespace ink2d;
+    const int v = blockIdx.x * (blockDim.x >> 5) + (threadIdx.x >> 5), lane = threadIdx.x & 31;
+    if (v >= nv) return;
+    const uint16_t* f = fold + static_cast<size_t>(v) * 256;
+    float s = 0.0f;
+    for (int k = lane; k < 256; k += 32) s += bf(latent[k]) * bf(f[k]);
+    s = tf_common::warp_sum(s);
+    if (lane != 0) return;
+    const float b = bfr(s + bf(fbias[v]));
+    const float x = bfr(bf(base[v]) + b);
+    out[v] = v < valid ? bfr(tanhf(x / cap) * cap) : -INFINITY;
+}
+
+// The ranks' (value, id) picks to walk[j + 1]: MiniMax M3's merge, with 0x7fffffff when no value beats -Inf.
+extern "C" __global__ void tf_ink2_dsp_pick_merge(const unsigned char* __restrict__ picks, int world, int stride,
+                                                  int* __restrict__ walk, int j) {
+    tf_common::dspark_pick<0x7fffffff>(picks, world, stride, walk, j);
+}
+
+// Each captured target visit writes its own channel in the drafter's interleaved tap rows.
+extern "C" __global__ void __launch_bounds__(256) tf_ink2_dsp_tap(const uint16_t* __restrict__ x,
+                                                                   uint16_t* __restrict__ taps, int count, int channels,
+                                                                   int tap) {
+    const int i = blockIdx.x * blockDim.x + threadIdx.x;
+    if (i < count) taps[(i / channels * 4 + tap) * channels + i % channels] = x[i];
+}
