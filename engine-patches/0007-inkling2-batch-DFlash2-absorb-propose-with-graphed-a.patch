diff --git a/zig/kernels/cuda/inkling2/dflash2.cuh b/zig/kernels/cuda/inkling2/dflash2.cuh
index 2385277..175da14 100644
--- a/zig/kernels/cuda/inkling2/dflash2.cuh
+++ b/zig/kernels/cuda/inkling2/dflash2.cuh
@@ -95,3 +95,153 @@ extern "C" __global__ void __launch_bounds__(512) tf_ink2_df_select8(
     int step, int vocab, float cap) {
     ink2DfSelect(top, projected, predecessor, successor, prev_scales, next_scales, walk, ids, logits, step, vocab, cap);
 }
+
+namespace ink2df {
+struct BatchSlot {
+    unsigned long long k[5];
+    unsigned long long v[5];
+    int pos0;
+    int _pad;
+};
+}  // namespace ink2df
+
+extern "C" __global__ void __launch_bounds__(256) tf_ink2_df_conv_batch(
+    const uint16_t* __restrict__ x, const uint16_t* __restrict__ dyn, const uint16_t* __restrict__ base,
+    uint16_t* __restrict__ out, int width, int side) {
+    using namespace ink2d;
+    const int row = blockIdx.x, local_row = row & 7, groups = width / 16;
+    const uint16_t* delta = dyn + (4 * row + 2 * side) * groups;
+    const uint16_t* kernel = base + 2 * side * width;
+    for (int c = threadIdx.x; c < width; c += blockDim.x) {
+        float sum = (bf(kernel[c]) + bf(delta[c / 16])) * bf(x[row * width + c]);
+        if (local_row > 0)
+            sum += (bf(kernel[width + c]) + bf(delta[groups + c / 16])) * bf(x[(row - 1) * width + c]);
+        const int at = row * width + c;
+        out[at] = side == 0 ? tobf(sum) : tobf(bf(out[at]) + bfr(sum));
+    }
+}
+
+extern "C" __global__ void __launch_bounds__(64) tf_ink2_df_qk_batch_absorb(
+    const uint16_t* __restrict__ x, const uint16_t* __restrict__ kw,
+    const ink2df::BatchSlot* __restrict__ slots, const int* __restrict__ row_slot,
+    const int* __restrict__ row_local, int layer, long long ld, int hk, int ring, float eps, float theta) {
+    using namespace ink2d;
+    __shared__ float sh[32];
+    const int row = blockIdx.x, j = blockIdx.y, i = threadIdx.x;
+    const int s = row_slot[row];
+    const ink2df::BatchSlot slot = slots[s];
+    const uint16_t* src = x + static_cast<size_t>(row) * ld + static_cast<long long>(j) * kD;
+    const float x0 = bf(src[i]), x1 = bf(src[i + 64]);
+    const float inv = 1.0f / sqrtf(blockSum(x0 * x0 + x1 * x1, sh) / kD + eps);
+    const float y0 = bfr(x0 * inv * bf(kw[i])), y1 = bfr(x1 * inv * bf(kw[i + 64]));
+    const int pos = slot.pos0 + row_local[row];
+    const float f = static_cast<float>(pos) * (1.0f / powf(theta, static_cast<float>(2 * i) / kD));
+    const float co = cosf(f), si = sinf(f);
+    const uint16_t o0 = tobf(y0 * co - y1 * si), o1 = tobf(y1 * co + y0 * si);
+    const size_t at = (static_cast<size_t>(pos % ring) * hk + j) * kD;
+    uint16_t* kc = reinterpret_cast<uint16_t*>(slot.k[layer]);
+    uint16_t* vc = reinterpret_cast<uint16_t*>(slot.v[layer]);
+    kc[at + i] = o0;
+    kc[at + i + 64] = o1;
+    const uint16_t* vsrc = src + static_cast<long long>(hk) * kD;
+    vc[at + i] = vsrc[i];
+    vc[at + i + 64] = vsrc[i + 64];
+}
+
+extern "C" __global__ void __launch_bounds__(64) tf_ink2_df_qk_batch(
+    QkArgs a, const ink2df::BatchSlot* __restrict__ slots, int layer) {
+    __shared__ float sh[32];
+    const int z = blockIdx.z;
+    const ink2df::BatchSlot slot = slots[z];
+    QkArgs local = a;
+    local.x = a.x + static_cast<size_t>(z) * ink2d::kMaxRows * a.ld;
+    local.q = a.q + static_cast<size_t>(z) * ink2d::kMaxRows * a.hq * ink2d::kD;
+    local.kc = reinterpret_cast<uint16_t*>(slot.k[layer]);
+    local.vc = reinterpret_cast<uint16_t*>(slot.v[layer]);
+    ink2DraftQk(local, slot.pos0, sh);
+}
+
+extern "C" __global__ void __launch_bounds__(256) tf_ink2_df_attn_batch(
+    AttnArgs a, const ink2df::BatchSlot* __restrict__ slots, int layer, int chunks, int window) {
+    const int z = blockIdx.z;
+    const ink2df::BatchSlot slot = slots[z];
+    const int nqt = a.T * a.hq;
+    AttnArgs local = a;
+    local.q = a.q + static_cast<size_t>(z) * nqt * ink2d::kD;
+    local.kc = reinterpret_cast<const uint16_t*>(slot.k[layer]);
+    local.vc = reinterpret_cast<const uint16_t*>(slot.v[layer]);
+    local.po = a.po + static_cast<size_t>(z) * chunks * nqt * ink2d::kD;
+    local.pml = a.pml + static_cast<size_t>(z) * chunks * nqt * 2;
+    ink2DraftAttn<true>(local, slot.pos0, window);
+}
+
+extern "C" __global__ void __launch_bounds__(128) tf_ink2_df_merge_batch(
+    const float* __restrict__ po, const float* __restrict__ pml, int chunks, int nqt, uint16_t* __restrict__ out) {
+    using namespace ink2d;
+    const size_t idx = blockIdx.x;
+    const size_t z = idx / nqt, rh = idx % nqt;
+    const int d = threadIdx.x;
+    const size_t base = z * chunks * nqt + rh;
+    float mx = -INFINITY;
+    for (int c = 0; c < chunks; ++c) mx = fmaxf(mx, pml[(base + static_cast<size_t>(c) * nqt) * 2]);
+    float l = 0.0f, acc = 0.0f;
+    for (int c = 0; c < chunks; ++c) {
+        const size_t at = base + static_cast<size_t>(c) * nqt;
+        const float m = pml[at * 2];
+        const float wt = m == -INFINITY ? 0.0f : expf(m - mx);
+        l += pml[at * 2 + 1] * wt;
+        acc += po[at * kD + d] * wt;
+    }
+    out[idx * kD + d] = tobf(acc / l);
+}
+
+extern "C" __global__ void __launch_bounds__(256) tf_ink2_df_gather_hidden(
+    const uint16_t* __restrict__ src, uint16_t* __restrict__ dst, const int* __restrict__ row_map, int width) {
+    const int row = blockIdx.x;
+    const uint16_t* s = src + static_cast<size_t>(row_map[row]) * width;
+    uint16_t* d = dst + static_cast<size_t>(row) * width;
+    for (int c = threadIdx.x; c < width; c += blockDim.x) d[c] = s[c];
+}
+
+template <typename Book>
+__device__ __forceinline__ void ink2DfSelectBatch(
+    const unsigned* __restrict__ top, const uint16_t* __restrict__ projected,
+    const Book* __restrict__ predecessor, const Book* __restrict__ successor,
+    const float* __restrict__ prev_scales, const float* __restrict__ next_scales,
+    unsigned* __restrict__ walk, long long* __restrict__ ids, uint16_t* __restrict__ logits,
+    const int* __restrict__ row_offs, const int* __restrict__ stream_ns,
+    int step, int vocab, float cap) {
+    using namespace ink2df;
+    const int s = blockIdx.x;
+    if (step >= stream_ns[s]) return;
+    ink2DfSelect(
+        top + static_cast<size_t>(row_offs[s]) * kLogprobWords,
+        projected + static_cast<size_t>(row_offs[s]) * kRank,
+        predecessor,
+        successor,
+        prev_scales,
+        next_scales,
+        walk + static_cast<size_t>(s) * 8,
+        ids + static_cast<size_t>(s) * kTop,
+        logits + static_cast<size_t>(s) * kTop,
+        step,
+        vocab,
+        cap);
+}
+
+extern "C" __global__ void __launch_bounds__(512) tf_ink2_df_select_batch(
+    const unsigned* __restrict__ top, const uint16_t* __restrict__ projected,
+    const uint16_t* __restrict__ predecessor, const uint16_t* __restrict__ successor,
+    unsigned* __restrict__ walk, long long* __restrict__ ids, uint16_t* __restrict__ logits,
+    const int* __restrict__ row_offs, const int* __restrict__ stream_ns, int step, int vocab, float cap) {
+    ink2DfSelectBatch(top, projected, predecessor, successor, nullptr, nullptr, walk, ids, logits, row_offs, stream_ns, step, vocab, cap);
+}
+
+extern "C" __global__ void __launch_bounds__(512) tf_ink2_df_select8_batch(
+    const unsigned* __restrict__ top, const uint16_t* __restrict__ projected,
+    const uint8_t* __restrict__ predecessor, const uint8_t* __restrict__ successor,
+    const float* __restrict__ prev_scales, const float* __restrict__ next_scales,
+    unsigned* __restrict__ walk, long long* __restrict__ ids, uint16_t* __restrict__ logits,
+    const int* __restrict__ row_offs, const int* __restrict__ stream_ns, int step, int vocab, float cap) {
+    ink2DfSelectBatch(top, projected, predecessor, successor, prev_scales, next_scales, walk, ids, logits, row_offs, stream_ns, step, vocab, cap);
+}
