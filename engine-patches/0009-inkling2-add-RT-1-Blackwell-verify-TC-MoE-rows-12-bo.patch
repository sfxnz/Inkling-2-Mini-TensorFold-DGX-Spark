     }
 
diff --git a/zig/src/families/inkling2/loop_backend.zig b/zig/src/families/inkling2/loop_backend.zig
index 4dc50b5..6286b79 100644
--- a/zig/src/families/inkling2/loop_backend.zig
+++ b/zig/src/families/inkling2/loop_backend.zig
@@ -3,6 +3,7 @@ const std = @import("std");
 const cuda = @import("cuda");
 const lanes = @import("lanes");
 const engine = @import("loop_engine.zig");
+const modelopt = @import("modelopt.zig");
 const ops = @import("ops.zig");
 const dspark = @import("dspark_cuda.zig");
 const dflash = @import("dflash2_cuda.zig");
@@ -111,22 +112,30 @@ pub const Backend = struct {
         var ctx_buf: [24]u8 = undefined;
         const ctx_str = std.fmt.bufPrint(&ctx_buf, "ctx{d}", .{b.m.context}) catch return null;
         const attn_str: []const u8 = if (b.m.w.layers.len > 0)
-            if (b.m.w.layers[0].attn.qmmf) |qa| if (qa.wq.mode == .fp8) "attn_fp8" else "attn_bf16" else "attn_raw"
+            if (b.m.w.layers[0].attn.qmmf) |qa|
+                if (qa.wq.mode == .fp8)
+                    if (qa.gate.mode == .fp8) "attn_fp8_gate_fp8" else "attn_fp8"
+                else if (qa.gate.mode == .fp8) "attn_bf16_gate_fp8" else "attn_bf16"
+            else
+                "attn_raw"
         else
             "attn_none";
         const draft_mode: []const u8 = switch (d.*) {
             .dflash2 => |df| if (df.w.fp8_layers)
-                if (df.w.base != null) "df_fp8_fp8" else "df_fp8_bf16"
-            else if (df.w.base != null) "df_bf16_fp8" else "df_bf16_bf16",
+                if (df.w.base) |bw| (if (bw.mode == .fp4) "df_fp8_fp4" else "df_fp8_fp8") else "df_fp8_bf16"
+            else if (df.w.base) |bw| (if (bw.mode == .fp4) "df_bf16_fp4" else "df_bf16_fp8") else "df_bf16_bf16",
             .dspark => "ds",
         };
+        var tc_buf: [24]u8 = undefined;
+        const tc_str = std.fmt.bufPrint(&tc_buf, "tc{d}_v{d}", .{ modelopt.prefillTcMode(), modelopt.verifyTcRows() }) catch return null;
         const parts = [_][]const u8{
-            "inkling2-warm-v1",
+            "inkling2-warm-v2",
             cap_str,
             @tagName(d.*),
             draft_mode,
             if (lazy) "lazy" else "dense",
             attn_str,
+            tc_str,
             @tagName(b.m.layout.format),
             ctx_str,
         };
