From a5705079c129d8ccc7aa489e963dbdcd61629776 Mon Sep 17 00:00:00 2001
From: sfxnz <sfxnz@users.noreply.github.com>
Date: Wed, 25 Nov 2026 21:19:32 +0000
Subject: [PATCH] inkling2: add RT=1 Blackwell verify TC MoE (rows>=12), bound
 verify_cache=64, include flags in warmCacheKey

---
 zig/kernels/cuda/inkling2/modelopt.cu      | 90 ++++++++++++++--------
 zig/src/families/inkling2/dflash2_cuda.zig |  4 +-
 zig/src/families/inkling2/loop_backend.zig | 17 +++-
 zig/src/families/inkling2/loop_graphs.zig  |  4 +-
 zig/src/families/inkling2/modelopt.zig     | 21 +++--
 zig/src/platform/environment.zig           |  1 +
 zig/src/platform/environment_test.zig      |  1 +
 zig/src/server/cli.zig                     |  1 +
 8 files changed, 92 insertions(+), 47 deletions(-)

diff --git a/zig/kernels/cuda/inkling2/modelopt.cu b/zig/kernels/cuda/inkling2/modelopt.cu
index 9b4353a..5d2c186 100644
--- a/zig/kernels/cuda/inkling2/modelopt.cu
+++ b/zig/kernels/cuda/inkling2/modelopt.cu
@@ -339,20 +339,22 @@ __device__ __forceinline__ void mma_mxfp8(float (&)[4], const uint32_t (&)[4], u
 }
 #endif
 
-// Blackwell native block-scaled tensor-core prompt GEMM over ModelOpt row-major checkpoint weights.
-template <int FMT>
+// Blackwell native block-scaled tensor-core GEMM over ModelOpt row-major checkpoint weights (RT=4 for 64-row prompt, RT=1 for 16-row verify).
+template <int FMT, int RT = 4>
 __device__ __forceinline__ void prompt_tc_body(const uint8_t* __restrict__ xc, const uint8_t* __restrict__ xsc,
                                                int x_stride, int slots, Weight w, int KG, int NB,
                                                const int* __restrict__ items, const int* __restrict__ item_count,
                                                const int* __restrict__ members, void* __restrict__ out, int N,
                                                int skip) {
+  constexpr int kRows = 16 * RT;
+  constexpr int kTokLoads = (kRows + 31) / 32;
   const int warp = threadIdx.x >> 5, lane = threadIdx.x & 31, gq = lane >> 2, t = lane & 3;
   const int units = __ldg(item_count) * NB;
-  __shared__ __align__(16) uint4 sx_c[2][4][64][2];
-  __shared__ __align__(16) uint32_t sx_s[2][4][64];
+  __shared__ __align__(16) uint4 sx_c[2][4][kRows][2];
+  __shared__ __align__(16) uint32_t sx_s[2][4][kRows];
   __shared__ __align__(16) uint4 sw_c[2][4][32][2];
   __shared__ __align__(16) uint32_t sw_s[2][4][32];
-  __shared__ int s_tok[4][64];
+  __shared__ int s_tok[4][kRows];
   const int c_stride = FMT == 0 ? (x_stride >> 1) : x_stride;
   const int s_stride = FMT == 0 ? (x_stride >> 4) : (x_stride >> 5);
   const int steps = FMT == 0 ? (KG >> 1) : KG;
@@ -361,10 +363,10 @@ __device__ __forceinline__ void prompt_tc_body(const uint8_t* __restrict__ xc, c
     const int e = __ldg(items + 3 * it), first = __ldg(items + 3 * it + 1), cnt = __ldg(items + 3 * it + 2);
     if (e == skip) continue;
     const float outer = FMT == 0 ? outer_of(w, e) : 1.0f;
-    bool v[4][2];
-    int pr[4][2];
+    bool v[RT][2];
+    int pr[RT][2];
 #pragma unroll
-    for (int r = 0; r < 4; ++r)
+    for (int r = 0; r < RT; ++r)
 #pragma unroll
       for (int h = 0; h < 2; ++h) {
         const int i = 16 * r + gq + 8 * h;
@@ -372,19 +374,21 @@ __device__ __forceinline__ void prompt_tc_body(const uint8_t* __restrict__ xc, c
         pr[r][h] = v[r][h] ? __ldg(members + first + i) : 0;
       }
 #pragma unroll
-    for (int i = 0; i < 2; ++i) {
+    for (int i = 0; i < kTokLoads; ++i) {
       const int rr = lane + 32 * i;
-      if (rr < cnt) {
-        const int p = __ldg(members + first + rr);
-        s_tok[warp][rr] = slots ? (p / slots) : p;
-      } else {
-        s_tok[warp][rr] = -1;
+      if (rr < kRows) {
+        if (rr < cnt) {
+          const int p = __ldg(members + first + rr);
+          s_tok[warp][rr] = slots ? (p / slots) : p;
+        } else {
+          s_tok[warp][rr] = -1;
+        }
       }
     }
     __syncwarp();
     auto load_stage = [&](int s, int g) {
 #pragma unroll
-      for (int i = 0; i < 4; ++i) {
+      for (int i = 0; i < RT; ++i) {
         const int q = lane + 32 * i, rr = q >> 1, cc = q & 1;
         const int tok = s_tok[warp][rr];
         const int safe_tok = tok >= 0 ? tok : 0;
@@ -393,17 +397,19 @@ __device__ __forceinline__ void prompt_tc_body(const uint8_t* __restrict__ xc, c
                          tok >= 0);
       }
 #pragma unroll
-      for (int i = 0; i < 2; ++i) {
+      for (int i = 0; i < kTokLoads; ++i) {
         const int rr = lane + 32 * i;
-        const int tok = s_tok[warp][rr];
-        if (tok >= 0) {
-          if constexpr (FMT == 0) {
-            sx_s[s][warp][rr] = __ldg(reinterpret_cast<const uint32_t*>(xsc + static_cast<size_t>(tok) * s_stride + g * 4));
+        if (rr < kRows) {
+          const int tok = s_tok[warp][rr];
+          if (tok >= 0) {
+            if constexpr (FMT == 0) {
+              sx_s[s][warp][rr] = __ldg(reinterpret_cast<const uint32_t*>(xsc + static_cast<size_t>(tok) * s_stride + g * 4));
+            } else {
+              sx_s[s][warp][rr] = static_cast<uint32_t>(__ldg(xsc + static_cast<size_t>(tok) * s_stride + g));
+            }
           } else {
-            sx_s[s][warp][rr] = static_cast<uint32_t>(__ldg(xsc + static_cast<size_t>(tok) * s_stride + g));
+            sx_s[s][warp][rr] = 0u;
           }
-        } else {
-          sx_s[s][warp][rr] = 0u;
         }
       }
 #pragma unroll
@@ -423,9 +429,9 @@ __device__ __forceinline__ void prompt_tc_body(const uint8_t* __restrict__ xc, c
         }
       }
     };
-    float acc[1][4][4][4];
+    float acc[1][RT][4][4];
 #pragma unroll
-    for (int r = 0; r < 4; ++r)
+    for (int r = 0; r < RT; ++r)
 #pragma unroll
       for (int j = 0; j < 4; ++j) acc[0][r][j][0] = acc[0][r][j][1] = acc[0][r][j][2] = acc[0][r][j][3] = 0.f;
     if (steps > 0) {
@@ -442,9 +448,9 @@ __device__ __forceinline__ void prompt_tc_body(const uint8_t* __restrict__ xc, c
         tf_common::cp_wait<0>();
       }
       __syncwarp();
-      uint32_t a[4][4], sa[4];
+      uint32_t a[RT][4], sa[RT];
 #pragma unroll
-      for (int r = 0; r < 4; ++r) {
+      for (int r = 0; r < RT; ++r) {
         const int r0 = 16 * r;
         const uint32_t* p0 = reinterpret_cast<const uint32_t*>(&sx_c[cur][warp][r0 + gq][0]);
         const uint32_t* p1 = reinterpret_cast<const uint32_t*>(&sx_c[cur][warp][r0 + gq + 8][0]);
@@ -461,25 +467,25 @@ __device__ __forceinline__ void prompt_tc_body(const uint8_t* __restrict__ xc, c
         const uint32_t sb = sw_s[cur][warp][8 * j + gq];
         if constexpr (FMT == 0) {
 #pragma unroll
-          for (int r = 0; r < 4; ++r) mma4::mma_fp4(acc[0][r][j], a[r], b0, b1, sa[r], sb);
+          for (int r = 0; r < RT; ++r) mma4::mma_fp4(acc[0][r][j], a[r], b0, b1, sa[r], sb);
         } else {
 #pragma unroll
-          for (int r = 0; r < 4; ++r) mma_mxfp8(acc[0][r][j], a[r], b0, b1, sa[r], sb);
+          for (int r = 0; r < RT; ++r) mma_mxfp8(acc[0][r][j], a[r], b0, b1, sa[r], sb);
         }
       }
       __syncwarp();
     }
     if constexpr (FMT == 0) {
 #pragma unroll
-      for (int r = 0; r < 4; ++r)
+      for (int r = 0; r < RT; ++r)
 #pragma unroll
         for (int j = 0; j < 4; ++j)
 #pragma unroll
           for (int q = 0; q < 4; ++q) acc[0][r][j][q] *= outer;
     }
 #pragma unroll
-    for (int r = 0; r < 4; ++r)
-      store<4, 4>(acc, r, out, nullptr, N, cb * 32 + 2 * t, pr[r][0], pr[r][1], v[r][0], v[r][1]);
+    for (int r = 0; r < RT; ++r)
+      store<RT, 4>(acc, r, out, nullptr, N, cb * 32 + 2 * t, pr[r][0], pr[r][1], v[r][0], v[r][1]);
   }
 }
 
@@ -674,7 +680,7 @@ extern "C" __global__ void __launch_bounds__(128)
                                int slots, ink2o::Weight w, int KG, int NB, const int* __restrict__ items,
                                const int* __restrict__ item_count, const int* __restrict__ members,
                                void* __restrict__ out, int N, int skip) {
-  ink2o::prompt_tc_body<0>(xc, xsc, x_stride, slots, w, KG, NB, items, item_count, members, out, N, skip);
+  ink2o::prompt_tc_body<0, 4>(xc, xsc, x_stride, slots, w, KG, NB, items, item_count, members, out, N, skip);
 }
 
 extern "C" __global__ void __launch_bounds__(128)
@@ -682,5 +688,21 @@ extern "C" __global__ void __launch_bounds__(128)
                                int slots, ink2o::Weight w, int KG, int NB, const int* __restrict__ items,
                                const int* __restrict__ item_count, const int* __restrict__ members,
                                void* __restrict__ out, int N, int skip) {
-  ink2o::prompt_tc_body<1>(xc, xsc, x_stride, slots, w, KG, NB, items, item_count, members, out, N, skip);
+  ink2o::prompt_tc_body<1, 4>(xc, xsc, x_stride, slots, w, KG, NB, items, item_count, members, out, N, skip);
+}
+
+extern "C" __global__ void __launch_bounds__(128)
+    tf_ink2moe_verify_tc_nvfp4(const uint8_t* __restrict__ xc, const uint8_t* __restrict__ xsc, int x_stride,
+                               int slots, ink2o::Weight w, int KG, int NB, const int* __restrict__ items,
+                               const int* __restrict__ item_count, const int* __restrict__ members,
+                               void* __restrict__ out, int N, int skip) {
+  ink2o::prompt_tc_body<0, 1>(xc, xsc, x_stride, slots, w, KG, NB, items, item_count, members, out, N, skip);
+}
+
+extern "C" __global__ void __launch_bounds__(128)
+    tf_ink2moe_verify_tc_mxfp8(const uint8_t* __restrict__ xc, const uint8_t* __restrict__ xsc, int x_stride,
+                               int slots, ink2o::Weight w, int KG, int NB, const int* __restrict__ items,
+                               const int* __restrict__ item_count, const int* __restrict__ members,
+                               void* __restrict__ out, int N, int skip) {
+  ink2o::prompt_tc_body<1, 1>(xc, xsc, x_stride, slots, w, KG, NB, items, item_count, members, out, N, skip);
 }
