     }
 
diff --git a/zig/src/families/inkling2/modelopt.zig b/zig/src/families/inkling2/modelopt.zig
index ba5864d..f44a176 100644
--- a/zig/src/families/inkling2/modelopt.zig
+++ b/zig/src/families/inkling2/modelopt.zig
