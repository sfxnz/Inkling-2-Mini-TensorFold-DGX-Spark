     }
 
     pub fn enableGraphs(d: *Drafter, a: std.mem.Allocator) void {
-        d.graphs = .init(a, d.graph_engine.engine(), .{ .max = 64 });
+        d.graphs = .init(a, d.graph_engine.engine(), .{ .max = 32 });
         d.graphs.?.name = "inkling2 mini dflash2 proposal";
