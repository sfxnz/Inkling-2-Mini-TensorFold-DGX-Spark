     return S.v.?;
 }
 
+pub fn verifyTcRows() usize {
+    return @import("sys").environment.read(u32, "TF_INKLING2_VERIFY_TC_ROWS", 12) catch 12;
+}
+
 pub const Projection = struct {
     codes: u64,
     scales: u64,
@@ -60,6 +64,8 @@ pub const Kernels = struct {
     quant_x_mxfp8: cuda.Function,
     prompt_tc_nvfp4: cuda.Function,
     prompt_tc_mxfp8: cuda.Function,
