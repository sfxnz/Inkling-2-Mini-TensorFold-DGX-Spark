+    verify_tc_mxfp8: cuda.Function,
     act: cuda.Function,
     combine: cuda.Function,
     resident: usize,
@@ -79,6 +85,8 @@ pub const Kernels = struct {
             .quant_x_mxfp8 = try mod.function("tf_ink2moe_quant_x_mxfp8"),
             .prompt_tc_nvfp4 = try mod.function("tf_ink2moe_prompt_tc_nvfp4"),
             .prompt_tc_mxfp8 = try mod.function("tf_ink2moe_prompt_tc_mxfp8"),
+            .verify_tc_nvfp4 = try mod.function("tf_ink2moe_verify_tc_nvfp4"),
+            .verify_tc_mxfp8 = try mod.function("tf_ink2moe_verify_tc_mxfp8"),
             .act = try mod.function("tf_ink2moe_act"),
             .combine = try mod.function("tf_ink2moe_combine"),
             .resident = @max(1, try decode.occupancy(128, 0)) * sms,
@@ -240,7 +248,10 @@ pub fn run(k: *const Kernels, s: cuda.Stream, l: Layer, caps: experts.Caps, x: u
     const pairs = rows * slots;
     const b = layout(scratch, rows, slots, hidden, intermediate);
     const listed = rows >= 32;
-    const tile: usize = if (listed) 64 else 16;
+    const use_tc = rows >= verifyTcRows() and k.tc_ok and prefillTcMode() != 0 and
+        ((l.format == .nvfp4 and hidden % 64 == 0 and intermediate % 64 == 0) or
+        (l.format == .mxfp8 and hidden % 32 == 0 and intermediate % 32 == 0));
+    const tile: usize = if (rows >= 64 or (!use_tc and listed)) 64 else 16;
     const item_bound = (pairs + tile - 1) / tile + @min(pairs, @as(usize, l.experts));
 
     var g: cuda.Args = .{};
@@ -248,10 +259,10 @@ pub fn run(k: *const Kernels, s: cuda.Stream, l: Layer, caps: experts.Caps, x: u
     for ([_]usize{ rows, slots, l.experts, tile }) |v| g.add(i32d(v));
     try cuda.launch.launch(k.plan, .{ .grid = .{ .x = 1, .y = 1, .z = 1 }, .block = .{ .x = 512 } }, s, &g);
 
-    const use_tc = listed and k.tc_ok and prefillTcMode() != 0 and
-        ((l.format == .nvfp4 and hidden % 64 == 0 and intermediate % 64 == 0) or
-        (l.format == .mxfp8 and hidden % 32 == 0 and intermediate % 32 == 0));
-    const tc_fn = if (l.format == .nvfp4) k.prompt_tc_nvfp4 else k.prompt_tc_mxfp8;
+    const tc_fn = if (tile == 64)
+        (if (l.format == .nvfp4) k.prompt_tc_nvfp4 else k.prompt_tc_mxfp8)
