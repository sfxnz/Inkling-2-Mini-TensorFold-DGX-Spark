+/// Pack a BF16 head matrix into NVFP4 codes + 16-input E4M3 scales inside `dest`.
+pub fn packFp4(d: *const cuda.Driver, s: cuda.Stream, source: u64, dest: u64, n: usize, k: usize) !cuda.qmmf.Weight {
+    if (!eligible(n, k)) return error.Inkling2FP8HeadShape;
+    var mod = try cuda.Module.load(d, cuda.kernels.inkling2_ops);
+    defer mod.unload();
+    var amax = try cuda.DeviceBuffer.alloc(d, 4);
+    defer amax.free();
+    errdefer s.synchronize() catch {};
+    try amax.fill8(0, s.handle);
+    var a: cuda.Args = .{};
+    a.add(source);
+    a.add(@as(i64, @intCast(n * k)));
+    a.add(amax.ptr);
+    try go(try mod.function("tf_ink2_lazy_amax"), s, 256, 1, &a);
+    try s.synchronize();
+    var value: u32 = 0;
+    try amax.download(0, std.mem.asBytes(&value));
+    if (value > 0x4b80) return error.Inkling2FP8HeadWeights;
+    const biggest: f32 = @bitCast(value << 16);
+    const global_scale = @max(biggest, 0x1p-16) / (6.0 * 448.0);
+    const inv_global: f32 = 1.0 / global_scale;
+    const words = dest;
+    const scales = dest + fp4CodeBytes(n, k);
+    const tiles = (cuda.nvfp4.padded(n) / 64) * (k / 64);
+    a = .{};
+    a.add(source);
+    a.add(words);
+    a.add(scales);
+    a.add(int(n));
+    a.add(int(k));
+    a.add(inv_global);
+    try go(try mod.function("tf_ink2_draft_pack_fp4_head"), s, tiles, 1, &a);
+    try s.synchronize();
+    return cuda.nvfp4.weight(words, scales, global_scale, n, k);
+}
