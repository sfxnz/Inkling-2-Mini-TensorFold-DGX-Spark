+// Pack a BF16 [n, k] head matrix into qmmf::Mode::fp4 tiled words + e4m3 16-input block scales.
+extern "C" __global__ void __launch_bounds__(256) tf_ink2_draft_pack_fp4_head(
+    const uint16_t* __restrict__ weights, uint32_t* __restrict__ words, uint8_t* __restrict__ scales,
+    int n, int k, float inv_global) {
+    __shared__ uint8_t s_nib[8][8][64];
+    const int kg = k >> 6;
+    const int tg = static_cast<int>(blockIdx.x);
+    const int t = tg / kg, g = tg - t * kg;
+    const int warp = threadIdx.x >> 5, lane = threadIdx.x & 31;
+    const int r = lane >> 2, q = lane & 3;
+    const int row = t * 64 + warp * 8 + r;
+    float vals[16];
+    float amax = 0.0f;
+    if (row < n) {
+        const uint4* wp = reinterpret_cast<const uint4*>(weights + static_cast<size_t>(row) * k + g * 64 + q * 16);
+        const uint4 v0 = wp[0], v1 = wp[1];
+        const uint32_t u[8] = {v0.x, v0.y, v0.z, v0.w, v1.x, v1.y, v1.z, v1.w};
+#pragma unroll
+        for (int p = 0; p < 8; ++p) {
+            const float a = ink2o::bf(static_cast<uint16_t>(u[p] & 0xffffu));
+            const float b = ink2o::bf(static_cast<uint16_t>(u[p] >> 16));
+            vals[2 * p] = a;
+            vals[2 * p + 1] = b;
+            amax = fmaxf(amax, fmaxf(fabsf(a), fabsf(b)));
+        }
+    }
+    const nvfp4q::Scale sc = nvfp4q::block_scale(amax, inv_global);
+    scales[(static_cast<size_t>(tg) * 64 + warp * 8 + r) * 4 + q] =
+        (row < n) ? static_cast<uint8_t>(sc.sf8) : 0u;
+#pragma unroll
+    for (int p = 0; p < 16; ++p) {
+        s_nib[warp][r][q * 16 + p] = (row < n) ? static_cast<uint8_t>(nvfp4q::e2m1(vals[p] * sc.mul)) : 0u;
+    }
+    __syncwarp();
+    constexpr int offs[8] = {0, 8, 16, 24, 1, 9, 17, 25};
+#pragma unroll
+    for (int v = 0; v < 2; ++v) {
+        uint32_t word = 0u;
+        if (row < n) {
+#pragma unroll
+            for (int p = 0; p < 8; ++p) {
+                const int col = 32 * v + 2 * q + offs[p];
+                word |= static_cast<uint32_t>(s_nib[warp][r][col]) << (4 * p);
+            }
+        }
+        words[((static_cast<size_t>(tg) * 8 + warp) * 32 + lane) * 2 + v] = word;
+    }
+}
