+/// Reusable load-time GPU repacker for NVFP4 experts into Nvfp4Experts BLOCK4 layout.
+/// Staging memory is owned here and freed before KV pool sizing.
+pub const Packer = struct {
+    d: *const cuda.Driver,
+    mod: cuda.Module,
+    pack_fn: cuda.Function,
+    stream: cuda.Stream,
+    stage: ?cuda.DeviceBuffer = null,
+
+    pub fn init(d: *const cuda.Driver) !Packer {
+        if (!cuda.kernels.available) return error.BuiltWithoutKernels;
+        var mod = try cuda.Module.load(d, cuda.kernels.inkling2_modelopt);
+        errdefer mod.unload();
+        const pack_fn = try mod.function("tf_ink2_pack_fp4_experts");
+        var stream = try cuda.Stream.init(d, false);
+        errdefer stream.deinit();
+        return .{ .d = d, .mod = mod, .pack_fn = pack_fn, .stream = stream };
+    }
+
+    pub fn deinit(p: *Packer) void {
+        if (p.stage) |*b| b.free();
+        p.stream.deinit();
+        p.mod.unload();
+        p.* = undefined;
+    }
+
+    fn ensureStage(p: *Packer, bytes: usize) !*cuda.DeviceBuffer {
+        if (p.stage) |*b| {
+            if (b.len >= bytes) return b;
+            b.free();
+            p.stage = null;
+        }
+        p.stage = try cuda.DeviceBuffer.alloc(p.d, bytes);
+        return &p.stage.?;
+    }
+
+    fn launchPack(p: *const Packer, codes: u64, scales: u64, out: u64, count: usize, n_src: usize, n_out: usize, k: usize, row0: usize, row_step: usize, parts: usize, m: usize) !void {
+        var a: cuda.Args = .{};
+        for ([_]u64{ codes, scales, out }) |v| a.add(v);
+        for ([_]usize{ n_src, n_out, k, row0, row_step, parts, m }) |v| a.add(i32d(v));
+        try cuda.launch.launch(p.pack_fn, .{ .grid = .{ .x = @intCast(k / 32), .y = @intCast(n_out / 32), .z = @intCast(count) }, .block = .{ .x = 144 } }, p.stream, &a);
+    }
+};
