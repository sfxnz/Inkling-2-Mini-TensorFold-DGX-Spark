+// Pack row-major ModelOpt NVFP4 codes [E][n_src][k/2] and scales [E][n_src][k/16] with row stride
+// (row = row0 + row_step * col) into Nvfp4Experts BLOCK4 layout [E][n_out/32][k/32][parts][144] at part m.
+extern "C" __global__ void __launch_bounds__(144)
+    tf_ink2_pack_fp4_experts(const uint8_t* __restrict__ codes, const uint8_t* __restrict__ scales,
+                             uint32_t* __restrict__ out, int n_src, int n_out, int k, int row0, int row_step,
+                             int parts, int m) {
+  const int g = blockIdx.x, cb = blockIdx.y, e = blockIdx.z, w = threadIdx.x, kg = k / 32;
+  uint32_t* dst = out + (((static_cast<long long>(e) * (n_out / 32) + cb) * kg + g) * parts + m) * 144;
+  const uint8_t* ce = codes + static_cast<long long>(e) * n_src * (k / 2);
+  const uint8_t* se = scales + static_cast<long long>(e) * n_src * (k / 16);
+  if (w < 128) {
+    const int gq = w / 16, t = (w / 4) % 4, j = w % 4;
+    const long long row = row0 + static_cast<long long>(row_step) * (cb * 32 + j * 8 + gq);
+    uint32_t word = 0;
+#pragma unroll
+    for (int h = 0; h < 2; ++h)
+#pragma unroll
+      for (int q = 0; q < 4; ++q) {
+        const int input = g * 32 + h * 16 + t * 4 + q;
+        const uint8_t byte = ce[row * (k / 2) + input / 2];
+        const uint32_t nib = (input & 1) ? byte >> 4 : byte & 0xF;
+        word |= nib << (4 * (2 * h + q / 2 + 4 * (q % 2)));
+      }
+    dst[w] = word;
+  } else {
+    uint32_t word = 0;
+#pragma unroll
+    for (int x = 0; x < 4; ++x) {
+      const int s = 4 * (w - 128) + x;  // ((t * 2 + h) * 4 + j) * 2 + c
+      const int c = s % 2, j = (s / 2) % 4, h = (s / 8) % 2, t = s / 16;
+      const long long row = row0 + static_cast<long long>(row_step) * (cb * 32 + j * 8 + t * 2 + c);
+      word |= static_cast<uint32_t>(se[row * (k / 16) + g * 2 + h]) << (8 * x);
+    }
+    dst[w] = word;
+  }
+}
