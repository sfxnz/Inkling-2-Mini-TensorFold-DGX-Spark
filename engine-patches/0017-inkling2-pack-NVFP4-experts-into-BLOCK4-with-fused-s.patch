+    const w13_amax = try ck.expect(try std.fmt.bufPrint(&ab, "{s}w13_weight_amax", .{prefix}), .f32, &.{count});
+    const w13_den = try ck.expect(try std.fmt.bufPrint(&db, "{s}w13_weight_outer_scale_denominator", .{prefix}), .f32, &.{1});
