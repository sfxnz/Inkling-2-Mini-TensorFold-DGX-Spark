+    const den13 = std.mem.bytesToValue(f32, w13_den.bytes[0..4]);
+    for (0..count) |i| {
+        const amax = std.mem.bytesToValue(f32, w13_amax.bytes[i * 4 ..][0..4]);
+        const s = outerScale(amax, den13);
+        up_scales_host[2 * i] = s;
+        up_scales_host[2 * i + 1] = s;
