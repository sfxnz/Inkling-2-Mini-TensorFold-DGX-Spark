+__device__ __forceinline__ float softcap_swiglu(float g, float u, float gate_cap, float up_cap) {
+  const float gc = gate_cap * tanhf(g / gate_cap);
+  const float uc = up_cap * tanhf(u / up_cap);
+  const float sig = 1.f / (1.f + expf(-g));
+  return gc * sig * uc;
+}
