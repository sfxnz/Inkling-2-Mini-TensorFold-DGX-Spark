+/// Fused BF16 round + tanh(x / cap) * cap over `n` fp32 logits in place.
+pub fn roundSoftcap(k: *const Kernels, s: cuda.Stream, x: u64, n: usize, cap: f32) !void {
+    var a: cuda.Args = .{};
+    a.add(x);
+    a.add(@as(i64, @intCast(n)));
+    a.add(cap);
+    try go(k.round_softcap, s, .{ .x = @intCast((n + 255) / 256) }, 256, &a);
+}
+
+/// Lossless row-major BF16 Tensor Core unembed [rows, k] x [vocab, k]^T with fused BF16-round + softcap epilogue.
+pub fn unembedTc(k: *const Kernels, s: cuda.Stream, x: u64, w: u64, out: u64, rows: usize, vocab: usize, hidden: usize, cap: f32) !void {
+    var a: cuda.Args = .{};
+    for ([_]u64{ x, w, out }) |v| a.add(v);
+    for ([_]i32{ int(rows), int(vocab), int(hidden) }) |v| a.add(v);
+    a.add(cap);
+    if (rows <= 16) {
+        try go(k.unembed_tc16, s, .{ .x = 1, .y = @intCast((vocab + 31) / 32) }, 128, &a);
+    } else {
+        try go(k.unembed_tc32, s, .{ .x = @intCast((rows + 31) / 32), .y = @intCast((vocab + 31) / 32) }, 128, &a);
+    }
+}
+
 /// Each of `rows` fp32 rows (`stride` apart): its largest value among the first `n` (lowest id on ties), id + `base`.
 pub fn top1(k: *const Kernels, s: cuda.Stream, x: u64, rows: usize, stride: usize, n: usize, base: usize, val: u64, id: u64) !void {
     var a: cuda.Args = .{};
