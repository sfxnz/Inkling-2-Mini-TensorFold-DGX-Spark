+    /// Batch all sampled verify rows into one BF16 cast + sliced drawRows using post-forward m.s.raw scratch.
+    fn drawSampledBatch(b: *Backend, windows: []const be.Window, chains: []const round.Chain, rows: usize, v: usize) !bool {
+        const raw_bytes = 3 * b.m.promptRows() * b.m.w.c.text.hidden * 4;
+        const rules_off: usize = 0;
+        const meta_off: usize = std.mem.alignForward(usize, rows * @sizeOf(cuda.sample.Rule), 256);
+        const scratch_off: usize = std.mem.alignForward(usize, meta_off + rows * 4, 256);
+        const logits16_off: usize = std.mem.alignForward(usize, scratch_off + rows * cuda.sample.Draws.row_scratch, 256);
+        const need = logits16_off + rows * v * 2;
+        if (need > raw_bytes) return false;
+        var rules_host: [engine.round_rows]cuda.sample.Rule = undefined;
+        var meta_host: [engine.round_rows]i32 = undefined;
+        var row: usize = 0;
+        for (windows, chains) |w, chain| {
+            const l = &b.lanes_[chain.slot].?;
+            for (w.positions) |pos| {
+                rules_host[row] = l.rule_host;
+                meta_host[row] = @intCast(pos - 1);
+                row += 1;
+            }
+        }
+        const base = b.m.s.raw;
+        try b.upload(base + rules_off, std.mem.sliceAsBytes(rules_host[0..rows]));
+        try b.upload(base + meta_off, std.mem.sliceAsBytes(meta_host[0..rows]));
+        try ops.tobf(&b.k.glue, b.s, b.m.s.logits, rows, v, v, base + logits16_off, v, 0, v);
+        try b.k.draws.drawRows(b.s, base + logits16_off, v, base + rules_off, base + meta_off, b.tokens.ptr + token_ring * 4, rows, base + scratch_off);
+        return true;
+    }
+
     fn read(ptr: *anyopaque, h: u64) anyerror!u32 {
         const b = self(ptr);
         if (h >= b.next or b.next - h > token_ring) return error.NoSuchToken;
@@ -598,6 +628,11 @@ pub const Backend = struct {
         }
