+                    .src = from,
+                    .bytes = n * dspark.tap_stride,
+                };
+                n_taps += 1;
             }
-            const src = b.m.s.logits + row0 * v * 4;
-            if (w.masks.len == 0)
-                try b.drawRows(l, src, n, w.positions[0], token_ring + row0)
-            else
-                try b.drawMasked(w.stream, src, w.positions, token_ring + row0, w.masks);
+            if (w.masks.len != 0 or l.sampled) all_unmasked_greedy = false;
+            if (w.masks.len != 0 or !l.sampled) all_unmasked_sampled = false;
             row0 += n;
         }
+        if (n_taps == 1) {
+            try b.m.copy(b.s, tap_spans[0].dst, tap_spans[0].src, @intCast(tap_spans[0].bytes));
+        } else if (n_taps > 1) {
+            try b.upload(b.m.s.copy_spans, std.mem.sliceAsBytes(tap_spans[0..n_taps]));
+            try loop_math.copySpans(&b.k.loop, b.s, b.m.s.copy_spans, n_taps);
+        }
+        if (all_unmasked_greedy) {
+            try ops.top1(&b.k.glue, b.s, b.m.s.logits, rows, v, v, 0, b.m.s.t + token_ring * 4, b.tokens.ptr + token_ring * 4);
+        } else if (all_unmasked_sampled and try b.drawSampledBatch(windows, chains[0..windows.len], rows, v)) {
+            // Batched BF16 conversion + sliced top-k draw across all sampled rows in m.s.raw scratch.
+        } else {
+            row0 = 0;
+            for (windows, chains[0..windows.len]) |w, chain| {
+                const l = &b.lanes_[chain.slot].?;
+                const n = chain.tokens.len;
+                const src = b.m.s.logits + row0 * v * 4;
+                if (w.masks.len == 0)
+                    try b.drawRows(l, src, n, w.positions[0], token_ring + row0)
+                else
+                    try b.drawMasked(w.stream, src, w.positions, token_ring + row0, w.masks);
+                row0 += n;
+            }
+        }
         var got: [engine.round_rows]u32 = undefined;
         try b.s.synchronize();
         try b.tokens.download(token_ring * 4, std.mem.sliceAsBytes(got[0..rows]));
