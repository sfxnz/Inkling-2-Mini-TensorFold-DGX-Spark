 }
+
+// Fused BF16 round + FP32 logit softcap in place (A9(a) boundary).
+extern "C" __global__ void __launch_bounds__(256) tf_ink2_round_softcap(float* __restrict__ x, long long n, float cap) {
+    const long long i = static_cast<long long>(blockIdx.x) * blockDim.x + threadIdx.x;
+    if (i < n) x[i] = logitCap(bfr(x[i]), cap);
+}
+
+namespace ink2u {
+
+// Lossless BF16 Tensor Core unembed directly on row-major [vocab, k] with fused A9(a) BF16-round + softcap epilogue.
+template <int BM>
+__device__ __forceinline__ void unembedTc(const uint16_t* __restrict__ x, const uint16_t* __restrict__ w,
+                                          float* __restrict__ out, int rows, int vocab, int k, float cap) {
+    constexpr int kBN = 32;
+    constexpr int kBK = 64;
+    constexpr int kPad = kBK + 8;
+    constexpr int kMT = BM / 16;
+    __shared__ __align__(16) uint16_t sx[2][BM][kPad];
+    __shared__ __align__(16) uint16_t sw[2][kBN][kPad];
+    const int m0 = static_cast<int>(blockIdx.x) * BM;
+    const int n0 = static_cast<int>(blockIdx.y) * kBN;
+    const int tid = threadIdx.x;
+    const int warp = tid >> 5, lane = tid & 31, g = lane >> 2, t = lane & 3;
+    const int num_k = k / kBK;
+
+    auto loadStage = [&](int st, int k0) {
+#pragma unroll
+        for (int e = tid; e < BM * (kBK / 8); e += 128) {
+            const int r = e >> 3, c = (e & 7) * 8;
+            const bool ok = m0 + r < rows;
+            const uint16_t* src = ok ? (x + static_cast<size_t>(m0 + r) * k + k0 + c) : x;
+            tf_common::cp16z(&sx[st][r][c], src, ok);
+        }
+#pragma unroll
+        for (int e = tid; e < kBN * (kBK / 8); e += 128) {
+            const int r = e >> 3, c = (e & 7) * 8;
+            const bool ok = n0 + r < vocab;
+            const uint16_t* src = ok ? (w + static_cast<size_t>(n0 + r) * k + k0 + c) : w;
+            tf_common::cp16z(&sw[st][r][c], src, ok);
+        }
+    };
+
+    float acc[kMT][4];
+#pragma unroll
+    for (int mt = 0; mt < kMT; ++mt) acc[mt][0] = acc[mt][1] = acc[mt][2] = acc[mt][3] = 0.0f;
+
+    loadStage(0, 0);
+    tf_common::cp_commit();
+    for (int st = 0; st < num_k; ++st) {
+        const int cur = st & 1;
+        if (st + 1 < num_k) {
+            loadStage(cur ^ 1, (st + 1) * kBK);
+            tf_common::cp_commit();
+            tf_common::cp_wait<1>();
+        } else {
+            tf_common::cp_wait<0>();
+        }
+        __syncthreads();
+        const uint16_t* wrow = &sw[cur][warp * 8 + g][2 * t];
+#pragma unroll
+        for (int kk = 0; kk < 4; ++kk) {
+            const uint32_t b0 = *reinterpret_cast<const uint32_t*>(wrow + 16 * kk);
+            const uint32_t b1 = *reinterpret_cast<const uint32_t*>(wrow + 16 * kk + 8);
+#pragma unroll
+            for (int mt = 0; mt < kMT; ++mt) {
+                const uint32_t* x0 = reinterpret_cast<const uint32_t*>(&sx[cur][mt * 16 + g][16 * kk + 2 * t]);
+                const uint32_t* x1 = reinterpret_cast<const uint32_t*>(&sx[cur][mt * 16 + g + 8][16 * kk + 2 * t]);
+                const uint32_t a[4] = {x0[0], x1[0], x0[4], x1[4]};
+                qmm_frag::mma(acc[mt], a, b0, b1);
+            }
+        }
+        __syncthreads();
+    }
+    const int c0 = n0 + warp * 8 + 2 * t;
+    const int c1 = c0 + 1;
+#pragma unroll
+    for (int mt = 0; mt < kMT; ++mt) {
+        const int r0 = m0 + mt * 16 + g;
+        const int r1 = r0 + 8;
+        if (r0 < rows) {
+            if (c0 < vocab) out[static_cast<size_t>(r0) * vocab + c0] = cap > 0.0f ? logitCap(bfr(acc[mt][0]), cap) : bfr(acc[mt][0]);
+            if (c1 < vocab) out[static_cast<size_t>(r0) * vocab + c1] = cap > 0.0f ? logitCap(bfr(acc[mt][1]), cap) : bfr(acc[mt][1]);
+        }
+        if (r1 < rows) {
+            if (c0 < vocab) out[static_cast<size_t>(r1) * vocab + c0] = cap > 0.0f ? logitCap(bfr(acc[mt][2]), cap) : bfr(acc[mt][2]);
+            if (c1 < vocab) out[static_cast<size_t>(r1) * vocab + c1] = cap > 0.0f ? logitCap(bfr(acc[mt][3]), cap) : bfr(acc[mt][3]);
+        }
+    }
+}
+
+}  // namespace ink2u
+
+extern "C" __global__ void __launch_bounds__(128)
+    tf_ink2_unembed_tc16(const uint16_t* __restrict__ x, const uint16_t* __restrict__ w, float* __restrict__ out,
+                         int rows, int vocab, int k, float cap) {
+    ink2u::unembedTc<16>(x, w, out, rows, vocab, k, cap);
+}
+
+extern "C" __global__ void __launch_bounds__(128)
+    tf_ink2_unembed_tc32(const uint16_t* __restrict__ x, const uint16_t* __restrict__ w, float* __restrict__ out,
+                         int rows, int vocab, int k, float cap) {
+    ink2u::unembedTc<32>(x, w, out, rows, vocab, k, cap);
+}
 #include "decode_head.cuh"
 
