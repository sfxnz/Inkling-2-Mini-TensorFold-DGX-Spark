+// Small-M row-tiled gateDown: shares down across up to RT prepared rows per block with exact 256-thread reduction order.
+template <int RT>
+__device__ void gateDownTiled(const uint16_t* __restrict__ prepared, const uint16_t* __restrict__ down,
+                              uint16_t* __restrict__ zeta, int rows, int c) {
+    __shared__ float sh[2 * RT * 32];
+    const int row0 = static_cast<int>(blockIdx.x) * RT;
+    const int r = 2 * static_cast<int>(blockIdx.y);
+    const int width = 2 * c;
+    const int active = rows - row0 < RT ? rows - row0 : RT;
+    const uint16_t* d0 = down + static_cast<size_t>(r) * width;
+    const uint16_t* d1 = d0 + width;
+    float acc[2 * RT];
+#pragma unroll
+    for (int k = 0; k < 2 * RT; ++k) acc[k] = 0.0f;
+    if (active == RT) {
+        for (int i = threadIdx.x; i < width; i += blockDim.x) {
+            const float w0 = bf(__ldg(d0 + i));
+            const float w1 = bf(__ldg(d1 + i));
+#pragma unroll
+            for (int k = 0; k < RT; ++k) {
+                const float n = bf(__ldg(prepared + static_cast<size_t>(row0 + k) * width + i));
+                acc[2 * k] = __fmaf_rn(w0, n, acc[2 * k]);
+                acc[2 * k + 1] = __fmaf_rn(w1, n, acc[2 * k + 1]);
+            }
+        }
+    } else {
+        for (int i = threadIdx.x; i < width; i += blockDim.x) {
+            const float w0 = bf(__ldg(d0 + i));
+            const float w1 = bf(__ldg(d1 + i));
+            for (int k = 0; k < active; ++k) {
+                const float n = bf(__ldg(prepared + static_cast<size_t>(row0 + k) * width + i));
+                acc[2 * k] = __fmaf_rn(w0, n, acc[2 * k]);
+                acc[2 * k + 1] = __fmaf_rn(w1, n, acc[2 * k + 1]);
+            }
+        }
+    }
+    blockSums<2 * RT>(acc, sh);
+    if (threadIdx.x == 0) {
+        for (int k = 0; k < active; ++k) {
+            zeta[static_cast<size_t>(row0 + k) * kRank + r] = tobf(acc[2 * k]);
+            zeta[static_cast<size_t>(row0 + k) * kRank + r + 1] = tobf(acc[2 * k + 1]);
+        }
+    }
+}
+
