 __device__ void gateUp(const float* h, const float* __restrict__ m, const uint16_t* __restrict__ zeta,
                        const uint16_t* __restrict__ forget, const uint16_t* __restrict__ gain, float* out, int c) {
@@ -610,6 +655,12 @@ extern "C" __global__ void __launch_bounds__(256)
     ink2l::gateDownPrepared(prepared, down, zeta, rows, c);
 }
 
+extern "C" __global__ void __launch_bounds__(256)
+    tf_ink2_loop_gate_down_tiled(const uint16_t* __restrict__ prepared, const uint16_t* __restrict__ down,
+                                 uint16_t* __restrict__ zeta, int rows, int c) {
+    ink2l::gateDownTiled<8>(prepared, down, zeta, rows, c);
+}
