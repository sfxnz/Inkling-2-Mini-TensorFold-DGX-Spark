+/// Normalize each row once, then share down across up to 8 rows per block and 32 rank-pair blocks.
+pub fn gateDownTiled(
+    k: *const Kernels,
+    s: cuda.Stream,
+    state: u64,
+    message: u64,
+    prepared: u64,
+    down: u64,
+    zeta: u64,
+    rows: usize,
+    c: usize,
+    eps: f32,
+) !void {
+    if (rows == 0 or c == 0) return error.Inkling2LoopGateShape;
+    var a: cuda.Args = .{};
+    for ([_]u64{ state, message, prepared }) |v| a.add(v);
+    a.add(int(c));
+    a.add(eps);
+    try go(k.gate_prepare_fn, s, .{ .x = @intCast(rows) }, 256, &a);
+
+    var b: cuda.Args = .{};
+    for ([_]u64{ prepared, down, zeta }) |v| b.add(v);
+    b.add(int(rows));
+    b.add(int(c));
+    try go(k.gate_down_tiled_fn, s, .{ .x = @intCast((rows + 7) / 8), .y = rank / 2 }, 256, &b);
+}
+
