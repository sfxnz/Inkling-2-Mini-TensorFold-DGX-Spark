+    if (!a.query && a.nq == 1 && !a.partial_bf16 && C <= 5 * 512) {
+        // Post-gate RMSNorm fast path: single global read into 5 registers/thread with identical reduction order.
+        float hc[5];
+        float s[1] = {0.0f};
+        const float* src = static_cast<const float*>(a.partial) + row * C;
+#pragma unroll
+        for (int k = 0; k < 5; ++k) {
+            const int c = threadIdx.x + k * 512;
+            float h = 0.0f;
+            if (c < C) {
+                h = src[c];
+                s[0] += h * h;
+            }
+            hc[k] = h;
+        }
+        blockSums<1>(s, sh);
+        const float r = rsqrtf(s[0] / C + a.eps);
+        uint16_t* o = a.out + row * C;
+#pragma unroll
+        for (int k = 0; k < 5; ++k) {
+            const int c = threadIdx.x + k * 512;
+            if (c < C) o[c] = tobf(bf(a.norm[0][c]) * (hc[k] * r));
+        }
+        return;
+    }
     if (a.query) {
         for (int j = 0; j < n; ++j) {
             float ss[1] = {0.0f};
