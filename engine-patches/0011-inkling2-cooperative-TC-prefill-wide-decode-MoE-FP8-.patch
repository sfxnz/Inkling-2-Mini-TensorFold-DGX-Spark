+// Cooperative 4-warp BN=128 block-scaled tensor-core GEMM for 64-row prompt tiles: all 4 warps share sx_c/sx_s/s_tok.
+template <int FMT>
+__device__ __forceinline__ void prompt_tc_coop(const uint8_t* __restrict__ xc, const uint8_t* __restrict__ xsc,
+                                               int x_stride, int slots, Weight w, int KG, int NB,
+                                               const int* __restrict__ items, const int* __restrict__ item_count,
+                                               const int* __restrict__ members, void* __restrict__ out, int N,
+                                               int skip) {
+  const int tid = threadIdx.x;
+  const int warp = tid >> 5, lane = tid & 31, gq = lane >> 2, t = lane & 3;
+  const int nb_groups = (NB + 3) >> 2;
+  const int units = __ldg(item_count) * nb_groups;
+  __shared__ __align__(16) uint4 sx_c[2][64][2];
+  __shared__ __align__(16) uint32_t sx_s[2][64];
+  __shared__ __align__(16) uint4 sw_c[2][4][32][2];
+  __shared__ __align__(16) uint32_t sw_s[2][4][32];
+  __shared__ int s_tok[64];
+  const int c_stride = FMT == 0 ? (x_stride >> 1) : x_stride;
+  const int s_stride = FMT == 0 ? (x_stride >> 4) : (x_stride >> 5);
+  const int steps = FMT == 0 ? (KG >> 1) : KG;
+  for (int unit = blockIdx.x; unit < units; unit += gridDim.x) {
+    const int it = unit / nb_groups, cb_grp = unit - it * nb_groups;
+    const int cb = (cb_grp << 2) + warp;
+    const bool valid_cb = cb < NB;
+    const int e = __ldg(items + 3 * it), first = __ldg(items + 3 * it + 1), cnt = __ldg(items + 3 * it + 2);
+    if (e == skip) continue;
+    const float outer = FMT == 0 ? outer_of(w, e) : 1.0f;
+    bool v[4][2];
+    int pr[4][2];
+#pragma unroll
+    for (int r = 0; r < 4; ++r)
+#pragma unroll
+      for (int h = 0; h < 2; ++h) {
+        const int i = 16 * r + gq + 8 * h;
+        v[r][h] = i < cnt;
+        pr[r][h] = v[r][h] ? __ldg(members + first + i) : 0;
+      }
+    if (tid < 64) {
+      if (tid < cnt) {
+        const int p = __ldg(members + first + tid);
+        s_tok[tid] = slots ? (p / slots) : p;
+      } else {
+        s_tok[tid] = -1;
+      }
+    }
+    __syncthreads();
+    auto load_stage = [&](int s, int g) {
+      {
+        const int rr = tid >> 1, cc = tid & 1;
+        const int tok = s_tok[rr];
+        const int safe_tok = tok >= 0 ? tok : 0;
+        tf_common::cp16z(&sx_c[s][rr][cc],
+                         xc + static_cast<size_t>(safe_tok) * c_stride + static_cast<size_t>(g) * 32 + 16 * cc,
+                         tok >= 0);
+      }
+      if (tid < 64) {
+        const int tok = s_tok[tid];
+        if (tok >= 0) {
+          if constexpr (FMT == 0) {
+            sx_s[s][tid] = __ldg(reinterpret_cast<const uint32_t*>(xsc + static_cast<size_t>(tok) * s_stride + g * 4));
+          } else {
+            sx_s[s][tid] = static_cast<uint32_t>(__ldg(xsc + static_cast<size_t>(tok) * s_stride + g));
+          }
+        } else {
+          sx_s[s][tid] = 0u;
+        }
+      }
+      if (valid_cb) {
+#pragma unroll
+        for (int i = 0; i < 2; ++i) {
+          const int q = lane + 32 * i, lr = q >> 1, cc = q & 1;
+          const long long row = w.row0 + w.row_step * (cb * 32 + lr);
+          const long long z = (e * w.N + row) * w.K + (FMT == 0 ? 64LL : 32LL) * g;
+          tf_common::cp16(&sw_c[s][warp][lr][cc], w.codes + (FMT == 0 ? z / 2 : z) + 16 * cc);
+        }
+        {
+          const long long row = w.row0 + w.row_step * (cb * 32 + lane);
+          const long long z = (e * w.N + row) * w.K + (FMT == 0 ? 64LL : 32LL) * g;
+          if constexpr (FMT == 0) {
+            sw_s[s][warp][lane] = __ldg(reinterpret_cast<const uint32_t*>(w.scales + z / 16));
+          } else {
+            sw_s[s][warp][lane] = static_cast<uint32_t>(__ldg(w.scales + z / 32));
+          }
+        }
+      }
+    };
+    float acc[1][4][4][4];
+#pragma unroll
+    for (int r = 0; r < 4; ++r)
+#pragma unroll
+      for (int j = 0; j < 4; ++j) acc[0][r][j][0] = acc[0][r][j][1] = acc[0][r][j][2] = acc[0][r][j][3] = 0.f;
+    if (steps > 0) {
+      load_stage(0, 0);
+      tf_common::cp_commit();
+    }
+    for (int g = 0; g < steps; ++g) {
+      const int cur = g & 1;
+      if (g + 1 < steps) {
+        load_stage(cur ^ 1, g + 1);
+        tf_common::cp_commit();
+        tf_common::cp_wait<1>();
+      } else {
+        tf_common::cp_wait<0>();
+      }
+      __syncthreads();
+      if (valid_cb) {
+        uint32_t a[4][4], sa[4];
+#pragma unroll
+        for (int r = 0; r < 4; ++r) {
+          const int r0 = 16 * r;
+          const uint32_t* p0 = reinterpret_cast<const uint32_t*>(&sx_c[cur][r0 + gq][0]);
+          const uint32_t* p1 = reinterpret_cast<const uint32_t*>(&sx_c[cur][r0 + gq + 8][0]);
+          a[r][0] = p0[t];
+          a[r][1] = p1[t];
+          a[r][2] = p0[4 + t];
+          a[r][3] = p1[4 + t];
+          sa[r] = (t & 1) ? sx_s[cur][r0 + gq + 8] : sx_s[cur][r0 + gq];
+        }
+#pragma unroll
+        for (int j = 0; j < 4; ++j) {
+          const uint32_t* wp = reinterpret_cast<const uint32_t*>(&sw_c[cur][warp][8 * j + gq][0]);
+          const uint32_t b0 = wp[t], b1 = wp[4 + t];
+          const uint32_t sb = sw_s[cur][warp][8 * j + gq];
+          if constexpr (FMT == 0) {
+#pragma unroll
+            for (int r = 0; r < 4; ++r) mma4::mma_fp4(acc[0][r][j], a[r], b0, b1, sa[r], sb);
+          } else {
+#pragma unroll
+            for (int r = 0; r < 4; ++r) mma_mxfp8(acc[0][r][j], a[r], b0, b1, sa[r], sb);
+          }
+        }
+      }
+      __syncthreads();
+    }
+    if (valid_cb) {
+      if constexpr (FMT == 0) {
+#pragma unroll
+        for (int r = 0; r < 4; ++r)
+#pragma unroll
+          for (int j = 0; j < 4; ++j)
+#pragma unroll
+            for (int q = 0; q < 4; ++q) acc[0][r][j][q] *= outer;
+      }
+#pragma unroll
+      for (int r = 0; r < 4; ++r)
+        store<4, 4>(acc, r, out, nullptr, N, cb * 32 + 2 * t, pr[r][0], pr[r][1], v[r][0], v[r][1]);
+    }
+    __syncthreads();
+  }
+}
