+// Fused multi-step candidate selector with bit-exact keyed Gumbel race and per-step softmax chances.
+// Adapted from MiaAI-Lab patch 0018 (commit 9e3cf20b). Copyright 2026 MiaAI-Lab.
 template <typename Book>
 __device__ __forceinline__ void ink2DfSelectBatch(
     const unsigned* __restrict__ top, const uint16_t* __restrict__ projected,
     const Book* __restrict__ predecessor, const Book* __restrict__ successor,
     const float* __restrict__ prev_scales, const float* __restrict__ next_scales,
-    unsigned* __restrict__ walk, long long* __restrict__ ids, uint16_t* __restrict__ logits,
+    unsigned* __restrict__ walk, float* __restrict__ chances,
+    const ink2df::DraftKey* __restrict__ keys,
     const int* __restrict__ row_offs, const int* __restrict__ stream_ns,
-    int step, int vocab, float cap) {
+    int vocab, float cap) {
+    using namespace ink2d;
     using namespace ink2df;
+    __shared__ float scores[kTop];
+    __shared__ unsigned cand_ids[kTop];
+    __shared__ unsigned parent_s;
     const int s = blockIdx.x;
-    if (step >= stream_ns[s]) return;
-    ink2DfSelect(
-        top + static_cast<size_t>(row_offs[s]) * kLogprobWords,
-        projected + static_cast<size_t>(row_offs[s]) * kRank,
-        predecessor,
-        successor,
-        prev_scales,
-        next_scales,
-        walk + static_cast<size_t>(s) * 8,
-        ids + static_cast<size_t>(s) * kTop,
-        logits + static_cast<size_t>(s) * kTop,
-        step,
-        vocab,
-        cap);
+    const int n = stream_ns[s];
+    const int row0 = row_offs[s];
+    const int candidate = threadIdx.x >> 5, lane = threadIdx.x & 31;
+    unsigned* my_walk = walk + static_cast<size_t>(s) * 8;
+    float* my_chances = chances + static_cast<size_t>(s) * 7;
+    const DraftKey key = keys != nullptr ? keys[s] : DraftKey{0, 0.0f, 0};
+    if (threadIdx.x == 0) parent_s = my_walk[0];
+    __syncthreads();
+    for (int step = 0; step < n; ++step) {
+        const unsigned* entries = top + static_cast<size_t>(row0 + step) * kLogprobWords;
+        const unsigned id = entries[2 + candidate];
+        const unsigned parent = parent_s;
+        float score = -INFINITY;
+        if (id < static_cast<unsigned>(vocab) && parent < static_cast<unsigned>(vocab)) {
+            float correction = 0.0f;
+            const float ps = sizeof(Book) == 1 ? prev_scales[parent] : 1.0f;
+            const float ss = sizeof(Book) == 1 ? next_scales[id] : 1.0f;
+            for (int j = lane; j < kRank; j += 32) {
+                const Book a = predecessor[static_cast<size_t>(parent) * kRank + j];
+                const Book b = successor[static_cast<size_t>(id) * kRank + j];
+                const float p = sizeof(Book) == 1 ? bfr(fp8Value(a) * ps) : bf(a);
+                const float q = sizeof(Book) == 1 ? bfr(fp8Value(b) * ss) : bf(b);
+                const float h = bf(projected[static_cast<size_t>(row0 + step) * kRank + j]);
+                correction += bfr(p * h) * q;
+            }
+            correction = tf_common::warp_sum(correction);
+            const float unary = __uint_as_float(entries[2 + kLogprobTop + candidate]);
+            const float corrected = bfr(unary + bfr(correction));
+            score = bfr(cap * tanhf(corrected / cap));
+        }
+        if (lane == 0) {
+            scores[candidate] = score;
+            cand_ids[candidate] = id;
+        }
+        __syncthreads();
+        if (threadIdx.x == 0) {
+            float mx = -INFINITY;
+            for (int i = 0; i < kTop; ++i)
+                if (isfinite(scores[i]) && scores[i] > mx) mx = scores[i];
+            int best = 0;
+            if (key.inv_t > 0.0f) {
+                float best_v = -INFINITY;
+                for (int i = 0; i < kTop; ++i) {
+                    if (!isfinite(scores[i])) continue;
+                    const float u = race_u(key.seed, key.pos + static_cast<unsigned>(step), cand_ids[i]);
+                    const float v = scores[i] * key.inv_t - logf(-logf(u));
+                    if (v > best_v) {
+                        best_v = v;
+                        best = i;
+                    }
+                }
+            } else {
+                for (int i = 1; i < kTop; ++i)
+                    if (scores[i] > scores[best]) best = i;
+            }
+            float prob = 0.0f;
+            if (isfinite(scores[best]) && isfinite(mx)) {
+                float z = 0.0f;
+                for (int i = 0; i < kTop; ++i)
+                    if (isfinite(scores[i])) z += expf(scores[i] - mx);
+                if (z > 0.0f) prob = expf(scores[best] - mx) / z;
+            }
+            const unsigned picked = isfinite(scores[best]) ? cand_ids[best] : static_cast<unsigned>(vocab);
+            my_walk[step + 1] = picked;
+            my_chances[step] = prob;
+            parent_s = picked;
+        }
+        __syncthreads();
+    }
 }
 
