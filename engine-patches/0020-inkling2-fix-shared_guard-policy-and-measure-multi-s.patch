+    /// Time a diverged multi-stream verify forward on `streams` slots x `per_stream` rows with distinct token IDs.
+    fn priceMulti(b: *Backend, g: *graph.Graphs, io: std.Io, streams: usize, per_stream: usize, lazy: bool, samples: usize) !f64 {
+        const vocab: usize = b.m.w.c.text.unpadded_vocab;
+        var toks: [4][window_rows]u32 = undefined;
+        var chains: [4]round.Chain = undefined;
+        for (0..streams) |slot| {
+            for (0..per_stream) |j| {
+                toks[slot][j] = @intCast((1000 + slot * 4099 + j * 131) % vocab);
+            }
+            chains[slot] = .{ .slot = slot, .position = 0, .tokens = toks[slot][0..per_stream], .record = per_stream > 1 };
+        }
+        const total_rows = streams * per_stream;
+        const saved_slot = b.m.slot;
+        defer b.m.slot = saved_slot;
+        for (0..streams) |slot| {
+            b.m.slot = slot;
+            try b.m.reset(b.s);
+        }
+        // Warm and capture graph once before timing replays.
+        try g.forward(b.m, b.k, b.s, chains[0..streams], total_rows, true, lazy);
