+test "uniform shared mode dampens spikes, rescales on plain jump, and honors stream floor" {
+    const a = std.testing.allocator;
+    var prices: Prices = .{ .streams = 4, .sampled = false, .batched = true, .block_costs = .{} };
+    defer prices.block_costs.?.deinit(a);
+    try prices.observe(a, 4, 16);
+    try prices.observe(a, 12, 95); // capture ignored
+    try prices.observe(a, 12, 36); // replay: ratio = 2.25
+    try prices.observe(a, 12, 90); // graph-miss spike dampened
+    try std.testing.expect(prices.block_costs.?.get(8).? < 2.45);
+    // Plain jumps from 16 -> 32 on divergence: plain_ms moves to 24 and block_costs rescales down.
+    try prices.observe(a, 4, 32);
+    try std.testing.expectApproxEqAbs(@as(f64, 24), prices.plain_ms.?, 1e-9);
+    try std.testing.expect(prices.block_costs.?.get(8).? * prices.plain_ms.? < 40);
+
+    var prior: Table = .{};
+    defer prior.deinit(a);
+    try prior.put(a, 12, 36.0);
+    try prior.put(a, 16, 39.0);
+    // At plain=31.5 and measured costs[8]=36/31.5, d=3 uses prior ratio 39/36.
+    var measured: Table = .{};
+    defer measured.deinit(a);
+    try measured.put(a, 8, 36.0 / 31.5);
+    try std.testing.expectApproxEqAbs(@as(f64, 39.0), forwardMsPrior(measured, &prior, 4, 12, 31.5, 5.0), 1e-9);
+
+    const strong = [_]f64{ 0.85, 0.70, 0.55 };
+    const mild = [_]f64{ 0.30, 0.15, 0.05 };
+    const very_weak = [_]f64{ 0.01, 0.0, 0.0 };
+    var out: [4]i64 = @splat(0);
+    // With floor=0.85, mild stream (expected ~1.45 vs 41/31.5*0.85=1.11) passes and uniform d>0 wins aggregate.
+    try chooseUniform(a, &.{ &strong, &strong, &strong, &mild }, 12, 31.5, 1.0, 5.0, measured, &prior, 0.85, &out);
+    try std.testing.expect(out[0] > 0 and out[0] == out[1] and out[1] == out[2] and out[2] == out[3]);
+    // With a very weak stream (expected ~1.06 < 41/31.5*0.85=1.11), floor vetoes drafting.
+    out = @splat(0);
+    try chooseUniform(a, &.{ &strong, &strong, &strong, &very_weak }, 12, 31.5, 1.0, 5.0, measured, &prior, 0.85, &out);
+    try std.testing.expectEqualSlices(i64, &.{ 0, 0, 0, 0 }, &out);
+}
