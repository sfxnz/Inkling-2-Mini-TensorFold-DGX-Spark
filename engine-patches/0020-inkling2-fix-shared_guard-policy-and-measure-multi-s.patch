+/// Uniform-depth selection for batched fixed-block drafters: keeps verify_cache shapes minimal (1 key per depth)
+/// and maximizes aggregate tokens/ms subject to a softer per-stream floor so one unlucky stream cannot veto all streams.
+fn chooseUniform(a: std.mem.Allocator, chances: []const []const f64, room: usize, plain_ms: f64, row_ms: f64, head_ms: f64, costs: Table, prior: ?*const Table, floor: f64, out: []i64) !void {
+    if (chances.len == 0 or room == 0) return;
+    const taken = try a.alloc(i64, chances.len);
+    defer a.free(taken);
+    const tokens = try a.alloc(f64, chances.len);
+    defer a.free(tokens);
+    var max_len: usize = 0;
+    for (chances) |p| max_len = @max(max_len, p.len);
+    const plain_rate = @as(f64, @floatFromInt(chances.len)) / plain_ms;
+    var best = plain_rate * 1.01;
+    var d: usize = 1;
+    while (d <= max_len) : (d += 1) {
+        var extra: usize = 0;
+        var sum: f64 = 0;
+        var any_head = false;
+        for (chances, taken, tokens) |p, *tk, *tok| {
+            const n = @min(d, p.len);
+            tk.* = @intCast(n);
+            extra += n;
+            if (n > 0) any_head = true;
+            var expected: f64 = 1.0;
+            for (p[0..n]) |chance| expected += chance;
+            tok.* = expected;
+            sum += expected;
+        }
+        if (!any_head or extra > room) break;
+        const ms = forwardMsPrior(costs, prior, chances.len, extra, plain_ms, row_ms) + head_ms;
+        const rate = sum / ms;
+        if (rate <= best) continue;
+        for (tokens) |expected| {
+            if (expected * plain_ms < ms * floor) break;
+        } else {
+            best = rate;
+            @memcpy(out, taken);
+        }
+    }
+}
