@@ -0,0 +1,73 @@
+//! The CUDA kernels owned by one Mini modelOpt model, including qmmf dense projections.
+const std = @import("std");
+const cuda = @import("cuda");
+const ops = @import("ops.zig");
+const attention = @import("kernels.zig");
+const modelopt = @import("modelopt.zig");
+const loop_math = @import("loop_math_cuda.zig");
+const weights = @import("loop_weights.zig");
+
+pub const Kernels = struct {
+    glue: ops.Kernels,
+    attn: attention.Kernels,
+    moe: modelopt.Kernels,
+    qmmf: cuda.qmmf.Lane,
+    loop: loop_math.Kernels,
+    sample_mod: cuda.Module,
+    draws: cuda.sample.Draws,
+
+    pub fn load(ctx: *const cuda.Context) !Kernels {
+        const d = ctx.d;
+        var glue = try ops.Kernels.load(d);
+        errdefer glue.unload();
+        var attn = try attention.Kernels.load(d);
+        errdefer attn.unload();
+        var moe = try modelopt.Kernels.load(d, @intCast(try ctx.attribute(.multiprocessor_count)));
+        errdefer moe.unload();
+        const cap = try ctx.capability();
+        var qmmf = try cuda.qmmf.Lane.load(d, cap / 10);
+        errdefer qmmf.unload();
+        try qmmf.loadPrompt(d);
+        var lm = try loop_math.Kernels.load(d);
+        errdefer lm.unload();
+        var sample_mod = try cuda.Module.load(d, cuda.kernels.sample);
+        errdefer sample_mod.unload();
+        return .{
+            .glue = glue,
+            .attn = attn,
+            .moe = moe,
+            .qmmf = qmmf,
+            .loop = lm,
+            .sample_mod = sample_mod,
+            .draws = try cuda.sample.Draws.resolve(sample_mod),
+        };
+    }
+
+    pub fn maxPartBytes(k: *const Kernels, layers: []const weights.Layer, max_rows: usize) usize {
+        var best: usize = 0;
+        const probe_rows = [_]usize{ 1, 16, 32, 64, max_rows };
+        for (layers) |layer| {
+            const q = layer.attn.qmmf orelse continue;
+            for ([_]cuda.qmmf.Weight{ q.wq, q.wk, q.wv, q.wo, q.gate, q.wr }) |w| {
+                for (probe_rows) |m| if (m <= max_rows) {
+                    best = @max(best, k.qmmf.partBytes(m, w));
+                };
+            }
+        }
+        return best;
+    }
+
+    pub fn projectQmmf(k: *const Kernels, s: cuda.Stream, w: cuda.qmmf.Weight, x: u64, rows: usize, out: u64, part: u64) !void {
+        try k.qmmf.matmul(s, x, w.k, rows, w, out, part);
+    }
+
+    pub fn deinit(k: *Kernels) void {
+        k.sample_mod.unload();
+        k.loop.unload();
+        k.qmmf.unload();
+        k.moe.unload();
+        k.attn.unload();
+        k.glue.unload();
+        k.* = undefined;
+    }
+};
