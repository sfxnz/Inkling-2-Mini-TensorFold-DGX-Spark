+/// Pack row-major BF16 [n, k] into qmmf's [npad/64][k/64][8][4][32][4] layout.
+pub fn packQmmfBf16(k: *const Kernels, s: cuda.Stream, src: u64, dst: u64, n: usize, k_dim: usize) !void {
