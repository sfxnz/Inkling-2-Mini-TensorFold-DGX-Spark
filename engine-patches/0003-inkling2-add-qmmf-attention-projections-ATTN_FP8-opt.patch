+// Pack row-major BF16 [n, k] into qmmf's [npad/64][k/64][8][4][32][4] layout.
+extern "C" __global__ void __launch_bounds__(256)
+    tf_ink2_pack_qmmf_bf16(const uint16_t* __restrict__ src, uint16_t* __restrict__ dst, int n, int k, long long total) {
+    const long long i = static_cast<long long>(blockIdx.x) * 256 + threadIdx.x;
+    if (i >= total) return;
+    const int e = static_cast<int>(i % 4);
+    const int lane = static_cast<int>((i / 4) % 32);
+    const int kt = static_cast<int>((i / 128) % 4);
+    const int jj = static_cast<int>((i / 512) % 8);
+    const long long tg = i / 4096;
+    const int kg = k / 64;
+    const long long row = (tg / kg) * 64 + jj * 8 + lane / 4;
+    const int col = static_cast<int>(tg % kg) * 64 + kt * 16 + 2 * (lane % 4) + (e & 1) + 8 * (e >> 1);
+    dst[i] = row < n ? src[row * k + col] : 0;
+}
