+extern "C" __global__ void __launch_bounds__(256)
+    tf_ink2moe_quant_x_nvfp4(const __nv_bfloat16* __restrict__ X, int x_stride, int M, int K,
+                             uint8_t* __restrict__ codes, uint8_t* __restrict__ scales) {
+  const long long idx = static_cast<long long>(blockIdx.x) * blockDim.x + threadIdx.x;
+  const int kb = K >> 4;
+  if (idx >= static_cast<long long>(M) * kb) return;
+  const int row = static_cast<int>(idx / kb), blk = static_cast<int>(idx % kb);
+  const __nv_bfloat16* src = X + static_cast<size_t>(row) * x_stride + blk * 16;
+  const uint4 v0 = *reinterpret_cast<const uint4*>(src);
+  const uint4 v1 = *reinterpret_cast<const uint4*>(src + 8);
+  const __nv_bfloat162* p0 = reinterpret_cast<const __nv_bfloat162*>(&v0);
+  const __nv_bfloat162* p1 = reinterpret_cast<const __nv_bfloat162*>(&v1);
+  float f[16];
+  float amax = 0.f;
+#pragma unroll
+  for (int i = 0; i < 4; ++i) {
+    const float2 a = __bfloat1622float2(p0[i]);
+    const float2 b = __bfloat1622float2(p1[i]);
+    f[2 * i] = a.x;
+    f[2 * i + 1] = a.y;
+    f[8 + 2 * i] = b.x;
+    f[8 + 2 * i + 1] = b.y;
+    amax = fmaxf(amax, fmaxf(fmaxf(fabsf(a.x), fabsf(a.y)), fmaxf(fabsf(b.x), fabsf(b.y))));
+  }
+  const nvfp4q::Scale sc = nvfp4q::block_scale(amax, 1.0f);
+  uint32_t w0 = 0u, w1 = 0u;
+#pragma unroll
+  for (int i = 0; i < 8; ++i) {
+    w0 |= nvfp4q::e2m1(f[i] * sc.mul) << (4 * i);
+    w1 |= nvfp4q::e2m1(f[8 + i] * sc.mul) << (4 * i);
+  }
+  *reinterpret_cast<uint2*>(codes + static_cast<size_t>(row) * (K >> 1) + blk * 8) = make_uint2(w0, w1);
+  scales[static_cast<size_t>(row) * kb + blk] = static_cast<uint8_t>(sc.sf8);
+}
+
+extern "C" __global__ void __launch_bounds__(256)
+    tf_ink2moe_quant_x_mxfp8(const __nv_bfloat16* __restrict__ X, int x_stride, int M, int K,
+                             uint8_t* __restrict__ codes, uint8_t* __restrict__ scales) {
+  const long long idx = static_cast<long long>(blockIdx.x) * blockDim.x + threadIdx.x;
+  const int kb = K >> 5;
+  if (idx >= static_cast<long long>(M) * kb) return;
+  const int row = static_cast<int>(idx / kb), blk = static_cast<int>(idx % kb);
+  const __nv_bfloat16* src = X + static_cast<size_t>(row) * x_stride + blk * 32;
+  float f[32];
+  float amax = 0.f;
+#pragma unroll
+  for (int i = 0; i < 4; ++i) {
+    const uint4 v = *reinterpret_cast<const uint4*>(src + i * 8);
+    const __nv_bfloat162* p = reinterpret_cast<const __nv_bfloat162*>(&v);
+#pragma unroll
+    for (int j = 0; j < 4; ++j) {
+      const float2 ab = __bfloat1622float2(p[j]);
+      f[i * 8 + 2 * j] = ab.x;
+      f[i * 8 + 2 * j + 1] = ab.y;
+      amax = fmaxf(amax, fmaxf(fabsf(ab.x), fabsf(ab.y)));
+    }
+  }
+  uint32_t ue = 127u;
+  float inv = 1.f;
+  if (amax > 0.f) {
+    const uint32_t u = __float_as_uint(amax * (1.f / 448.f));
+    ue = ((u >> 23) & 0xFFu) + ((u & 0x7FFFFFu) != 0u ? 1u : 0u);
+    if (ue < 1u) ue = 1u;
+    if (ue > 254u) ue = 254u;
+    inv = __uint_as_float((254u - ue) << 23);
+  }
+  scales[static_cast<size_t>(row) * kb + blk] = static_cast<uint8_t>(ue);
+  uint32_t* dst = reinterpret_cast<uint32_t*>(codes + static_cast<size_t>(row) * K + blk * 32);
+#pragma unroll
+  for (int k = 0; k < 8; ++k) {
+    const uint32_t b0 = __nv_cvt_float_to_fp8(f[4 * k + 0] * inv, __NV_SATFINITE, __NV_E4M3);
+    const uint32_t b1 = __nv_cvt_float_to_fp8(f[4 * k + 1] * inv, __NV_SATFINITE, __NV_E4M3);
+    const uint32_t b2 = __nv_cvt_float_to_fp8(f[4 * k + 2] * inv, __NV_SATFINITE, __NV_E4M3);
+    const uint32_t b3 = __nv_cvt_float_to_fp8(f[4 * k + 3] * inv, __NV_SATFINITE, __NV_E4M3);
+    dst[k] = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
+  }
+}
+
+extern "C" __global__ void __launch_bounds__(128)
+    tf_ink2moe_prompt_tc_nvfp4(const uint8_t* __restrict__ xc, const uint8_t* __restrict__ xsc, int x_stride,
+                               int slots, ink2o::Weight w, int KG, int NB, const int* __restrict__ items,
+                               const int* __restrict__ item_count, const int* __restrict__ members,
+                               void* __restrict__ out, int N, int skip) {
+  ink2o::prompt_tc_body<0>(xc, xsc, x_stride, slots, w, KG, NB, items, item_count, members, out, N, skip);
+}
+
+extern "C" __global__ void __launch_bounds__(128)
+    tf_ink2moe_prompt_tc_mxfp8(const uint8_t* __restrict__ xc, const uint8_t* __restrict__ xsc, int x_stride,
+                               int slots, ink2o::Weight w, int KG, int NB, const int* __restrict__ items,
+                               const int* __restrict__ item_count, const int* __restrict__ members,
+                               void* __restrict__ out, int N, int skip) {
+  ink2o::prompt_tc_body<1>(xc, xsc, x_stride, slots, w, KG, NB, items, item_count, members, out, N, skip);
+}
