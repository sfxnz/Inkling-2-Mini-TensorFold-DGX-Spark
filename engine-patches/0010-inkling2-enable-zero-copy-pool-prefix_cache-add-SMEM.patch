From c56a8960d48fcc379a1f4d3ffc3d1f3c42d37d0f Mon Sep 17 00:00:00 2001
From: sfxnz <sfxnz@spark1.tail1a9513.ts.net>
Date: Wed, 25 Nov 2026 21:44:41 +0000
Subject: [PATCH] inkling2: enable zero-copy pool prefix_cache, add SMEM-cached
 loop_ar, restore verify_tc=32 and FP8 draft head default

---
 zig/kernels/cuda/inkling2/loop_math.cu       | 43 +++++++++++++++++---
 zig/src/families/inkling2/draft_fp8.zig      |  2 +-
 zig/src/families/inkling2/loop_math_cuda.zig | 12 +++++-
 zig/src/families/inkling2/modelopt.zig       |  4 +-
 zig/src/native/cuda.zig                      |  7 ++--
 zig/src/platform/environment.zig             |  4 +-
 zig/src/platform/environment_test.zig        |  2 +-
 7 files changed, 58 insertions(+), 16 deletions(-)

diff --git a/zig/kernels/cuda/inkling2/loop_math.cu b/zig/kernels/cuda/inkling2/loop_math.cu
index 1ac95d6..e941f7f 100644
--- a/zig/kernels/cuda/inkling2/loop_math.cu
+++ b/zig/kernels/cuda/inkling2/loop_math.cu
@@ -55,21 +55,47 @@ struct ArArgs {
 };
 
 // The AR half of Small's residual mix, without its fused RMSNorm. Needed before Mini's controller, not just after it.
-__device__ void ar(const ArArgs a) {
+template <bool CACHED>
+__device__ void arBody(const ArArgs a) {
     __shared__ float sh[32 * (1 + kMaxQueries)];
     __shared__ float wts[kMaxQueries][kMaxBlocks + 1];
     __shared__ float rr[kMaxBlocks + 1];
+    extern __shared__ __align__(16) unsigned char ar_smem[];
+    uint16_t* s_blk = reinterpret_cast<uint16_t*>(ar_smem);
+    const size_t blk_bytes = (static_cast<size_t>(a.n_blocks) * a.C * 2 + 15u) & ~static_cast<size_t>(15u);
+    float* s_part = reinterpret_cast<float*>(ar_smem + blk_bytes);
+    uint16_t* s_part_bf = reinterpret_cast<uint16_t*>(s_part);
     const size_t row = blockIdx.x;
     const int n = a.n_blocks + 1;
-    auto entry = [&](int j, int c) -> float {
+    auto entry_global = [&](int j, int c) -> float {
         if (j < a.n_blocks) return bf(a.blocks[j][row * a.C + c]);
         return a.partial_bf16 ? bf(static_cast<const uint16_t*>(a.partial)[row * a.C + c])
                               : static_cast<const float*>(a.partial)[row * a.C + c];
     };
+    auto entry_cached = [&](int j, int c) -> float {
+        if (j < a.n_blocks) return bf(s_blk[static_cast<size_t>(j) * a.C + c]);
+        return a.partial_bf16 ? bf(s_part_bf[c]) : s_part[c];
+    };
     for (int j = 0; j < n; ++j) {
         float ss[1] = {0.0f};
         for (int c = threadIdx.x; c < a.C; c += blockDim.x) {
-            const float x = entry(j, c);
+            float x;
+            if constexpr (CACHED) {
+                if (j < a.n_blocks) {
+                    const uint16_t u = a.blocks[j][row * a.C + c];
+                    s_blk[static_cast<size_t>(j) * a.C + c] = u;
+                    x = bf(u);
+                } else if (a.partial_bf16) {
+                    const uint16_t u = static_cast<const uint16_t*>(a.partial)[row * a.C + c];
+                    s_part_bf[c] = u;
+                    x = bf(u);
+                } else {
+                    x = static_cast<const float*>(a.partial)[row * a.C + c];
+                    s_part[c] = x;
+                }
+            } else {
+                x = entry_global(j, c);
+            }
             ss[0] = __fmaf_rn(x, x, ss[0]);
         }
         blockSums<1>(ss, sh);
@@ -79,7 +105,8 @@ __device__ void ar(const ArArgs a) {
     for (int j = 0; j < n; ++j) {
         float dots[kMaxQueries] = {0.0f, 0.0f, 0.0f};
         for (int c = threadIdx.x; c < a.C; c += blockDim.x) {
-            const float normalized = __fmul_rn(entry(j, c), rr[j]);
+            const float q_in = CACHED ? entry_cached(j, c) : entry_global(j, c);
+            const float normalized = __fmul_rn(q_in, rr[j]);
             for (int q = 0; q < a.nq; ++q)
                 dots[q] = __fmaf_rn(a.query[static_cast<size_t>(q) * a.C + c], normalized, dots[q]);
         }
@@ -101,7 +128,7 @@ __device__ void ar(const ArArgs a) {
         for (int c = threadIdx.x; c < a.C; c += blockDim.x) {
             float h = 0.0f;
             for (int j = 0; j < n; ++j) {
-                const float z = __fmul_rn(entry(j, c), rr[j]);
+                const float z = __fmul_rn(CACHED ? entry_cached(j, c) : entry_global(j, c), rr[j]);
                 h = __fmaf_rn(wts[q][j], z, h);
             }
             out[c] = h;
@@ -112,7 +139,11 @@ __device__ void ar(const ArArgs a) {
 }  // namespace ink2l
 
 extern "C" __global__ void __launch_bounds__(512) tf_ink2_loop_ar(const ink2l::ArArgs a) {
-    ink2l::ar(a);
+    ink2l::arBody<false>(a);
+}
+
+extern "C" __global__ void __launch_bounds__(512) tf_ink2_loop_ar_cached(const ink2l::ArArgs a) {
+    ink2l::arBody<true>(a);
 }
 
 namespace ink2l {
diff --git a/zig/src/families/inkling2/draft_fp8.zig b/zig/src/families/inkling2/draft_fp8.zig
index 8eb64ab..12cfc68 100644
--- a/zig/src/families/inkling2/draft_fp8.zig
+++ b/zig/src/families/inkling2/draft_fp8.zig
@@ -15,7 +15,7 @@ pub const Options = struct {
         return .{
             .layers = @import("sys").environment.read(bool, "TF_INKLING2_DRAFT_FP8_LAYERS", default_fp8) catch false,
             .head = @import("sys").environment.read(bool, "TF_INKLING2_DRAFT_FP8_HEAD", default_fp8) catch false,
-            .fp4_head = @import("sys").environment.read(bool, "TF_INKLING2_DRAFT_FP4_HEAD", default_fp8) catch false,
+            .fp4_head = @import("sys").environment.read(bool, "TF_INKLING2_DRAFT_FP4_HEAD", false) catch false,
             .borrow_head = borrow_head,
         };
     }
diff --git a/zig/src/families/inkling2/loop_math_cuda.zig b/zig/src/families/inkling2/loop_math_cuda.zig
index 3013485..764efb7 100644
--- a/zig/src/families/inkling2/loop_math_cuda.zig
+++ b/zig/src/families/inkling2/loop_math_cuda.zig
@@ -23,6 +23,7 @@ pub const ArArgs = extern struct {
 pub const Kernels = struct {
     mod: cuda.Module,
     ar_fn: cuda.Function,
+    ar_cached_fn: cuda.Function,
     messages_fn: cuda.Function,
     gate_down_fn: cuda.Function,
     gate_prepare_fn: cuda.Function,
@@ -39,6 +40,7 @@ pub const Kernels = struct {
         return .{
             .mod = mod,
             .ar_fn = try mod.function("tf_ink2_loop_ar"),
+            .ar_cached_fn = try mod.function("tf_ink2_loop_ar_cached"),
             .messages_fn = try mod.function("tf_ink2_loop_messages"),
             .gate_down_fn = try mod.function("tf_ink2_loop_gate_down"),
             .gate_prepare_fn = try mod.function("tf_ink2_loop_gate_prepare"),
@@ -70,7 +72,15 @@ pub fn ar(k: *const Kernels, s: cuda.Stream, a: ArArgs) !void {
         return error.Inkling2LoopArShape;
     var args: cuda.Args = .{};
     args.add(a);
-    try go(k.ar_fn, s, .{ .x = @intCast(a.rows) }, 512, &args);
+    const c_usize: usize = @intCast(a.c);
+    const n_blocks: usize = @intCast(a.n_blocks);
+    const partial_bytes: usize = if (a.partial_bf16 != 0) c_usize * 2 else c_usize * 4;
+    const smem_bytes: usize = std.mem.alignForward(usize, n_blocks * c_usize * 2, 16) + partial_bytes;
+    if (smem_bytes <= 46_080) {
+        try cuda.launch.launch(k.ar_cached_fn, .{ .grid = .{ .x = @intCast(a.rows) }, .block = .{ .x = 512 }, .shared = @intCast(smem_bytes) }, s, &args);
+    } else {
+        try go(k.ar_fn, s, .{ .x = @intCast(a.rows) }, 512, &args);
+    }
 }
 
 /// Messages: BF16 banks, even/odd qm/kv FP32 queries/output; row-local q/k/v/mlp, no scratch/position/mask/cache.
diff --git a/zig/src/families/inkling2/modelopt.zig b/zig/src/families/inkling2/modelopt.zig
index f44a176..7733502 100644
--- a/zig/src/families/inkling2/modelopt.zig
+++ b/zig/src/families/inkling2/modelopt.zig
@@ -21,7 +21,7 @@ pub fn prefillTcMode() u8 {
 }
 
 pub fn verifyTcRows() usize {
-    return @import("sys").environment.read(u32, "TF_INKLING2_VERIFY_TC_ROWS", 12) catch 12;
+    return @import("sys").environment.read(u32, "TF_INKLING2_VERIFY_TC_ROWS", 32) catch 32;
 }
 
 pub const Projection = struct {
@@ -251,7 +251,7 @@ pub fn run(k: *const Kernels, s: cuda.Stream, l: Layer, caps: experts.Caps, x: u
     const use_tc = rows >= verifyTcRows() and k.tc_ok and prefillTcMode() != 0 and
         ((l.format == .nvfp4 and hidden % 64 == 0 and intermediate % 64 == 0) or
         (l.format == .mxfp8 and hidden % 32 == 0 and intermediate % 32 == 0));
-    const tile: usize = if (rows >= 64 or (!use_tc and listed)) 64 else 16;
+    const tile: usize = if (rows >= 32) 64 else 16;
     const item_bound = (pairs + tile - 1) / tile + @min(pairs, @as(usize, l.experts));
 
     var g: cuda.Args = .{};
diff --git a/zig/src/native/cuda.zig b/zig/src/native/cuda.zig
index cdc36e0..03cb7f0 100644
--- a/zig/src/native/cuda.zig
+++ b/zig/src/native/cuda.zig
@@ -427,9 +427,10 @@ fn openWith(comptime F: type, a: Allocator, gpa: Allocator, io: std.Io, asked: a
         };
     }
     errdefer if (h.store) |store| kv_pages.closeStore(gpa, store);
-    const share_limit = if (!share) 0 else if (counted.slots != null) paged.?.snaps else try @import("core").kv_prompts.sharing(); // what its slots hold
-    if (comptime @hasDecl(F, "share_attach")) if (@import("cuda_streams.zig").opensStore(F, share, cache, share_limit)) {
-        h.prompts = try prompt_pages.Adapter.open(F, gpa, loaded.target, @intCast(layout.?.page_tokens), share_limit);
+    const share_limit = if (!share) 0 else if (counted.slots != null) paged.?.snaps else prompt_pages.entryLimit(loaded) orelse try @import("core").kv_prompts.sharing(); // what its slots hold
+    const share_pages = prompt_pages.pageLimit(loaded);
+    if (comptime @hasDecl(F, "share_attach")) if (if (share_pages != null) share and share_limit > 0 else @import("cuda_streams.zig").opensStore(F, share, cache, share_limit)) {
+        h.prompts = try prompt_pages.Adapter.openLimited(F, gpa, loaded.target, @intCast(layout.?.page_tokens), share_limit, share_pages);
     };
     errdefer if (h.prompts) |x| x.close();
     var conversations = false;
diff --git a/zig/src/platform/environment.zig b/zig/src/platform/environment.zig
index 95c6cc9..333db11 100644
--- a/zig/src/platform/environment.zig
+++ b/zig/src/platform/environment.zig
@@ -55,14 +55,14 @@ pub const rules = [_]Rule{
     .{ .name = "TF_INKLING2_ATTN_FP8", .scope = .cuda, .kind = .flag, .forms = "0 or 1 (1 packs Mini wq/wk/wv/wo as FP8 qmmf weights)" },
     .{ .name = "TF_INKLING2_GATE_FP8", .scope = .cuda, .kind = .flag, .forms = "0 or 1 (1 packs Mini gate_attn as FP8 qmmf weights)" },
     .{ .name = "TF_INKLING2_PREFILL_TC", .scope = .cuda, .kind = .flag, .forms = "0 or 1 (1 enables Blackwell sm_121a native block-scaled MoE TC prefill)" },
-    .{ .name = "TF_INKLING2_VERIFY_TC_ROWS", .scope = .cuda, .kind = .u32, .min = 1, .max = 64, .forms = "1 to 64 (minimum MoE rows for Blackwell verify TC dispatch; default 12)" },
+    .{ .name = "TF_INKLING2_VERIFY_TC_ROWS", .scope = .cuda, .kind = .u32, .min = 1, .max = 64, .forms = "1 to 64 (minimum MoE rows for Blackwell verify TC dispatch; default 32)" },
     .{ .name = "TF_INKLING2_TOPK_WARP", .scope = .cuda, .kind = .flag, .forms = "0 or 1 (1 uses the Mini warp router)" },
     .{ .name = "TF_INKLING2_LAZY_HEAD", .scope = .cuda, .kind = .flag, .forms = "0 or 1 (1 prunes certified losers in Mini greedy decode)" },
     .{ .name = "TF_INKLING2_ATTN_FP8_PREFETCH", .scope = .cuda, .kind = .flag, .forms = "0 or 1 (1 prefetches Mini FP8 KV in decode)" },
     .{ .name = "TF_INKLING2_VERIFY_GRAPHS", .scope = .cuda, .kind = .flag, .forms = "0 or 1 (1 gives Mini shared verify its own graph cache)" },
     .{ .name = "TF_INKLING2_DRAFT_FP8_LAYERS", .scope = .cuda, .kind = .flag, .forms = "0 or 1 (FP8 Mini draft projections; default 1 for DFlash2 on Blackwell)" },
     .{ .name = "TF_INKLING2_DRAFT_FP8_HEAD", .scope = .cuda, .kind = .flag, .forms = "0 or 1 (FP8 Mini draft head weights; default 1 for DFlash2 on Blackwell)" },
-    .{ .name = "TF_INKLING2_DRAFT_FP4_HEAD", .scope = .cuda, .kind = .flag, .forms = "0 or 1 (NVFP4 Mini draft head weights; default 1 for DFlash2 on Blackwell)" },
+    .{ .name = "TF_INKLING2_DRAFT_FP4_HEAD", .scope = .cuda, .kind = .flag, .forms = "0 or 1 (NVFP4 Mini draft head weights; default 0, borrows FP8 lazy head when available)" },
     .{ .name = "TF_INKLING2_DFLASH2_DIR", .scope = .cuda, .kind = .path, .forms = "a local Mini DFlash2 checkpoint directory" },
     .{ .name = "TF_INKLING2_DFLASH2_TRIM_SELECTOR", .scope = .cuda, .kind = .flag, .forms = "0 or 1 (default 1 stores only Mini's real tokenizer rows in both DFlash2 selector codebooks)" },
     .{ .name = "TF_INKLING2_DFLASH2_SHARED", .scope = .cuda, .kind = .u32, .only = &.{ 0, 2, 4 }, .forms = "0, 2 or 4 (maximum active streams for Mini DFlash2 shared pricing; default 4 on GB10, 2 elsewhere)" },
