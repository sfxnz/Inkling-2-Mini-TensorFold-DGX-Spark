# The release image (docker/Dockerfile at TF_VERSION=1.3.5) with tensorfold-native (and optionally libtfgrammar.so)
# replaced by a source build of engine-patches/. Everything else, codecs included, stays upstream's. Build:
#   docker build -f docker/Dockerfile.patched --build-context engine=DIR \
#     --build-arg BIN_SHA256=<sha256 of DIR/tensorfold-native> \
#     [--build-arg GRAMMAR_SHA256=<sha256 of DIR/libtfgrammar.so>] \
#     --build-arg PATCHES=<sha256 of engine-patches/series files> \
#     -t tf-inkling2:1.3.5-p1 docker
# DIR holds the `zig build -Dgpu=spark -Doptimize=ReleaseFast` output binaries.
ARG BASE_IMAGE=tf-inkling2:1.3.5
FROM ${BASE_IMAGE}
ARG BIN_SHA256
ARG GRAMMAR_SHA256=""
ARG PATCHES=""
RUN --mount=type=bind,from=engine,target=/engine \
    test -n "${BIN_SHA256}" \
 && echo "${BIN_SHA256}  /engine/tensorfold-native" | sha256sum -c - \
 && install -m 0755 /engine/tensorfold-native /opt/tensorfold/bin/tensorfold-native \
 && cd /opt/tensorfold \
 && sed -i "s|^[0-9a-f]\{64\}  \./bin/tensorfold-native\$|${BIN_SHA256}  ./bin/tensorfold-native|" SHA256SUMS \
 && grep -q "^${BIN_SHA256}  ./bin/tensorfold-native\$" SHA256SUMS \
 && if [ -n "${GRAMMAR_SHA256}" ]; then \
      echo "${GRAMMAR_SHA256}  /engine/libtfgrammar.so" | sha256sum -c - && \
      install -m 0755 /engine/libtfgrammar.so /opt/tensorfold/lib/libtfgrammar.so && \
      sed -i "s|^[0-9a-f]\{64\}  \./lib/libtfgrammar.so\$|${GRAMMAR_SHA256}  ./lib/libtfgrammar.so|" SHA256SUMS && \
      grep -q "^${GRAMMAR_SHA256}  ./lib/libtfgrammar.so\$" SHA256SUMS; \
    fi \
 && sha256sum -c --quiet SHA256SUMS
LABEL tensorfold.native.sha256=${BIN_SHA256} \
      tensorfold.grammar.sha256=${GRAMMAR_SHA256} \
      tensorfold.patches=${PATCHES}
